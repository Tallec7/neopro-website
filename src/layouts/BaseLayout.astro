---
import '@/styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import { buildLocalBusinessJsonLd, buildWebSiteJsonLd } from '@/lib/jsonLd';
import { getLocaleFromUrl, getAlternateUrls, useTranslations, localeRoutePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  extraJsonLd?: string | string[];
  ogType?: string;
  locale?: Locale;
  noAlternates?: boolean;
  noIndex?: boolean;
  articleMeta?: {
    publishedTime: string;
    author: string;
  };
}

const { title, description, ogImage, canonicalUrl, extraJsonLd: rawExtraJsonLd, ogType, articleMeta, noAlternates, noIndex } = Astro.props;

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const siteUrl = 'https://www.neopro-communication.fr';
const extraJsonLdList = rawExtraJsonLd
  ? Array.isArray(rawExtraJsonLd) ? rawExtraJsonLd : [rawExtraJsonLd]
  : [];
const fullTitle = title.startsWith('Neopro') ? title : `${title} | Neopro`;
const ogImageUrl = ogImage || `${siteUrl}/og-default.jpg`;
const rawCanonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const canonical = rawCanonical.endsWith('/') ? rawCanonical : rawCanonical + '/';
const alternates = getAlternateUrls(Astro.url.pathname, locale, siteUrl);
const frUrl = alternates.find((a) => a.locale === 'fr')!.url;

const jsonLd = buildLocalBusinessJsonLd({
  name: 'Neopro',
  description: 'Neopro — La régie sport digitale clé en main pour clubs (pro, semi-pro, amateurs). Écrans LED, scoring digital, contenus vidéo, valorisation partenaires.',
  email: 'contact@neopro-communication.fr',
  url: siteUrl,
  phone: '+33 7 56 94 94 67',
  address: 'Nantes, France',
  image: `${siteUrl}/og-default.jpg`,
  sameAs: [
    'https://www.instagram.com/neopro_fr/',
    'https://www.linkedin.com/company/neopro-communication/',
  ],
});

// WebSite schema : signal principal utilisé par Google pour afficher
// le nom du site (« Neopro ») à la place du domaine dans les SERP.
const webSiteJsonLd = buildWebSiteJsonLd({
  name: 'Neopro',
  alternateName: 'Neopro Communication',
  url: siteUrl,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Fonts (preload pour éviter le render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;900&family=Playfair+Display:ital@1&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;900&family=Playfair+Display:ital@1&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;900&family=Playfair+Display:ital@1&display=swap" rel="stylesheet" /></noscript>

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <meta name="author" content="Neopro" />
    <link rel="canonical" href={canonical} />
    {!noAlternates && alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.url} />
    ))}
    {!noAlternates && <link rel="alternate" hreflang="x-default" href={frUrl} />}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType || 'website'} />
    <meta property="og:locale" content={{ fr: 'fr_FR', en: 'en_US', es: 'es_ES', de: 'de_DE', da: 'da_DK', it: 'it_IT', pl: 'pl_PL', nl: 'nl_NL', pt: 'pt_PT' }[locale]} />
    <meta property="og:site_name" content="Neopro" />

    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:author" content={articleMeta.author} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={webSiteJsonLd} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    {extraJsonLdList.map((jsonLdBlock) => (
      <script is:inline type="application/ld+json" set:html={jsonLdBlock} />
    ))}

    <!-- GTM chargé conditionnellement via CookieBanner (consentement RGPD) -->

    <!-- Lemlist visitor tracking (chargé via CookieBanner après consentement) -->
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Bandeau promo global (jusqu'au 31 mai) -->
    <div id="promo-bar" class="fixed top-0 left-0 right-0 z-[60] bg-[#423E33] text-white border-b-2 border-[#fdbe00]">
      <div class="max-w-[1320px] mx-auto px-[20px] md:px-[40px] lg:px-[60px] py-[10px] flex items-center justify-center gap-[16px] text-center">
<p class="text-[13px] md:text-[14px] leading-snug">
          <span class="text-[#fdbe00] font-bold uppercase tracking-wider mr-2">{t('promo.label')}</span>
          <span class="font-semibold">{t('promo.pro')}</span>
          <span class="text-[#9ca3af] mx-2">·</span>
          <span class="font-semibold">{t('promo.premium')}</span>
          <span class="text-[#9ca3af] mx-2 hidden md:inline">·</span>
          <span class="text-[#d9d9d9] hidden md:inline">{t('promo.until')}</span>
          <a href={localeRoutePath('/offres', locale)} class="ml-3 inline-flex items-center gap-1 text-[#fdbe00] font-bold underline underline-offset-2 hover:text-white transition-colors">{t('promo.cta')}</a>
        </p>
        <button type="button" id="promo-bar-close" aria-label={t('promo.close')} class="shrink-0 ml-2 w-[24px] h-[24px] flex items-center justify-center rounded-full hover:bg-white/10 transition-colors text-[#d9d9d9]">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var bar = document.getElementById('promo-bar');
        var btn = document.getElementById('promo-bar-close');
        if (!bar || !btn) return;

        function applyOffset(visible) {
          var nav = document.getElementById('main-nav');
          var h = visible ? bar.offsetHeight : 0;
          document.body.style.paddingTop = visible ? h + 'px' : '';
          if (nav) nav.style.top = visible ? (h + 20) + 'px' : '';
        }

        function init() {
          try {
            if (sessionStorage.getItem('promo-bar-closed') === '1') {
              bar.style.display = 'none';
              applyOffset(false);
            } else {
              applyOffset(true);
            }
          } catch (e) { applyOffset(true); }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
        window.addEventListener('resize', function () {
          if (bar.style.display !== 'none') applyOffset(true);
        });

        btn.addEventListener('click', function () {
          bar.style.display = 'none';
          applyOffset(false);
          try { sessionStorage.setItem('promo-bar-closed', '1'); } catch (e) {}
        });
      })();
    </script>

    <Navbar locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieBanner locale={locale} />
  </body>
</html>
