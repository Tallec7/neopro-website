---
import '@/styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import { buildLocalBusinessJsonLd } from '@/lib/jsonLd';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  extraJsonLd?: string | string[];
  ogType?: string;
  articleMeta?: {
    publishedTime: string;
    author: string;
  };
}

const { title, description, ogImage, canonicalUrl, extraJsonLd: rawExtraJsonLd, ogType, articleMeta } = Astro.props;

const siteUrl = 'https://www.neopro-communication.fr';
const extraJsonLdList = rawExtraJsonLd
  ? Array.isArray(rawExtraJsonLd) ? rawExtraJsonLd : [rawExtraJsonLd]
  : [];
const fullTitle = `${title} | Neopro`;
const ogImageUrl = ogImage || `${siteUrl}/og-default.jpg`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;

const jsonLd = buildLocalBusinessJsonLd({
  name: 'Neopro',
  description: 'Solution de régie digitale pour clubs de sport amateurs. Écrans LED, scoring digital, valorisation partenaires.',
  email: 'contact@neopro-communication.fr',
  url: siteUrl,
  phone: '+33 7 56 94 94 67',
  address: 'Nantes, France',
  image: `${siteUrl}/og-default.jpg`,
  sameAs: [
    'https://www.instagram.com/neopro_fr/',
    'https://www.linkedin.com/company/neopro-communication/',
  ],
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Google Fonts (preload pour éviter le render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;900&family=Playfair+Display:ital@1&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;900&family=Playfair+Display:ital@1&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;900&family=Playfair+Display:ital@1&display=swap" rel="stylesheet" /></noscript>

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Neopro" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType || 'website'} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Neopro" />

    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:author" content={articleMeta.author} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    {extraJsonLdList.map((jsonLdBlock) => (
      <script is:inline type="application/ld+json" set:html={jsonLdBlock} />
    ))}

    <!-- GTM chargé conditionnellement via CookieBanner (consentement RGPD) -->
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
