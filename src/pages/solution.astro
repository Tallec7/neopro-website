---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SportBullet from '@/components/SportBullet.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { Image } from 'astro:assets';

// ── Images ───────────────────────────────────────────────────────
import heroImg from '@/assets/images/hero-solution.webp';

// ── Données ��───────────────────────────��─────────────────────────
import { solutionPanels, features, colorPanels, steps } from '@/data/solution';
import { chainSteps } from '@/data/offres-v2';

// Couleurs des icônes sport pour chaque panneau coloré
const panelIconVariants = ['pink', 'yellow', 'green', 'blue'] as const;

// ── Helper : format panel title (italic 1er mot + black le reste) ─
const formatPanelTitle = (title: string) => {
  const spaceIdx = title.indexOf(' ');
  if (spaceIdx === -1) return `<span class="font-bold">${title}</span>`;
  const first = title.substring(0, spaceIdx);
  const rest = title.substring(spaceIdx + 1);
  return `<span class="font-playfair italic font-normal">${first}</span> <span class="font-black">${rest}</span>`;
};

// ── SEO ──────────────────────────────────────────────────────────
import {
  buildServiceJsonLd,
  buildBreadcrumbJsonLd,
  buildFAQPageJsonLd,
} from '@/lib/jsonLd';

const title = 'La solution Neopro — Régie sport digitale clé en main pour clubs';
const description = "La solution Neopro : une régie sport digitale clé en main pour clubs. Boîtier plug & play, appli télécommande et contenus vidéo pro pour valoriser vos sponsors et animer vos matchs. Sans wifi, sans fil.";

const siteUrl = 'https://www.neopro-communication.fr';
const canonicalUrl = `${siteUrl}/solution`;

const breadcrumb = buildBreadcrumbJsonLd([
  { name: 'Accueil', url: siteUrl },
  { name: 'La solution', url: canonicalUrl },
]);

const faqJsonLd = buildFAQPageJsonLd([
  {
    question: 'Comment fonctionne Neopro exactement ?',
    answer: "Neopro est une régie sport digitale clé en main : un boîtier plug & play se branche en HDMI sur votre écran ou télévision. Via l'application télécommande, vous programmez vos contenus (logos partenaires, vidéos, scores) et les diffusez à distance. Aucune compétence technique requise.",
  },
  {
    question: "Combien de temps prend l'installation ?",
    answer: "L'installation est généralement réalisée en moins d'une journée par nos techniciens. Le boîtier se branche en HDMI sur votre écran existant — pas de câblage complexe ni de travaux. Vous êtes opérationnel le jour même.",
  },
  {
    question: 'Faut-il un accès wifi dans la salle ?',
    answer: "Non. Le boîtier Neopro embarque une connexion 4G incluse dans l'abonnement. Vous n'avez pas besoin du réseau de votre salle pour que les écrans fonctionnent et se mettent à jour.",
  },
  {
    question: 'Qui gère les contenus diffusés sur les écrans ?',
    answer: "Vous gardez la main via l'application télécommande Neopro. Vous choisissez ce qui s'affiche (partenaires, scores, actualités club) et quand. Neopro peut également produire vos contenus vidéo professionnels (shootings joueurs, templates animés) en option.",
  },
  {
    question: 'Neopro est-il adapté aux petits clubs ?',
    answer: "Oui. La solution est pensée pour tous les niveaux, du club professionnel à l'association amateur de championnat régional. L'offre Play (sans matériel) permet même de démarrer sans aucune installation physique.",
  },
  {
    question: 'Sur quels écrans puis-je utiliser Neopro ?',
    answer: "Sur n'importe quel écran disposant d'une entrée HDMI : téléviseur, écran PC, écran d'affichage dynamique, écran LED. Si vous avez besoin d'écrans, Neopro peut vous conseiller et vous aider à les sourcer et les installer.",
  },
]);

const service = buildServiceJsonLd({
  name: 'Neopro — Régie sport digitale',
  description,
  url: canonicalUrl,
  providerName: 'Neopro',
  providerUrl: siteUrl,
  areaServed: ['France', 'Belgique', 'Suisse'],
  serviceType: 'Régie sport digitale',
});
---

<BaseLayout title={title} description={description} extraJsonLd={[breadcrumb, service, faqJsonLd]}>
  <!-- Hero -->
  <section class="relative h-[743px] overflow-hidden">
    <Image
      src={heroImg}
      alt="Joueurs de handball devant un écran digital Neopro affichant les célébrations d'avant-match"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-[rgba(47,57,53,0.5)]"></div>
    <div class="relative z-10 h-full flex flex-col justify-end px-[20px] md:px-[40px] lg:px-[60px] pb-[60px] md:pb-[80px]">
      <p class="text-[16px] tracking-[2px] text-[#d9d9d9] uppercase mb-[20px]">LA SOLUTION</p>
      <h1 class="text-[36px] md:text-[50px] lg:text-[70px] leading-[1.1] text-white mb-[30px]">
        <span class="font-playfair italic">La régie sport de</span><br />
        <span class="font-black">votre club</span>
      </h1>
      <p class="text-white/80 text-[16px] md:text-[18px] max-w-[620px] mb-[24px]">
        Une régie digitale clé en main pensée pour les clubs de sport — du niveau professionnel au championnat régional.
      </p>
      <div>
        <Button href="/demo" variant="green" arrow>Découvrir la solution</Button>
      </div>
    </div>
  </section>

  <!-- Panneaux solution sticky -->
  <section class="pb-[60px] md:pb-[100px] pt-[40px] px-[20px] md:px-[40px] lg:px-[60px]">
    <div class="max-w-[1200px] mx-auto">
      <p class="text-[16px] font-bold opacity-60 tracking-[2px] uppercase mb-[30px]">A QUOI ÇA SERT ?</p>
      {solutionPanels.map((panel, i) => (
        <div
          class="sticky top-[120px] bg-white rounded-[20px] shadow-lg overflow-hidden mb-8"
          style={`z-index: ${10 + i}`}
        >
          <div class="flex flex-col md:flex-row gap-[60px] py-[60px] md:py-[120px] px-[30px] md:px-[60px]">
            <div class="flex-1 flex flex-col justify-center gap-[30px]">
              <h2 class="text-[28px] md:text-[36px] lg:text-[48px]" set:html={formatPanelTitle(panel.title)} />
              <p class="text-neo-gray text-[18px]">{panel.description}</p>
            </div>
            <div class="flex-1 rounded-[20px] overflow-hidden bg-[#1a1f1c] aspect-video">
              <video
                class="w-full h-full object-cover"
                autoplay
                muted
                loop
                playsinline
              >
                <source src={panel.videoUrl || `/videos/solution-panel-${i + 1}.mp4`} type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Comment ça marche ? — 3 colonnes -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pb-[60px] md:pb-[120px] pt-[60px] md:pt-[100px]">
    <div class="max-w-[1200px] mx-auto">
      <p class="text-[16px] font-bold opacity-60 tracking-[2px] uppercase mb-[40px]">COMMENT ÇA MARCHE ?</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
        {steps.map((step, i) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] md:p-[40px] flex flex-col items-center text-center gap-[20px] fade-in-step" style={`--step: ${i}`}>
            <span class="text-[64px] md:text-[80px] font-black text-[#101828] leading-none">{step.number}</span>
            <h3 class="text-[20px] md:text-[24px] font-bold">{step.title}</h3>
            <p class="text-[16px] text-[#4a5565]">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .fade-in-step {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s ease, transform 0.6s ease;
      transition-delay: calc(var(--step) * 0.15s);
    }
    .fade-in-step.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <script>
    const steps = document.querySelectorAll('.fade-in-step');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.2 }
    );
    steps.forEach((el) => observer.observe(el));
  </script>

  <!-- Panneaux couleurs sticky -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[1200px] mx-auto">
      <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#101828] mb-[60px]">Plus qu'une solution d'affichage : une vraie régie sport</h2>
      <div class="flex flex-col gap-[20px]">
        {colorPanels.map((panel, i) => (
          <div
            class={`sticky top-[120px] ${panel.bgColor} text-white rounded-[20px] px-[20px] md:px-[40px] py-[60px]`}
            style={`z-index: ${10 + i}`}
          >
            <div class="flex flex-col md:flex-row gap-[30px] md:gap-[60px] items-start">
              <h3 class="text-[28px] font-bold md:w-[300px] lg:w-[400px] shrink-0">{panel.title}</h3>
              <ul class="flex flex-col gap-[20px] flex-1">
                {panel.features.map((f) => (
                  <li class="flex items-center gap-[15px] text-[20px] text-white">
                    <SportBullet variant={panelIconVariants[i] || 'green'} />
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- La chaîne Neopro (services complémentaires full-stack) -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pt-[60px] md:pt-[96px] pb-[30px] md:pb-[40px]">
    <div class="max-w-[1320px] mx-auto">
      <div class="mb-[50px] max-w-[760px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">SERVICES COMPLÉMENTAIRES</p>
        <h2 class="text-[28px] md:text-[36px] lg:text-[44px] font-bold text-[#101828] mb-[16px]">
          <span class="font-playfair italic">La chaîne</span> Neopro, de A à Z
        </h2>
        <p class="text-[18px] text-neo-gray">Du shooting de vos joueurs à l'écran allumé en bord de terrain, on couvre toute la chaîne. Vous prenez ce dont vous avez besoin.</p>
      </div>

      <div class="relative">
        <div class="hidden lg:block absolute top-[34px] left-[8%] right-[8%] h-[2px] bg-gradient-to-r from-[#81e3bc] via-[#1ec5e0] to-[#fe6aa6] opacity-40"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px] relative">
          {chainSteps.map((s) => (
            <div class="relative bg-white border border-gray-200 rounded-[20px] p-[24px] flex flex-col hover:border-neo-green-dark transition-colors">
              <div class="flex items-center gap-[14px] mb-[14px]">
                <span class="shrink-0 w-[52px] h-[52px] rounded-full bg-[#81e3bc] text-[#2f3935] flex items-center justify-center font-bold text-[16px] shadow-sm">
                  {s.step}
                </span>
                <h3 class="text-[22px] font-bold text-[#101828]">{s.title}</h3>
              </div>
              <p class="text-[14px] text-neo-gray italic mb-[18px] min-h-[40px]">{s.tagline}</p>
              <ul class="flex flex-col gap-[12px] flex-1">
                {s.services.map((opt) => (
                  <li class="flex items-start gap-[10px]">
                    <svg class="w-4 h-4 shrink-0 text-neo-green-dark mt-[4px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                    <div>
                      <p class="text-[14px] text-[#101828] leading-snug">{opt.label}</p>
                      {opt.hint && <p class="text-[12px] text-neo-gray mt-[2px]">{opt.hint}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <p class="text-center text-[14px] text-neo-gray mt-[30px]">
        Tous ces services sont disponibles en option ou en upsell — chiffrage personnalisé sur demande.
      </p>
    </div>
  </section>

  <!-- CTA vers offres -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[1200px] mx-auto">
      <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-[120px]">
        <div class="w-full lg:w-[550px] flex-shrink-0 aspect-square rounded-[20px] overflow-hidden bg-[#f5f5f5]">
          <img
            src="/images/image_offre.jpg"
            alt="Écran Neopro en situation dans un gymnase — découvrez les offres"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="flex-1 flex flex-col gap-[20px] items-start">
          <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#101828]">
            Des offres adaptées à vos besoins
          </h2>
          <p class="text-[18px] text-[#4a5565]">
            Finançable par vos partenaires. Clé en main.
          </p>
          <div class="mt-[20px]">
            <Button href="/offres" variant="black" arrow>
              Découvrez les offres
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-gray-50">
    <div class="max-w-[800px] mx-auto">
      <h2 class="text-[28px] md:text-[36px] font-bold text-[#101828] mb-[10px]">Questions fréquentes</h2>
      <p class="text-[16px] text-neo-gray mb-[40px]">Tout ce qu'il faut savoir sur la solution Neopro.</p>
      <div class="flex flex-col gap-[12px]">
        {[
          {
            q: 'Comment fonctionne Neopro exactement ?',
            a: "Un boîtier plug & play se branche en HDMI sur votre écran ou télévision. Via l'application télécommande, vous programmez vos contenus (logos partenaires, vidéos, scores) et les diffusez à distance. Aucune compétence technique requise.",
          },
          {
            q: "Combien de temps prend l'installation ?",
            a: "Nos techniciens réalisent l'installation en moins d'une journée. Le boîtier se branche en HDMI sur votre écran existant — pas de câblage complexe, pas de travaux. Vous êtes opérationnel le jour même.",
          },
          {
            q: 'Faut-il un accès wifi dans la salle ?',
            a: "Non. Le boîtier embarque une connexion 4G incluse dans l'abonnement. Pas besoin du réseau de votre salle pour que les écrans fonctionnent et se mettent à jour.",
          },
          {
            q: 'Qui gère les contenus diffusés sur les écrans ?',
            a: "Vous gardez la main via l'application télécommande. Vous choisissez ce qui s'affiche (partenaires, scores, actualités club) et quand. En option, Neopro peut produire vos contenus vidéo pro (shootings joueurs, templates animés).",
          },
          {
            q: 'Neopro est-il adapté aux petits clubs ?',
            a: "Oui. La solution est pensée pour tous les niveaux — du club pro à l'association de championnat régional. L'offre Play (sans matériel) permet même de démarrer sans installation physique.",
          },
          {
            q: 'Sur quels écrans puis-je utiliser Neopro ?',
            a: "Sur n'importe quel écran avec entrée HDMI : téléviseur, écran PC, écran LED. Si vous avez besoin d'écrans, Neopro peut vous conseiller, sourcer et installer le matériel adapté.",
          },
        ].map((item) => (
          <details class="bg-white rounded-[16px] border border-gray-200 group">
            <summary class="flex items-center justify-between gap-4 px-[24px] py-[20px] cursor-pointer list-none font-bold text-[16px] text-[#101828]">
              {item.q}
              <span class="shrink-0 text-neo-green-dark text-[20px] group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="px-[24px] pb-[20px] text-[15px] text-neo-gray leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <div id="contact">
    <ContactForm client:visible />
  </div>
</BaseLayout>
