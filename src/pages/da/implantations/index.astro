---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { cities, sports } from '@/data/da/implantations';
import { buildBreadcrumbJsonLd } from '@/lib/jsonLd';

const siteUrl = 'https://madxp.kalonpartners.bzh';
const canonicalUrl = `${siteUrl}/da/implantations`;

const breadcrumb = buildBreadcrumbJsonLd([
  { name: 'Forside', url: `${siteUrl}/da` },
  { name: 'Lokationer', url: canonicalUrl },
]);
---

<BaseLayout
  title="Digital klubløsning — MADXP lokationer i Danmark"
  description="MADXP installerer nøglefærdige digitale skærmløsninger i sportshaller. Håndbold, fodbold, ishockey og mere. Find din by i Danmark."
  canonicalUrl={canonicalUrl}
  extraJsonLd={breadcrumb}
  locale="da"
>
  <!-- Hero -->
  <section class="bg-madxp-ink text-white py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-black mb-6">
        MADXP i hele<br />
        <span class="text-madxp-blue">Danmark</span>
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        Vi hjælper sportsklubber i hele Danmark med en nøglefærdig digital skærmløsning. Find din by og opdag, hvordan MADXP kan professionalisere din klub.
      </p>
    </div>
  </section>

  <!-- Sportsgrene -->
  <section class="py-10 px-6 bg-gray-50">
    <div class="max-w-4xl mx-auto flex flex-wrap justify-center gap-3">
      {sports.map((sport) => (
        <span class="px-4 py-2 bg-white rounded-full text-sm font-medium text-madxp-ink border border-gray-200">
          {sport.name}
        </span>
      ))}
    </div>
  </section>

  <!-- Danmark -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-madxp-ink mb-8">
        🇩🇰 Danmark
      </h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
        {cities.map((city) => (
          <a
            href={`/da/implantations/${city.slug}/`}
            class="block px-5 py-4 bg-gray-50 rounded-xl hover:bg-madxp-blue transition-all font-medium text-madxp-ink"
          >
            {city.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-6 bg-madxp-ink text-white text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black mb-4">
        Er din by ikke på listen?
      </h2>
      <p class="text-gray-300 mb-8">
        MADXP er tilgængelig i hele Danmark. Kontakt os for et gratis tilbud.
      </p>
      <a
        href="/da/tilbud/"
        class="inline-block bg-madxp-blue text-madxp-ink font-bold px-8 py-4 rounded-xl hover:bg-madxp-blue-deep transition-colors"
      >
        Få et gratis tilbud
      </a>
    </div>
  </section>
</BaseLayout>
