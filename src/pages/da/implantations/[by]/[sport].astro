---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { cities, sports } from '@/data/da/implantations';
import { buildBreadcrumbJsonLd, buildFAQPageJsonLd } from '@/lib/jsonLd';

export function getStaticPaths() {
  return cities.flatMap((city) =>
    sports.map((sport) => ({
      params: { by: city.slug, sport: sport.slug },
      props: { city, sport },
    })),
  );
}

const { city, sport } = Astro.props;
const siteUrl = 'https://www.neopro-communication.fr';
const canonicalUrl = `${siteUrl}/da/implantations/${city.slug}/${sport.slug}`;

const breadcrumb = buildBreadcrumbJsonLd([
  { name: 'Forside', url: `${siteUrl}/da` },
  { name: 'Lokationer', url: `${siteUrl}/da/implantations` },
  { name: city.name, url: `${siteUrl}/da/implantations/${city.slug}` },
  { name: sport.name, url: canonicalUrl },
]);

const faq = buildFAQPageJsonLd([
  {
    question: `Hvad koster Neopro for en ${sport.name}klub ${city.at}?`,
    answer: `Prisen afhænger af din konfiguration (antal skærme, størrelse på ${sport.venue}, valgte ydelser). Vi tilbyder pakker til alle klubber — fra eliten til bredden — fra få hundrede kroner om måneden. Anmod om et gratis tilbud til din klub ${city.at}.`,
  },
  {
    question: `Hvordan fungerer Neopro i en ${sport.venue} til ${sport.name}?`,
    answer: `Neopro installerer LED-skærme i din ${sport.venue} og styrer visningen via fjernbetjening gennem vores platform. Du vælger indholdet (sponsorer, stilling, klubnyheder), og vi sørger for afspilningen. Installationen tager normalt mindre end én dag.`,
  },
  {
    question: `Er Neopro tilgængelig for ${sport.name}klubber i ${city.region}?`,
    answer: `Ja, Neopro er tilgængelig i hele Danmark. Vores team kommer ${city.at} og til hele ${city.region} for installationen. Indholdsopdateringer og teknisk support håndteres derefter via fjernstyring.`,
  },
]);
---

<BaseLayout
  title={`${sport.name}løsning ${city.at} — Neopro`}
  description={`Neopro udstyrer ${sport.name}klubber ${city.at} med LED-skærme og en digital skærmløsning. Gør sponsorer synlige, moderniser din ${sport.venue}. Gratis tilbud.`}
  canonicalUrl={canonicalUrl}
  extraJsonLd={[breadcrumb, faq]}
  noAlternates
  locale="da"
>
  <!-- Hero -->
  <section class="bg-neo-dark text-white py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-neo-green text-sm font-semibold uppercase tracking-widest mb-3">
        Danmark — {city.region}
      </p>
      <h1 class="text-3xl md:text-5xl font-black mb-6">
        Digital løsning til {sport.name}klubber<br />
        <span class="text-neo-green">{city.at}</span>
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto mb-8">
        {sport.description}
      </p>
      <a
        href="/da/tilbud"
        class="inline-block bg-neo-green text-neo-dark font-bold px-8 py-4 rounded-xl hover:bg-neo-green-dark transition-colors"
      >
        Få et gratis tilbud til din klub
      </a>
    </div>
  </section>

  <!-- Use cases -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-neo-dark mb-8 text-center">
        Hvad Neopro giver din {sport.name}klub
      </h2>
      <ul class="grid md:grid-cols-2 gap-4">
        {sport.useCases.map((useCase) => (
          <li class="flex items-start gap-3 p-5 bg-gray-50 rounded-xl">
            <span class="text-neo-green text-xl mt-0.5 flex-shrink-0">✓</span>
            <span class="text-neo-dark">{useCase}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Hvordan fungerer det? -->
  <section class="py-16 px-6 bg-neo-dark-bg text-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black mb-10 text-center">Hvordan fungerer det?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-12 h-12 bg-neo-green rounded-full flex items-center justify-center text-neo-dark font-black text-xl mx-auto mb-4">1</div>
          <h3 class="font-bold mb-2">Gratis rådgivning</h3>
          <p class="text-gray-300 text-sm">
            Vi analyserer din {sport.venue} og dine behov for at foreslå den rigtige løsning.
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-neo-green rounded-full flex items-center justify-center text-neo-dark font-black text-xl mx-auto mb-4">2</div>
          <h3 class="font-bold mb-2">Hurtig installation</h3>
          <p class="text-gray-300 text-sm">
            Vores teknikere installerer skærmene på én dag, uden at forstyrre din kampdrift.
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-neo-green rounded-full flex items-center justify-center text-neo-dark font-black text-xl mx-auto mb-4">3</div>
          <h3 class="font-bold mb-2">Fjernstyring</h3>
          <p class="text-gray-300 text-sm">
            Styr dit indhold via vores platform. Vi tager os af resten.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lokal sektion -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-neo-dark mb-6">
        Neopro {city.at} og i {city.region}
      </h2>
      {city.localInfo ? (
        <p class="text-neo-gray text-lg leading-relaxed mb-4">{city.localInfo}</p>
      ) : null}
      <p class="text-neo-gray text-lg leading-relaxed mb-4">
        Neopro hjælper {sport.name}klubber {city.at} og i hele {city.region}.
        Uanset om det er i bycentrum eller i de omkringliggende kommuner — vores team kommer på stedet for installationen og sørger for teknisk support via fjernstyring.
      </p>
      <p class="text-neo-gray text-lg leading-relaxed">
        Vores løsning er til alle klubber — fra eliten til bredden: ingen teknisk viden nødvendig, en intuitiv brugerflade og hurtig support. Slut dig til de klubber, der allerede har moderniseret deres {sport.venue} med Neopro.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 px-6 bg-gray-50">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-neo-dark mb-10 text-center">
        Ofte stillede spørgsmål
      </h2>
      <div class="space-y-4">
        <details class="bg-white rounded-xl p-6 shadow-sm group">
          <summary class="font-bold text-neo-dark cursor-pointer list-none flex justify-between items-center">
            Hvad koster Neopro for en {sport.name}klub {city.at}?
            <span class="text-neo-green ml-4">+</span>
          </summary>
          <p class="mt-4 text-neo-gray leading-relaxed">
            Prisen afhænger af din konfiguration (antal skærme, størrelse på {sport.venue}, valgte ydelser). Vi tilbyder pakker til alle klubber — fra få hundrede kroner om måneden.
            <a href="/da/tilbud" class="text-neo-green font-semibold hover:underline">Anmod om et gratis tilbud</a> for at få et præcist estimat.
          </p>
        </details>
        <details class="bg-white rounded-xl p-6 shadow-sm">
          <summary class="font-bold text-neo-dark cursor-pointer list-none flex justify-between items-center">
            Hvordan fungerer Neopro i en {sport.venue} til {sport.name}?
            <span class="text-neo-green ml-4">+</span>
          </summary>
          <p class="mt-4 text-neo-gray leading-relaxed">
            Neopro installerer LED-skærme i din {sport.venue} og styrer visningen via fjernbetjening gennem vores platform. Du vælger indholdet (sponsorer, stilling, klubnyheder), og vi sørger for afspilningen. Installationen tager normalt mindre end én dag.
          </p>
        </details>
        <details class="bg-white rounded-xl p-6 shadow-sm">
          <summary class="font-bold text-neo-dark cursor-pointer list-none flex justify-between items-center">
            Er Neopro tilgængelig for {sport.name}klubber i {city.region}?
            <span class="text-neo-green ml-4">+</span>
          </summary>
          <p class="mt-4 text-neo-gray leading-relaxed">
            Ja, Neopro er tilgængelig i hele Danmark. Vores team kommer {city.at} og til hele {city.region} for installationen. Indholdsopdateringer og teknisk support håndteres derefter via fjernstyring.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-6 bg-neo-dark text-white text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black mb-4">
        Klar til at modernisere din {sport.name}klub {city.at}?
      </h2>
      <p class="text-gray-300 mb-8">
        Få et skræddersyet tilbud på få minutter. Svar inden for 48 timer.
      </p>
      <a
        href="/da/tilbud"
        class="inline-block bg-neo-green text-neo-dark font-bold px-8 py-4 rounded-xl hover:bg-neo-green-dark transition-colors text-lg"
      >
        Få mit gratis tilbud
      </a>
    </div>
  </section>

  <!-- Andre sportsgrene -->
  <section class="py-12 px-6 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-lg font-bold text-neo-dark mb-4">
        Andre sportsgrene {city.at}
      </h2>
      <div class="flex flex-wrap gap-3">
        {sports.filter((s) => s.slug !== sport.slug).map((s) => (
          <a
            href={`/da/implantations/${city.slug}/${s.slug}`}
            class="inline-block px-4 py-2 rounded-lg border border-gray-200 text-neo-dark text-sm font-medium hover:border-neo-green hover:text-neo-green transition-colors"
          >
            {s.name}
          </a>
        ))}
        <a
          href={`/da/implantations/${city.slug}`}
          class="inline-block px-4 py-2 rounded-lg border border-gray-200 text-neo-gray text-sm hover:border-neo-green hover:text-neo-green transition-colors"
        >
          Alle sportsgrene {city.at}
        </a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb nav -->
  <nav class="py-4 px-6 bg-gray-50 text-sm text-neo-gray" aria-label="Brødkrumme-navigation">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-1 items-center">
      <a href="/da/" class="hover:text-neo-dark">Forside</a>
      <span>/</span>
      <a href="/da/implantations" class="hover:text-neo-dark">Lokationer</a>
      <span>/</span>
      <a href={`/da/implantations/${city.slug}`} class="hover:text-neo-dark">{city.name}</a>
      <span>/</span>
      <span class="text-neo-dark font-medium">{sport.name}</span>
    </div>
  </nav>
</BaseLayout>
