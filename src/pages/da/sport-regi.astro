---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { useTranslations, localeRoutePath, localePath } from '@/i18n/utils';
import {
  buildBreadcrumbJsonLd,
  buildFAQPageJsonLd,
  buildServiceJsonLd,
} from '@/lib/jsonLd';

const locale = 'da';
const t = useTranslations(locale);

const siteUrl = 'https://www.neopro-communication.fr';
const canonicalUrl = `${siteUrl}/da/sport-regi`;

const breadcrumb = buildBreadcrumbJsonLd([
  { name: 'Forside', url: `${siteUrl}/da` },
  { name: t('nav.regie'), url: canonicalUrl },
]);

const service = buildServiceJsonLd({
  name: t('regie.title'),
  description: t('regie.description'),
  url: canonicalUrl,
  providerName: 'Neopro',
  providerUrl: siteUrl,
  areaServed: ['France', 'Belgium', 'Switzerland'],
  serviceType: t('regie.hero.tag'),
});

const faq = buildFAQPageJsonLd([
  { question: t('regie.faq.q1'), answer: t('regie.faq.a1') },
  { question: t('regie.faq.q2'), answer: t('regie.faq.a2') },
  { question: t('regie.faq.q3'), answer: t('regie.faq.a3') },
  { question: t('regie.faq.q4'), answer: t('regie.faq.a4') },
  { question: t('regie.faq.q5'), answer: t('regie.faq.a5') },
]);

const features = [
  { title: t('regie.feat1.title'), description: t('regie.feat1.desc') },
  { title: t('regie.feat2.title'), description: t('regie.feat2.desc') },
  { title: t('regie.feat3.title'), description: t('regie.feat3.desc') },
  { title: t('regie.feat4.title'), description: t('regie.feat4.desc') },
  { title: t('regie.feat5.title'), description: t('regie.feat5.desc') },
  { title: t('regie.feat6.title'), description: t('regie.feat6.desc') },
];

const niveaux = [
  { label: t('regie.who1.title'), description: t('regie.who1.desc') },
  { label: t('regie.who2.title'), description: t('regie.who2.desc') },
  { label: t('regie.who3.title'), description: t('regie.who3.desc') },
];
---

<BaseLayout
  title={t('regie.title')}
  description={t('regie.description')}
  canonicalUrl={canonicalUrl}
  extraJsonLd={[breadcrumb, service, faq]}
  locale={locale}
>
  <!-- Hero -->
  <section class="relative bg-[#2f3935] text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#2f3935] via-[#2f3935] to-[#3d4a45]"></div>
    <div class="relative max-w-[1200px] mx-auto px-[20px] md:px-[40px] lg:px-[60px] py-[100px] md:py-[140px]">
      <p class="text-[14px] md:text-[16px] tracking-[2px] text-[#81e3bc] uppercase font-bold mb-[20px]">
        {t('regie.hero.tag')}
      </p>
      <h1 class="text-[36px] md:text-[56px] lg:text-[72px] leading-[1.05] font-black mb-[30px] max-w-[960px]">
        <span class="font-playfair italic font-normal">{t('regie.hero.h1a')}</span>{t('regie.hero.h1b')}<br />
        {t('regie.hero.h1c')}<span class="text-[#81e3bc]">{t('regie.hero.h1d')}</span>{t('regie.hero.h1e')}
      </h1>
      <p class="text-[18px] md:text-[22px] text-white/80 max-w-[760px] leading-relaxed mb-[40px]">
        {t('regie.hero.sub')}
      </p>
      <div class="flex flex-wrap gap-[16px]">
        <Button href={localeRoutePath('/devis', locale)} variant="green" arrow>{t('regie.hero.cta1')}</Button>
        <Button href={localePath('/solution', locale)} variant="white" arrow>{t('regie.hero.cta2')}</Button>
      </div>
    </div>
  </section>

  <!-- What is -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[30px]">
        <span class="font-playfair italic">{t('regie.what.h2a')}</span>{t('regie.what.h2b')}
      </h2>
      <div class="prose prose-lg max-w-none text-[#4a5565] text-[18px] leading-[1.7]">
        <p>{t('regie.what.p1')}</p>
        <p>{t('regie.what.p2')}</p>
        <p>{t('regie.what.p3')}</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
          {t('regie.features.tag')}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] leading-[1.1]">
          <span class="font-playfair italic">{t('regie.features.h2a')}</span>{t('regie.features.h2b')}
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]">
        {features.map((feat) => (
          <div class="bg-white rounded-[20px] p-[30px] border border-gray-200 hover:border-neo-green-dark transition-colors">
            <h3 class="text-[22px] font-bold text-[#101828] mb-[14px]">{feat.title}</h3>
            <p class="text-[16px] text-neo-gray leading-[1.6]">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For whom -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
          {t('regie.who.tag')}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] leading-[1.1]">
          <span class="font-playfair italic">{t('regie.who.h2a')}</span>{t('regie.who.h2b')}
        </h2>
        <p class="text-[18px] text-neo-gray mt-[20px]">
          {t('regie.who.sub')}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
        {niveaux.map((niveau) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] md:p-[40px]">
            <h3 class="text-[24px] font-bold text-[#101828] mb-[16px]">{niveau.label}</h3>
            <p class="text-[16px] text-neo-gray leading-[1.6]">{niveau.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#2f3935] text-white">
    <div class="max-w-[900px] mx-auto text-center">
      <h2 class="text-[32px] md:text-[48px] font-bold mb-[20px] leading-[1.1]">
        <span class="font-playfair italic font-normal">{t('regie.cta.h2a')}</span><br />
        <span class="font-black">{t('regie.cta.h2b')}</span>
      </h2>
      <p class="text-[18px] text-white/70 max-w-[640px] mx-auto mb-[40px]">
        {t('regie.cta.sub')}
      </p>
      <div class="flex flex-wrap gap-[16px] justify-center">
        <Button href={localeRoutePath('/offres', locale)} variant="green" arrow>{t('regie.cta.btn1')}</Button>
        <Button href={localeRoutePath('/devis', locale)} variant="white" arrow>{t('regie.cta.btn2')}</Button>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[40px]">
        <span class="font-playfair italic">{t('regie.faq.title.a')}</span>{t('regie.faq.title.b')}
      </h2>
      <div class="flex flex-col divide-y divide-gray-200 border-t border-b border-gray-200">
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#101828] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q1')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>{t('regie.faq.a1')}</p>
          </div>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#101828] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q2')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>{t('regie.faq.a2')}</p>
          </div>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#101828] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q3')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>{t('regie.faq.a3')}</p>
          </div>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#101828] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q4')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>{t('regie.faq.a4')}</p>
          </div>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#101828] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q5')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>
              {t('regie.faq.a5')}
              <a href={localeRoutePath('/offres', locale)} class="text-neo-green-dark font-semibold hover:underline">{t('regie.faq.link')}</a>.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <div id="contact">
    <ContactForm client:visible />
  </div>
</BaseLayout>
