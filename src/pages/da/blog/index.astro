---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ id }) => id.startsWith('da/'))).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const title = 'Blog — Sportsskiltning, sponsorer og digital';
const description = "Praktiske råd til sportsklubber: digital sportsskiltning, LED-skærme, sponsorværdi og kampanimation.";
---

<BaseLayout title={title} description={description} noAlternates locale="da">
  <!-- Hero -->
  <section class="bg-madxp-night px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[900px]">
      <p class="text-[16px] tracking-[2px] text-[#d9d9d9] uppercase mb-[20px]">BLOG</p>
      <h1 class="text-[36px] md:text-[50px] lg:text-[70px] leading-[1.1] text-white mb-[20px]">
        <span class="font-display">Ressourcer til</span><br />
        <span class="font-black">jeres klub</span>
      </h1>
      <p class="text-[18px] text-[rgba(255,255,255,0.7)] max-w-[600px]">
        Praktiske guides, erfaringer og tips til at professionalisere din sportsklub — fra professionelt til regionalt niveau.
      </p>
    </div>
  </section>

  <!-- Articles -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[900px] mx-auto">
      <div class="flex flex-col gap-[40px]">
        {posts.map((post) => (
          <article class="group">
            <a href={`/da/blog/${post.id.replace('da/', '')}/`} class="block">
              <div class="flex flex-col gap-[12px]">
                <div class="flex items-center gap-[12px] text-[14px] text-madxp-gray">
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>
                    {post.data.date.toLocaleDateString('da-DK', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  {post.data.tags.length > 0 && (
                    <>
                      <span>·</span>
                      <span>{post.data.tags[0]}</span>
                    </>
                  )}
                </div>
                <h2 class="text-[24px] md:text-[28px] font-bold text-[#0a0b0d] group-hover:text-madxp-blue-deep transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-[16px] text-madxp-gray leading-relaxed">
                  {post.data.description}
                </p>
                <span class="text-madxp-blue-deep font-medium text-[16px] group-hover:underline">
                  Læs artiklen →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
