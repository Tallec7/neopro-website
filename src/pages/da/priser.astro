<style>
  .js-toggle-btn[aria-pressed="true"] {
    background-color: #0a0b0d;
    color: #ffffff;
  }
  .js-toggle-btn[aria-pressed="false"] {
    color: #4a5565;
  }
</style>

<script>
  // Toggle Årlig / Månedlig
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.js-toggle-btn');
  const priceEls = document.querySelectorAll<HTMLElement>('[data-price-annual]');

  function setPeriod(period: 'annual' | 'monthly') {
    toggleBtns.forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.period === period ? 'true' : 'false');
    });
    priceEls.forEach((el) => {
      const annual = Number(el.dataset.priceAnnual);
      const monthly = Number(el.dataset.priceMonthly);
      const priceSpan = el.querySelector('.js-price') as HTMLElement | null;
      const suffixSpan = el.querySelector('.js-suffix') as HTMLElement | null;
      const secondary = el.parentElement?.querySelector('.js-secondary') as HTMLElement | null;
      if (!priceSpan || !suffixSpan) return;
      if (period === 'annual') {
        priceSpan.textContent = `${annual.toLocaleString('da-DK')} €`;
        suffixSpan.textContent = '/år';
        if (secondary) secondary.classList.add('hidden');
      } else if (monthly) {
        priceSpan.textContent = `${monthly} €`;
        suffixSpan.textContent = '/md';
        if (secondary) secondary.classList.remove('hidden');
      }
    });
  }

  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const period = btn.dataset.period as 'annual' | 'monthly';
      setPeriod(period);
    });
  });

  const form = document.querySelector('[data-financable-form]') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const msg = form.querySelector('[data-form-message]') as HTMLParagraphElement;
      const pdfUrl = form.dataset.pdfUrl;

      if (!emailInput?.value) return;

      btn.disabled = true;
      btn.textContent = 'Sender...';
      msg.classList.add('hidden');

      try {
        const res = await fetch('/api/document', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value, documentUrl: pdfUrl }),
        });

        if (res.ok) {
          msg.textContent = 'Dokument sendt! Tjek jeres indbakke.';
          msg.className = 'text-[14px] mt-2 w-full text-madxp-blue-deep';
          emailInput.value = '';
        } else {
          msg.textContent = 'Der opstod en fejl.';
          msg.className = 'text-[14px] mt-2 w-full text-red-600';
        }
      } catch {
        msg.textContent = 'Forbindelsesfejl. Prøv igen senere.';
        msg.className = 'text-[14px] mt-2 w-full text-red-600';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Modtag dokumentet';
      }
    });
  }
</script>
