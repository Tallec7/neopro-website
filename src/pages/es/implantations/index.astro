---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { cities, sports } from '@/data/es/implantations';
import { buildBreadcrumbJsonLd } from '@/lib/jsonLd';

const siteUrl = 'https://www.neopro-communication.fr';
const canonicalUrl = `${siteUrl}/es/implantations`;

const esCities = cities.filter((c) => c.country === 'ES');

const breadcrumb = buildBreadcrumbJsonLd([
  { name: 'Inicio', url: `${siteUrl}/es` },
  { name: 'Ubicaciones', url: canonicalUrl },
]);
---

<BaseLayout
  title="Se\u00f1alizaci\u00f3n deportiva digital \u2014 Ubicaciones Neopro en Espa\u00f1a"
  description="Neopro instala soluciones de se\u00f1alizaci\u00f3n digital llave en mano en pabellones deportivos. Balonmano, baloncesto, voleibol y m\u00e1s. Encuentra tu ubicaci\u00f3n en Espa\u00f1a."
  canonicalUrl={canonicalUrl}
  extraJsonLd={breadcrumb}
  noAlternates
  locale="es"
>
  <!-- Hero -->
  <section class="bg-neo-dark text-white py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-black mb-6">
        Neopro en toda<br />
        <span class="text-neo-green">Espa\u00f1a</span>
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        Acompa\u00f1amos a clubes deportivos en toda Espa\u00f1a con una soluci\u00f3n de se\u00f1alizaci\u00f3n digital llave en mano. Encuentra tu ciudad y descubre c\u00f3mo Neopro puede profesionalizar tu club.
      </p>
    </div>
  </section>

  <!-- Deportes -->
  <section class="py-10 px-6 bg-gray-50">
    <div class="max-w-4xl mx-auto flex flex-wrap justify-center gap-3">
      {sports.map((sport) => (
        <span class="px-4 py-2 bg-white rounded-full text-sm font-medium text-neo-dark border border-gray-200">
          {sport.name}
        </span>
      ))}
    </div>
  </section>

  <!-- Espa\u00f1a -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-neo-dark mb-8">
        \ud83c\uddea\ud83c\uddf8 Espa\u00f1a
      </h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
        {esCities.map((city) => (
          <a
            href={`/es/implantations/${city.slug}`}
            class="block px-5 py-4 bg-gray-50 rounded-xl hover:bg-neo-green transition-all font-medium text-neo-dark"
          >
            {city.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-6 bg-neo-dark text-white text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black mb-4">
        \u00bfTu ciudad no aparece?
      </h2>
      <p class="text-gray-300 mb-8">
        Neopro est\u00e1 disponible en toda Espa\u00f1a. Cont\u00e1ctanos para un presupuesto gratuito.
      </p>
      <a
        href="/es/presupuesto"
        class="inline-block bg-neo-green text-neo-dark font-bold px-8 py-4 rounded-xl hover:bg-neo-green-dark transition-colors"
      >
        Solicitar presupuesto gratuito
      </a>
    </div>
  </section>
</BaseLayout>
