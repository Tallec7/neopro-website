---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SportBullet from '@/components/SportBullet.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { Image } from 'astro:assets';
import { useTranslations } from '@/i18n/utils';

// ── Images ───────────────────────────────────────────────────────
import heroImg from '@/assets/images/hero-solution.webp';

// ── ES Data ─────────────────────────────────────────────────────
import { solutionPanels, colorPanels, steps } from '@/data/es/solution';
import { chainSteps } from '@/data/es/offres';

const panelIconVariants = ['pink', 'yellow', 'green', 'blue'] as const;

const formatPanelTitle = (title: string) => {
  const spaceIdx = title.indexOf(' ');
  if (spaceIdx === -1) return `<span class="font-bold">${title}</span>`;
  const first = title.substring(0, spaceIdx);
  const rest = title.substring(spaceIdx + 1);
  return `<span class="font-display font-normal">${first}</span> <span class="font-black">${rest}</span>`;
};

const locale = 'es';
const t = useTranslations(locale);
---

<BaseLayout title={t('solution.title')} description={t('solution.description')} locale={locale}>
  <!-- Hero -->
  <section class="relative h-[743px] overflow-hidden">
    <Image
      src={heroImg}
      alt="Jugadores de balonmano frente a una pantalla digital MADXP mostrando celebraciones pre-partido"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-[rgba(6,38,63,0.5)]"></div>
    <div class="relative z-10 h-full flex flex-col justify-end px-[20px] md:px-[40px] lg:px-[60px] pb-[60px] md:pb-[80px]">
      <p class="text-[16px] tracking-[2px] text-[#d9d9d9] uppercase mb-[20px]">{t('solution.hero.label')}</p>
      <h1 class="text-[36px] md:text-[50px] lg:text-[70px] leading-[1.1] text-white mb-[30px]">
        <span class="font-display">{t('solution.hero.line1')}</span><br />
        <span class="font-black">{t('solution.hero.line2')}</span>
      </h1>
      <p class="text-white/80 text-[16px] md:text-[18px] max-w-[620px] mb-[24px]">
        Una régie digital llave en mano pensada para los clubes deportivos — del nivel profesional al campeonato regional.
      </p>
      <div>
        <Button href="#contact" variant="green" arrow>{t('solution.hero.cta')}</Button>
      </div>
    </div>
  </section>

  <!-- Solution panels -->
  <section class="pb-[60px] md:pb-[100px] pt-[40px] px-[20px] md:px-[40px] lg:px-[60px]">
    <div class="max-w-[1200px] mx-auto">
      <p class="text-[16px] font-bold opacity-60 tracking-[2px] uppercase mb-[30px]">{t('solution.panels.label')}</p>
      {solutionPanels.map((panel, i) => (
        <div
          class="sticky top-[120px] bg-white rounded-[20px] shadow-lg overflow-hidden mb-8"
          style={`z-index: ${10 + i}`}
        >
          <div class="flex flex-col md:flex-row gap-[60px] py-[60px] md:py-[120px] px-[30px] md:px-[60px]">
            <div class="flex-1 flex flex-col justify-center gap-[30px]">
              <h2 class="text-[28px] md:text-[36px] lg:text-[48px]" set:html={formatPanelTitle(panel.title)} />
              <p class="text-madxp-gray text-[18px]">{panel.description}</p>
            </div>
            <div class="flex-1 rounded-[20px] overflow-hidden bg-[#0a0b0d] aspect-video">
              <video class="w-full h-full object-cover" autoplay muted loop playsinline>
                <source src={panel.videoUrl || `/videos/solution-panel-${i + 1}.mp4`} type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- How does it work? -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pb-[60px] md:pb-[120px] pt-[60px] md:pt-[100px]">
    <div class="max-w-[1200px] mx-auto">
      <p class="text-[16px] font-bold opacity-60 tracking-[2px] uppercase mb-[40px]">{t('solution.steps.label')}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
        {steps.map((step, i) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] md:p-[40px] flex flex-col items-center text-center gap-[20px] fade-in-step" style={`--step: ${i}`}>
            <span class="text-[64px] md:text-[80px] font-black text-[#0a0b0d] leading-none">{step.number}</span>
            <h3 class="text-[20px] md:text-[24px] font-bold">{step.title}</h3>
            <p class="text-[16px] text-[#4a5565]">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .fade-in-step {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s ease, transform 0.6s ease;
      transition-delay: calc(var(--step) * 0.15s);
    }
    .fade-in-step.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <script>
    const steps = document.querySelectorAll('.fade-in-step');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.2 }
    );
    steps.forEach((el) => observer.observe(el));
  </script>

  <!-- Color panels -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[1200px] mx-auto">
      <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#0a0b0d] mb-[60px]">{t('solution.more.title')}</h2>
      <div class="flex flex-col gap-[20px]">
        {colorPanels.map((panel, i) => (
          <div
            class={`sticky top-[120px] ${panel.bgColor} text-white rounded-[20px] px-[20px] md:px-[40px] py-[60px]`}
            style={`z-index: ${10 + i}`}
          >
            <div class="flex flex-col md:flex-row gap-[30px] md:gap-[60px] items-start">
              <h3 class="text-[28px] font-bold md:w-[300px] lg:w-[400px] shrink-0">{panel.title}</h3>
              <ul class="flex flex-col gap-[20px] flex-1">
                {panel.features.map((f) => (
                  <li class="flex items-center gap-[15px] text-[20px] text-white">
                    <SportBullet variant={panelIconVariants[i] || 'green'} />
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- La cadena MADXP (servicios complementarios full-stack) -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pt-[60px] md:pt-[96px] pb-[30px] md:pb-[40px]">
    <div class="max-w-[1320px] mx-auto">
      <div class="mb-[50px] max-w-[760px]">
        <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[16px]">SERVICIOS COMPLEMENTARIOS</p>
        <h2 class="text-[28px] md:text-[36px] lg:text-[44px] font-bold text-[#0a0b0d] mb-[16px]">
          <span class="font-display">La cadena</span> MADXP, de la A a la Z
        </h2>
        <p class="text-[18px] text-madxp-gray">Desde la sesión de fotos de tus jugadores hasta la pantalla encendida al borde del campo, cubrimos toda la cadena. Toma lo que necesites.</p>
      </div>

      <div class="relative">
        <div class="hidden lg:block absolute top-[34px] left-[8%] right-[8%] h-[2px] bg-gradient-to-r from-[#0e578e] via-[#4a8bbf] to-[#0e578e] opacity-40"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px] relative">
          {chainSteps.map((s) => (
            <div class="relative bg-white border border-gray-200 rounded-[20px] p-[24px] flex flex-col hover:border-madxp-blue-deep transition-colors">
              <div class="flex items-center gap-[14px] mb-[14px]">
                <span class="shrink-0 w-[52px] h-[52px] rounded-full bg-[#0e578e] text-[#06263f] flex items-center justify-center font-bold text-[16px] shadow-sm">
                  {s.step}
                </span>
                <h3 class="text-[22px] font-bold text-[#0a0b0d]">{s.title}</h3>
              </div>
              <p class="text-[14px] text-madxp-gray italic mb-[18px] min-h-[40px]">{s.tagline}</p>
              <ul class="flex flex-col gap-[12px] flex-1">
                {s.services.map((opt) => (
                  <li class="flex items-start gap-[10px]">
                    <svg class="w-4 h-4 shrink-0 text-madxp-blue-deep mt-[4px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                    <div>
                      <p class="text-[14px] text-[#0a0b0d] leading-snug">{opt.label}</p>
                      {opt.hint && <p class="text-[12px] text-madxp-gray mt-[2px]">{opt.hint}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <p class="text-center text-[14px] text-madxp-gray mt-[30px]">
        Todos estos servicios están disponibles como opción o complemento — presupuesto personalizado bajo demanda.
      </p>
    </div>
  </section>

  <!-- CTA to plans -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[1200px] mx-auto">
      <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-[120px]">
        <div class="w-full lg:w-[550px] flex-shrink-0 aspect-square rounded-[20px] overflow-hidden bg-[#f5f5f5]">
          <img
            src="/images/image_offre.jpg"
            alt="Pantalla MADXP en un gimnasio — descubre los planes"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="flex-1 flex flex-col gap-[20px] items-start">
          <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#0a0b0d]">
            {t('solution.offres.title')}
          </h2>
          <p class="text-[18px] text-[#4a5565]">
            {t('solution.offres.text')}
          </p>
          <div class="mt-[20px]">
            <Button href="/es/precios/" variant="black" arrow>
              {t('solution.offres.cta')}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <div id="contact">
    <ContactForm locale="es" client:visible />
  </div>
</BaseLayout>
