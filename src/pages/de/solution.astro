---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SportBullet from '@/components/SportBullet.astro';
import ContactForm from '@/components/ContactForm.tsx';
import OfferCard from '@/components/mock/OfferCard.astro';
import { useTranslations } from '@/i18n/utils';

// ── DE Data ─────────────────────────────────────────────────────
import { solutionPanels, colorPanels, steps } from '@/data/de/solution';
import { chainSteps } from '@/data/de/offres';

const panelIconVariants = ['pink', 'yellow', 'green', 'blue'] as const;

const formatPanelTitle = (title: string) => {
  const spaceIdx = title.indexOf(' ');
  if (spaceIdx === -1) return `<span class="font-bold">${title}</span>`;
  const first = title.substring(0, spaceIdx);
  const rest = title.substring(spaceIdx + 1);
  return `<span class="font-display font-normal">${first}</span> <span class="font-black">${rest}</span>`;
};

const locale = 'de';
const t = useTranslations(locale);
---

<BaseLayout title={t('solution.title')} description={t('solution.description')} locale={locale}>
  <!-- Hero — typo + couleur, sans photo -->
  <section class="relative bg-madxp-night text-madxp-bone overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-[8%] top-0 h-full w-[50%] bg-madxp-blue/25 [clip-path:polygon(30%_0,100%_0,100%_100%,0_100%)]"></div>
      <div class="absolute -right-[2%] top-0 h-full w-[38%] bg-madxp-blue/30 [clip-path:polygon(36%_0,100%_0,100%_100%,0_100%)]"></div>
      <span class="absolute right-[3%] bottom-[-6%] font-display text-[30vw] leading-none text-madxp-bone/[0.04] select-none">MX</span>
    </div>
    <div class="relative z-10 max-w-[1320px] mx-auto px-[20px] md:px-[40px] lg:px-[60px] pt-28 md:pt-[170px] pb-[60px] md:pb-[110px]">
      <p class="font-mono uppercase tracking-[0.22em] text-[12px] md:text-[15px] text-madxp-light mb-6">{t('solution.hero.label')}</p>
      <h1 class="font-display uppercase leading-[0.9] text-[44px] md:text-[84px] max-w-[14ch]">
        <span>{t('solution.hero.line1')}</span> <span class="text-madxp-light">{t('solution.hero.line2')}</span>
      </h1>
      <p class="mt-6 text-[18px] md:text-[22px] text-madxp-bone/80 max-w-[620px]">
        Eine schlüsselfertige digitale Lösung für Sportvereine — vom Profibereich bis zur Regionalliga.
      </p>
      <div class="mt-9">
        <Button href="#contact" variant="white" arrow>{t('solution.hero.cta')}</Button>
      </div>
    </div>
  </section>

  <!-- Solution panels -->
  <section class="pb-[60px] md:pb-[100px] pt-[40px] px-[20px] md:px-[40px] lg:px-[60px]">
    <div class="max-w-[1200px] mx-auto">
      <p class="text-[16px] font-bold opacity-60 tracking-[2px] uppercase mb-[30px]">{t('solution.panels.label')}</p>
      {solutionPanels.map((panel, i) => (
        <div
          class="sticky top-[120px] bg-white rounded-[20px] shadow-lg overflow-hidden mb-8"
          style={`z-index: ${10 + i}`}
        >
          <div class="flex flex-col md:flex-row gap-[60px] py-[60px] md:py-[120px] px-[30px] md:px-[60px]">
            <div class="flex-1 flex flex-col justify-center gap-[30px]">
              <h2 class="text-[28px] md:text-[36px] lg:text-[48px]" set:html={formatPanelTitle(panel.title)} />
              <p class="text-madxp-gray text-[18px]">{panel.description}</p>
            </div>
            <!-- Maquette « écran gymnase » CSS (sans vidéo) -->
            <div class="flex-1 relative rounded-[20px] overflow-hidden bg-madxp-ink aspect-video flex items-center justify-center p-8">
              <div class="pointer-events-none absolute -right-[12%] top-0 h-full w-[46%] bg-madxp-blue/25 [clip-path:polygon(38%_0,100%_0,100%_100%,0_100%)]"></div>
              <span class="absolute top-4 left-5 font-mono text-[11px] tracking-[0.2em] text-madxp-bone/50 uppercase">MadXP · Hallenbildschirm</span>
              <span class="absolute top-4 right-5 inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] text-madxp-bone/80 uppercase"><span class="w-1.5 h-1.5 rounded-full bg-madxp-red animate-pulse"></span> Live</span>
              <p class="relative font-display uppercase text-[32px] md:text-[52px] leading-[0.95] text-center text-madxp-bone max-w-[85%]" set:html={formatPanelTitle(panel.title)} />
              <span class="absolute bottom-4 left-5 right-5 flex gap-2">
                <span class="flex-1 h-5 rounded bg-madxp-bone/12"></span>
                <span class="flex-1 h-5 rounded bg-madxp-bone/12"></span>
                <span class="flex-1 h-5 rounded bg-madxp-bone/12"></span>
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Wie funktioniert es? -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pb-[60px] md:pb-[120px] pt-[60px] md:pt-[100px]">
    <div class="max-w-[1200px] mx-auto">
      <p class="text-[16px] font-bold opacity-60 tracking-[2px] uppercase mb-[40px]">{t('solution.steps.label')}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
        {steps.map((step, i) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] md:p-[40px] flex flex-col items-center text-center gap-[20px] fade-in-step" style={`--step: ${i}`}>
            <span class="text-[64px] md:text-[80px] font-black text-[#0a0b0d] leading-none">{step.number}</span>
            <h3 class="text-[20px] md:text-[24px] font-bold">{step.title}</h3>
            <p class="text-[16px] text-[#4a5565]">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .fade-in-step {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s ease, transform 0.6s ease;
      transition-delay: calc(var(--step) * 0.15s);
    }
    .fade-in-step.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <script>
    const steps = document.querySelectorAll('.fade-in-step');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.2 }
    );
    steps.forEach((el) => observer.observe(el));
  </script>

  <!-- Color panels -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[1200px] mx-auto">
      <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#0a0b0d] mb-[60px]">{t('solution.more.title')}</h2>
      <div class="flex flex-col gap-[20px]">
        {colorPanels.map((panel, i) => (
          <div
            class={`sticky top-[120px] ${panel.bgColor} text-white rounded-[20px] px-[20px] md:px-[40px] py-[60px]`}
            style={`z-index: ${10 + i}`}
          >
            <div class="flex flex-col md:flex-row gap-[30px] md:gap-[60px] items-start">
              <h3 class="text-[28px] font-bold md:w-[300px] lg:w-[400px] shrink-0">{panel.title}</h3>
              <ul class="flex flex-col gap-[20px] flex-1">
                {panel.features.map((f) => (
                  <li class="flex items-center gap-[15px] text-[20px] text-white">
                    <SportBullet variant={panelIconVariants[i] || 'green'} />
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Die MADXP-Kette (Full-Stack-Servicekette) -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pt-[60px] md:pt-[96px] pb-[30px] md:pb-[40px]">
    <div class="max-w-[1320px] mx-auto">
      <div class="mb-[50px] max-w-[760px]">
        <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[16px]">ERGÄNZENDE SERVICES</p>
        <h2 class="text-[28px] md:text-[36px] lg:text-[44px] font-bold text-[#0a0b0d] mb-[16px]">
          <span class="font-display">Die MADXP-Kette</span>, von A bis Z
        </h2>
        <p class="text-[18px] text-madxp-gray">Vom Shooting Ihrer Spieler bis zum eingeschalteten Bildschirm am Spielfeldrand decken wir die gesamte Kette ab. Sie nehmen, was Sie brauchen.</p>
      </div>

      <div class="relative">
        <div class="hidden lg:block absolute top-[34px] left-[8%] right-[8%] h-[2px] bg-gradient-to-r from-[#0e578e] via-[#4a8bbf] to-[#0e578e] opacity-40"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px] relative">
          {chainSteps.map((s) => (
            <div class="relative bg-white border border-gray-200 rounded-[20px] p-[24px] flex flex-col hover:border-madxp-blue-deep transition-colors">
              <div class="flex items-center gap-[14px] mb-[14px]">
                <span class="shrink-0 w-[52px] h-[52px] rounded-full bg-[#0e578e] text-[#06263f] flex items-center justify-center font-bold text-[16px] shadow-sm">
                  {s.step}
                </span>
                <h3 class="text-[22px] font-bold text-[#0a0b0d]">{s.title}</h3>
              </div>
              <p class="text-[14px] text-madxp-gray italic mb-[18px] min-h-[40px]">{s.tagline}</p>
              <ul class="flex flex-col gap-[12px] flex-1">
                {s.services.map((opt) => (
                  <li class="flex items-start gap-[10px]">
                    <svg class="w-4 h-4 shrink-0 text-madxp-blue-deep mt-[4px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                    <div>
                      <p class="text-[14px] text-[#0a0b0d] leading-snug">{opt.label}</p>
                      {opt.hint && <p class="text-[12px] text-madxp-gray mt-[2px]">{opt.hint}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <p class="text-center text-[14px] text-madxp-gray mt-[30px]">
        Alle diese Services sind als Option oder Upsell verfügbar — individuelle Kalkulation auf Anfrage.
      </p>
    </div>
  </section>

  <!-- CTA Angebote -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[1200px] mx-auto">
      <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-[120px]">
        <OfferCard
          square
          class="w-full lg:w-[550px] flex-shrink-0"
          fromLabel="Ab"
          price="79"
          period="/ Monat"
          note="Finanzierbar durch Ihre Partner. Ohne lange Bindung."
          features={['Bildschirm + Regie-Software', 'Fernbedienungs-App', 'Video- & Sponsoreninhalte', 'Schlüsselfertige Installation']}
        />
        <div class="flex-1 flex flex-col gap-[20px] items-start">
          <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#0a0b0d]">
            {t('solution.offres.title')}
          </h2>
          <p class="text-[18px] text-[#4a5565]">
            {t('solution.offres.text')}
          </p>
          <div class="mt-[20px]">
            <Button href="/de/angebote/" variant="black" arrow>
              {t('solution.offres.cta')}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <div id="contact">
    <ContactForm locale="de" client:visible />
  </div>
</BaseLayout>
