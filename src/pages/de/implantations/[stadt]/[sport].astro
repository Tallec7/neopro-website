---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { cities, sports } from '@/data/de/implantations';
import { buildBreadcrumbJsonLd, buildFAQPageJsonLd } from '@/lib/jsonLd';

export function getStaticPaths() {
  return cities.flatMap((city) =>
    sports.map((sport) => ({
      params: { stadt: city.slug, sport: sport.slug },
      props: { city, sport },
    })),
  );
}

const { city, sport } = Astro.props;
const siteUrl = 'https://madxp.kalonpartners.bzh';
const canonicalUrl = `${siteUrl}/de/implantations/${city.slug}/${sport.slug}`;
const countryLabel = city.country === 'DE' ? 'Deutschland' : 'Österreich';

const breadcrumb = buildBreadcrumbJsonLd([
  { name: 'Startseite', url: `${siteUrl}/de` },
  { name: 'Standorte', url: `${siteUrl}/de/implantations` },
  { name: city.name, url: `${siteUrl}/de/implantations/${city.slug}` },
  { name: sport.name, url: canonicalUrl },
]);

const faq = buildFAQPageJsonLd([
  {
    question: `Was kostet MADXP für einen ${sport.name}-Verein ${city.at}?`,
    answer: `Der Preis hängt von Ihrer Konfiguration ab (Anzahl der Bildschirme, Größe der ${sport.venue}, gewählte Leistungen). Wir bieten Pakete für alle Vereine — vom Profisport bis zur Kreisliga — ab wenigen hundert Euro pro Monat. Fordern Sie ein kostenloses Angebot für Ihren Verein ${city.at} an.`,
  },
  {
    question: `Wie funktioniert MADXP in einer ${sport.venue} für ${sport.name}?`,
    answer: `MADXP installiert LED-Bildschirme in Ihrer ${sport.venue} und steuert die Anzeige per Fernbedienung über unsere Plattform. Sie wählen die Inhalte (Sponsoren, Spielstand, Vereinsnews) und wir kümmern uns um die Ausspielung. Die Installation dauert in der Regel weniger als einen Tag.`,
  },
  {
    question: `Ist MADXP für ${sport.name}-Vereine in ${city.region} verfügbar?`,
    answer: `Ja, MADXP ist in ganz Deutschland und Österreich verfügbar. Unser Team kommt ${city.at} und in die gesamte Region ${city.region} für die Installation. Die Content-Updates und der technische Support erfolgen anschließend per Fernwartung.`,
  },
]);
---

<BaseLayout
  title={`${sport.name} Vereinslösung ${city.at} — MADXP`}
  description={`MADXP stattet ${sport.name}-Vereine ${city.at} mit LED-Bildschirmen und einer digitalen Anzeigelösung aus. Sponsoren sichtbar machen, ${sport.venue} modernisieren. Kostenloses Angebot.`}
  canonicalUrl={canonicalUrl}
  extraJsonLd={[breadcrumb, faq]}
  noAlternates
  locale="de"
>
  <!-- Hero -->
  <section class="bg-madxp-ink text-white py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-madxp-blue text-sm font-semibold uppercase tracking-widest mb-3">
        {countryLabel} — {city.region}
      </p>
      <h1 class="text-3xl md:text-5xl font-black mb-6">
        Digitale Lösung für {sport.name}-Vereine<br />
        <span class="text-madxp-blue">{city.at}</span>
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto mb-8">
        {sport.description}
      </p>
      <a
        href="/de/angebot/"
        class="inline-block bg-madxp-blue text-madxp-ink font-bold px-8 py-4 rounded-xl hover:bg-madxp-blue-deep transition-colors"
      >
        Kostenloses Angebot für Ihren Verein
      </a>
    </div>
  </section>

  <!-- Use cases -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-madxp-ink mb-8 text-center">
        Was MADXP Ihrem {sport.name}-Verein bringt
      </h2>
      <ul class="grid md:grid-cols-2 gap-4">
        {sport.useCases.map((useCase) => (
          <li class="flex items-start gap-3 p-5 bg-gray-50 rounded-xl">
            <span class="text-madxp-blue text-xl mt-0.5 flex-shrink-0">✓</span>
            <span class="text-madxp-ink">{useCase}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Wie funktioniert es? -->
  <section class="py-16 px-6 bg-madxp-night text-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black mb-10 text-center">Wie funktioniert es?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-12 h-12 bg-madxp-blue rounded-full flex items-center justify-center text-madxp-ink font-black text-xl mx-auto mb-4">1</div>
          <h3 class="font-bold mb-2">Kostenlose Beratung</h3>
          <p class="text-gray-300 text-sm">
            Wir analysieren Ihre {sport.venue} und Ihre Bedürfnisse, um die passende Lösung vorzuschlagen.
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-madxp-blue rounded-full flex items-center justify-center text-madxp-ink font-black text-xl mx-auto mb-4">2</div>
          <h3 class="font-bold mb-2">Schnelle Installation</h3>
          <p class="text-gray-300 text-sm">
            Unsere Techniker installieren die Bildschirme an einem Tag, ohne Ihren Spielbetrieb zu stören.
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-madxp-blue rounded-full flex items-center justify-center text-madxp-ink font-black text-xl mx-auto mb-4">3</div>
          <h3 class="font-bold mb-2">Fernsteuerung</h3>
          <p class="text-gray-300 text-sm">
            Steuern Sie Ihre Inhalte über unsere Plattform. Wir kümmern uns um den Rest.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lokaler Abschnitt -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-madxp-ink mb-6">
        MADXP {city.at} und in {city.region}
      </h2>
      {city.localInfo ? (
        <p class="text-madxp-gray text-lg leading-relaxed mb-4">{city.localInfo}</p>
      ) : null}
      {city.sportHighlights?.[sport.slug] ? (
        <p class="text-madxp-gray text-lg leading-relaxed mb-4">
          {city.sportHighlights[sport.slug]}
        </p>
      ) : null}
      <p class="text-madxp-gray text-lg leading-relaxed mb-4">
        MADXP begleitet {sport.name}-Vereine {city.at} und in der gesamten Region {city.region}.
        Ob im Stadtzentrum oder in den umliegenden Gemeinden — unser Team kommt für die Installation vor Ort und sorgt für den technischen Support per Fernwartung.
      </p>
      <p class="text-madxp-gray text-lg leading-relaxed">
        Unsere Lösung ist für alle Vereine gedacht — vom Profisport bis zur Kreisliga: keine technischen Vorkenntnisse nötig, eine intuitive Oberfläche und reaktionsschneller Support. Schließen Sie sich den Vereinen an, die ihre {sport.venue} bereits mit MADXP modernisiert haben.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 px-6 bg-gray-50">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-madxp-ink mb-10 text-center">
        Häufig gestellte Fragen
      </h2>
      <div class="space-y-4">
        <details class="bg-white rounded-xl p-6 shadow-sm group">
          <summary class="font-bold text-madxp-ink cursor-pointer list-none flex justify-between items-center">
            Was kostet MADXP für einen {sport.name}-Verein {city.at}?
            <span class="text-madxp-blue ml-4">+</span>
          </summary>
          <p class="mt-4 text-madxp-gray leading-relaxed">
            Der Preis hängt von Ihrer Konfiguration ab (Anzahl der Bildschirme, Größe der {sport.venue}, gewählte Leistungen). Wir bieten Pakete für alle Vereine — ab wenigen hundert Euro pro Monat.
            <a href="/de/angebot/" class="text-madxp-blue font-semibold hover:underline">Fordern Sie ein kostenloses Angebot an</a>, um eine genaue Schätzung zu erhalten.
          </p>
        </details>
        <details class="bg-white rounded-xl p-6 shadow-sm">
          <summary class="font-bold text-madxp-ink cursor-pointer list-none flex justify-between items-center">
            Wie funktioniert MADXP in einer {sport.venue} für {sport.name}?
            <span class="text-madxp-blue ml-4">+</span>
          </summary>
          <p class="mt-4 text-madxp-gray leading-relaxed">
            MADXP installiert LED-Bildschirme in Ihrer {sport.venue} und steuert die Anzeige per Fernbedienung über unsere Plattform. Sie wählen die Inhalte (Sponsoren, Spielstand, Vereinsnews) und wir kümmern uns um die Ausspielung. Die Installation dauert in der Regel weniger als einen Tag.
          </p>
        </details>
        <details class="bg-white rounded-xl p-6 shadow-sm">
          <summary class="font-bold text-madxp-ink cursor-pointer list-none flex justify-between items-center">
            Ist MADXP für {sport.name}-Vereine in {city.region} verfügbar?
            <span class="text-madxp-blue ml-4">+</span>
          </summary>
          <p class="mt-4 text-madxp-gray leading-relaxed">
            Ja, MADXP ist in ganz Deutschland und Österreich verfügbar. Unser Team kommt {city.at} und in die gesamte Region {city.region} für die Installation. Die Content-Updates und der technische Support erfolgen anschließend per Fernwartung.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-6 bg-madxp-ink text-white text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black mb-4">
        Bereit, Ihren {sport.name}-Verein {city.at} zu modernisieren?
      </h2>
      <p class="text-gray-300 mb-8">
        Erhalten Sie in wenigen Minuten ein individuelles Angebot. Antwort innerhalb von 48 Stunden.
      </p>
      <a
        href="/de/angebot/"
        class="inline-block bg-madxp-blue text-madxp-ink font-bold px-8 py-4 rounded-xl hover:bg-madxp-blue-deep transition-colors text-lg"
      >
        Mein kostenloses Angebot anfordern
      </a>
    </div>
  </section>

  <!-- Andere Sportarten -->
  <section class="py-12 px-6 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-lg font-bold text-madxp-ink mb-4">
        Weitere Sportarten {city.at}
      </h2>
      <div class="flex flex-wrap gap-3">
        {sports.filter((s) => s.slug !== sport.slug).map((s) => (
          <a
            href={`/de/implantations/${city.slug}/${s.slug}/`}
            class="inline-block px-4 py-2 rounded-lg border border-gray-200 text-madxp-ink text-sm font-medium hover:border-madxp-blue hover:text-madxp-blue transition-colors"
          >
            {s.name}
          </a>
        ))}
        <a
          href={`/de/implantations/${city.slug}/`}
          class="inline-block px-4 py-2 rounded-lg border border-gray-200 text-madxp-gray text-sm hover:border-madxp-blue hover:text-madxp-blue transition-colors"
        >
          Alle Sportarten {city.at}
        </a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb nav -->
  <nav class="py-4 px-6 bg-gray-50 text-sm text-madxp-gray" aria-label="Brotkrümel-Navigation">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-1 items-center">
      <a href="/de/" class="hover:text-madxp-ink">Startseite</a>
      <span>/</span>
      <a href="/de/implantations/" class="hover:text-madxp-ink">Standorte</a>
      <span>/</span>
      <a href={`/de/implantations/${city.slug}/`} class="hover:text-madxp-ink">{city.name}</a>
      <span>/</span>
      <span class="text-madxp-ink font-medium">{sport.name}</span>
    </div>
  </nav>
</BaseLayout>
