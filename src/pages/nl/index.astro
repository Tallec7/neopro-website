---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ClubCarousel from '@/components/ClubCarousel.tsx';
import ContactForm from '@/components/ContactForm.tsx';
import { Image } from 'astro:assets';
import { useTranslations } from '@/i18n/utils';

import heroImg from '@/assets/images/hero-accueil-v2.webp';
import imageTelephoneImg from '@/assets/images/image-telephone.png';

import { clubs } from '@/data/clubs';

const locale = 'nl';
const t = useTranslations(locale);
---

<BaseLayout title={t('home.title')} description={t('home.description')} locale={locale}>
  <section class="relative h-[500px] md:h-[743px] bg-[#06263f] overflow-hidden">
    <Image src={heroImg} alt="MADXP digitaal scherm met sponsorcontent in sporthal" class="absolute inset-0 w-full h-full object-cover" loading="eager" widths={[768, 1280, 1920]} sizes="100vw" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#06263f] to-[80%] to-[rgba(6,38,63,0.3)]"></div>
    <div class="relative z-10 flex flex-col justify-end h-full text-white p-8 md:p-[60px] gap-8 md:gap-[40px]">
      <h1 class="text-[36px] md:text-[70px] leading-[1]">
        <span class="font-display font-normal">{t('home.hero.line1')}</span>
        <br /><span class="font-black">{t('home.hero.line2')}</span>
        <br /><span class="font-display font-normal">{t('home.hero.line3')}</span>
      </h1>
      <p class="text-white/80 text-[16px] md:text-[20px] max-w-[720px] leading-normal -mt-2">
        We maken van je scherm een interactief medium. Schermen, digitale signage en videocontent voor sportclubs — van profniveau tot regionaal.
      </p>
      <div class="flex flex-wrap gap-6 md:gap-[43px]">
        <Button href="/nl/oplossing/" variant="white" arrow>{t('home.hero.cta')}</Button>
      </div>
    </div>
  </section>

  <section class="relative bg-[#06263f] overflow-hidden">
    <div class="flex flex-col items-center justify-center px-5 pt-16 md:pt-24">
      <h2 class="text-[#093a60] text-[48px] md:text-[128px] leading-[1] text-center mb-6 md:mb-10">
        <span class="font-display font-normal">{t('home.welcome.title1')}</span><span class="font-black">{t('home.welcome.title2')}</span>
      </h2>
      <p class="text-white text-[18px] md:text-[26px] text-center max-w-[1060px] leading-normal mb-10 md:mb-16">
        {t('home.welcome.text')}
      </p>
    </div>
    <div class="px-5 pb-16 md:pb-24">
      <div class="max-w-[1320px] mx-auto">
        <div class="relative rounded-[20px] overflow-hidden w-full aspect-[16/9] bg-[#0a0b0d] shadow-2xl">
          <video class="w-full h-full object-cover" autoplay muted loop playsinline poster="/og-default.jpg">
            <source src="/videos/accueil-demo.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-[96px] px-5 md:px-[60px]">
    <div class="max-w-[1320px] mx-auto flex flex-col md:flex-row gap-12 md:gap-[120px] items-center">
      <div class="w-full md:flex-1 flex flex-col gap-[40px] items-start">
        <div>
          <h2 class="text-[36px] md:text-[48px] font-bold text-[#0a0b0d] leading-normal">{t('home.regie.title')}</h2>
          <p class="text-[#4a5565] text-[18px] leading-[28px] mt-5">{t('home.regie.text')}</p>
        </div>
        <Button href="/nl/oplossing/" variant="black" arrow>{t('home.regie.cta')}</Button>
      </div>
      <div class="w-full md:w-[550px] md:h-[550px] flex-shrink-0">
        <Image src={imageTelephoneImg} alt="MADXP afstandsbediening-app op smartphone om het scherm in de sporthal aan te sturen" class="w-full h-full rounded-[20px] object-cover" loading="lazy" widths={[600, 1200]} sizes="(max-width: 768px) 100vw, 550px" />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-[96px] px-5 md:px-[60px]">
    <div class="max-w-[1320px] mx-auto flex flex-col md:flex-row gap-12 md:gap-[120px] items-center">
      <div class="relative w-full md:w-[550px] md:h-[550px] flex-shrink-0 rounded-[20px] overflow-hidden">
        <img src="/images/image_offre.jpg" alt="MADXP digitale signage-aanbod voor amateurclubs" class="w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="w-full md:flex-1 flex flex-col gap-[40px] items-start">
        <div>
          <h2 class="text-[36px] md:text-[48px] font-bold text-[#0a0b0d] leading-normal">{t('home.offres.title')}</h2>
          <p class="text-[#4a5565] text-[18px] leading-[28px] mt-5">{t('home.offres.text')}</p>
        </div>
        <Button href="/nl/aanbod/" variant="black" arrow>{t('home.offres.cta')}</Button>
      </div>
    </div>
  </section>

  <ClubCarousel clubs={clubs} title={t('clubs.title')} client:visible />

  <div id="contact"><ContactForm locale="nl" client:visible /></div>
</BaseLayout>
