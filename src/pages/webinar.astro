    </footer>

    <script is:inline>
      // Sticky CTA mobile : visible après scroll, masqué quand le formulaire est visible
      const stickyCta = document.getElementById('sticky-cta');
      const formSection = document.getElementById('webinar-form');
      let formInView = false;
      const formObserver = new IntersectionObserver(
        ([entry]) => { formInView = entry.isIntersecting; updateSticky(); },
        { threshold: 0.1 }
      );
      formObserver.observe(formSection);
      function updateSticky() {
        const scrolled = window.scrollY > 500;
        if (scrolled && !formInView) {
          stickyCta.classList.remove('translate-y-full');
        } else {
          stickyCta.classList.add('translate-y-full');
        }
      }
      window.addEventListener('scroll', updateSticky, { passive: true });

      const form = document.getElementById('webinar-registration-form');
      const submitBtn = document.getElementById('submit-btn');
      const formError = document.getElementById('form-error');
      const formConfirmation = document.getElementById('form-confirmation');

      const WEBHOOK_URL = 'https://n8n.srv1531715.hstgr.cloud/webhook/webinar-inscription';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        formError.classList.add('hidden');

        // Honeypot check
        if (form.website.value) return;

        const data = {
          prenom: form.prenom.value.trim(),
          email: form.email.value.trim().toLowerCase(),
          telephone: form.telephone.value.trim(),
          club: form.club.value.trim(),
          sport: form.sport.value,
          a_ecran: form.a_ecran.value,
        };

        // Basic validation — only prenom + email required
        if (!data.prenom || !data.email) {
          formError.textContent = 'Merci d\'indiquer votre prénom et votre email.';
          formError.classList.remove('hidden');
          return;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(data.email)) {
          formError.textContent = 'Veuillez entrer un email valide.';
          formError.classList.remove('hidden');
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Inscription en cours...';

        try {
          const res = await fetch(WEBHOOK_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          if (res.ok) {
            form.classList.add('hidden');
            formConfirmation.classList.remove('hidden');

            // Analytics event
            if (typeof gtag === 'function') {
              gtag('event', 'webinar_signup', { event_category: 'webinar' });
            }
          } else {
            formError.textContent = 'Une erreur est survenue. Veuillez réessayer.';
            formError.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Je m\'inscris gratuitement';
          }
        } catch (err) {
          formError.textContent = 'Erreur réseau. Vérifiez votre connexion et réessayez.';
          formError.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Je m\'inscris gratuitement';
        }
      });
    </script>
