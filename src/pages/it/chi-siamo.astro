---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { useTranslations } from '@/i18n/utils';

// FR data (C-MVP)
import { aboutParagraphs } from '@/data/equipe';

const locale = 'it';
const t = useTranslations(locale);
---

<BaseLayout title={t('about.title')} description={t('about.description')} locale={locale}>
  <!-- Hero AMBITION -->
  <section class="bg-madxp-night">
    <div class="flex flex-col lg:flex-row gap-[40px] lg:gap-[60px] items-start px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
      <!-- Left: AMBIZIONE + text -->
      <div class="flex flex-col gap-[60px] items-start">
        <div class="relative">
          <div
            class="text-[48px] md:text-[80px] lg:text-[138px] font-[900] leading-[1] text-[#093a60] select-none"
            aria-hidden="true"
          >
            <p>AMBIZIONE</p>
            <p>AMBIZIONE</p>
            <p>AMBIZI</p>
            <p>AMBIZIONE</p>
            <p>AMBIZIONE</p>
          </div>
          <h1 class="absolute left-[60%] top-[96px] md:top-[160px] lg:top-[280px] text-[28px] md:text-[40px] lg:text-[60px] leading-[1.1] whitespace-nowrap">
            <span class="font-display text-white">Mostra la<br />tua</span>
          </h1>
        </div>

        <!-- Text block -->
        <div class="max-w-[712px]">
          <h2 class="text-white text-[48px] font-bold mb-[20px]">Chi siamo?</h2>
          <p class="text-white/80 text-[18px] mb-[20px]">
            Portiamo la professionalità del grande sport nei club dilettantistici — schermi, app telecomando e contenuti video chiavi in mano.
          </p>
          <div class="text-white text-[18px] space-y-4 prose prose-invert prose-p:my-2 prose-ul:my-2 prose-li:my-0 max-w-none">
            {aboutParagraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <div class="mt-[30px]"><Button href="/it/soluzione/" variant="white" arrow>Scopri la soluzione</Button></div>
        </div>
      </div>

      <!-- Right: carte « MadXP en bref » (sticky, sans photo) -->
      <div class="pt-[30px] lg:pt-[60px] lg:self-stretch">
        <div class="w-full max-w-[548px] lg:sticky lg:top-[120px]">
          <div class="rounded-[20px] bg-madxp-blue text-madxp-bone p-8 md:p-10 lg:aspect-[548/685] flex flex-col justify-between gap-10">
            <p class="font-mono text-[12px] tracking-[0.2em] uppercase text-madxp-bone/70">MadXP in breve</p>
            <div class="flex flex-col gap-8">
              <div>
                <p class="font-display text-[56px] md:text-[72px] leading-none">3</p>
                <p class="font-mono text-[13px] tracking-[0.16em] uppercase text-madxp-bone/80 mt-2">fonti di ricavo attivate</p>
              </div>
              <div>
                <p class="font-display text-[56px] md:text-[72px] leading-none">79 €<span class="text-[24px] align-top">/m</span></p>
                <p class="font-mono text-[13px] tracking-[0.16em] uppercase text-madxp-bone/80 mt-2">finanziabile dai vostri sponsor</p>
              </div>
              <div>
                <p class="font-display text-[56px] md:text-[72px] leading-none">Europa</p>
                <p class="font-mono text-[13px] tracking-[0.16em] uppercase text-madxp-bone/80 mt-2">club seguiti ovunque</p>
              </div>
            </div>
            <p class="font-mono text-[12px] tracking-[0.18em] uppercase text-madxp-bone/60">by Kalon Partners</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div id="contact"><ContactForm locale="it" client:visible /></div>
</BaseLayout>
