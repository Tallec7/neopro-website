---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.tsx';
import OfferCard from '@/components/mock/OfferCard.astro';
import { useTranslations } from '@/i18n/utils';

import { solutionPanels, steps } from '@/data/solution';

const formatPanelTitle = (title: string) => {
  const spaceIdx = title.indexOf(' ');
  if (spaceIdx === -1) return `<span class="font-bold">${title}</span>`;
  const first = title.substring(0, spaceIdx);
  const rest = title.substring(spaceIdx + 1);
  return `<span class="font-display font-normal">${first}</span> <span class="font-black">${rest}</span>`;
};

const locale = 'pt';
const t = useTranslations(locale);
---

<BaseLayout title={t('solution.title')} description={t('solution.description')} locale={locale}>
  <!-- Hero — typo + couleur, sans photo -->
  <section class="relative bg-madxp-night text-madxp-bone overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-[8%] top-0 h-full w-[50%] bg-madxp-blue/25 [clip-path:polygon(30%_0,100%_0,100%_100%,0_100%)]"></div>
      <div class="absolute -right-[2%] top-0 h-full w-[38%] bg-madxp-blue/30 [clip-path:polygon(36%_0,100%_0,100%_100%,0_100%)]"></div>
      <span class="absolute right-[3%] bottom-[-6%] font-display text-[30vw] leading-none text-madxp-bone/[0.04] select-none">MX</span>
    </div>
    <div class="relative z-10 max-w-[1320px] mx-auto px-[20px] md:px-[40px] lg:px-[60px] pt-28 md:pt-[170px] pb-[60px] md:pb-[110px]">
      <p class="font-mono uppercase tracking-[0.22em] text-[12px] md:text-[15px] text-madxp-light mb-6">{t('solution.hero.label')}</p>
      <h1 class="font-display uppercase leading-[0.9] text-[44px] md:text-[84px] max-w-[14ch]">
        <span>{t('solution.hero.line1')}</span> <span class="text-madxp-light">{t('solution.hero.line2')}</span>
      </h1>
      <p class="mt-6 text-[18px] md:text-[22px] text-madxp-bone/80 max-w-[620px]">
        Uma solução digital chave na mão para clubes desportivos — do nível profissional à competição regional.
      </p>
      <div class="mt-9"><Button href="#contact" variant="white" arrow>{t('solution.hero.cta')}</Button></div>
    </div>
  </section>

  <!-- Panneaux solution sticky -->
  <section class="pb-[60px] md:pb-[100px] pt-[40px] px-[20px] md:px-[40px] lg:px-[60px]">
    <div class="max-w-[1200px] mx-auto">
      <p class="text-[16px] font-bold opacity-60 tracking-[2px] uppercase mb-[30px]">PARA QUE SERVE?</p>
      {solutionPanels.map((panel, i) => (
        <div class="sticky top-[120px] bg-white rounded-[20px] shadow-lg overflow-hidden mb-8" style={`z-index: ${10 + i}`}>
          <div class="flex flex-col md:flex-row gap-[60px] py-[60px] md:py-[120px] px-[30px] md:px-[60px]">
            <div class="flex-1 flex flex-col justify-center gap-[30px]">
              <h2 class="text-[28px] md:text-[36px] lg:text-[48px]" set:html={formatPanelTitle(panel.title)} />
              <p class="text-madxp-gray text-[18px]">{panel.description}</p>
            </div>
            <!-- Maquette « écran gymnase » CSS (sans vidéo) -->
            <div class="flex-1 relative rounded-[20px] overflow-hidden bg-madxp-ink aspect-video flex items-center justify-center p-8">
              <div class="pointer-events-none absolute -right-[12%] top-0 h-full w-[46%] bg-madxp-blue/25 [clip-path:polygon(38%_0,100%_0,100%_100%,0_100%)]"></div>
              <span class="absolute top-4 left-5 font-mono text-[11px] tracking-[0.2em] text-madxp-bone/50 uppercase">MadXP · écran gymnase</span>
              <span class="absolute top-4 right-5 inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] text-madxp-bone/80 uppercase"><span class="w-1.5 h-1.5 rounded-full bg-madxp-red animate-pulse"></span> Live</span>
              <p class="relative font-display uppercase text-[32px] md:text-[52px] leading-[0.95] text-center text-madxp-bone max-w-[85%]" set:html={formatPanelTitle(panel.title)} />
              <span class="absolute bottom-4 left-5 right-5 flex gap-2">
                <span class="flex-1 h-5 rounded bg-madxp-bone/12"></span>
                <span class="flex-1 h-5 rounded bg-madxp-bone/12"></span>
                <span class="flex-1 h-5 rounded bg-madxp-bone/12"></span>
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="px-[20px] md:px-[40px] lg:px-[60px] pb-[60px] md:pb-[120px] pt-[60px] md:pt-[100px]">
    <div class="max-w-[1200px] mx-auto">
      <p class="text-[16px] font-bold opacity-60 tracking-[2px] uppercase mb-[40px]">COMO FUNCIONA?</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
        {steps.map((step) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] md:p-[40px] flex flex-col items-center text-center gap-[20px]">
            <span class="text-[64px] md:text-[80px] font-black text-[#0a0b0d] leading-none">{step.number}</span>
            <h3 class="text-[20px] md:text-[24px] font-bold">{step.title}</h3>
            <p class="text-[16px] text-[#4a5565]">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[1200px] mx-auto">
      <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-[120px]">
        <!-- Carte offre CSS (sans photo) -->
        <div class="w-full lg:w-[550px] flex-shrink-0">
          <OfferCard
            square
            fromLabel="A partir de"
            price="79"
            period="/ mês"
            note="Financiável pelos seus parceiros. Sem compromisso longo."
            features={['Ecrã + software de régie', 'Aplicação-controlo remoto', 'Conteúdos vídeo e patrocinadores', 'Instalação chave na mão']}
          />
        </div>
        <div class="flex-1 flex flex-col gap-[20px] items-start">
          <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#0a0b0d]">Ofertas adaptadas às suas necessidades</h2>
          <p class="text-[18px] text-[#4a5565]">Financiadas pelos seus patrocinadores. Chave na mão.</p>
          <div class="mt-[20px]"><Button href="/pt/ofertas/" variant="black" arrow>Ver as ofertas</Button></div>
        </div>
      </div>
    </div>
  </section>

  <div id="contact"><ContactForm locale="pt" client:visible /></div>
</BaseLayout>
