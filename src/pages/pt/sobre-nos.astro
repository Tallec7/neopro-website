---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { Image } from 'astro:assets';
import { useTranslations } from '@/i18n/utils';

import quiSommesNousImg from '@/assets/images/qui-sommes-nous.webp';
import { aboutParagraphs } from '@/data/equipe';

const locale = 'pt';
const t = useTranslations(locale);
---

<BaseLayout title={t('about.title')} description={t('about.description')} locale={locale}>
  <section class="relative h-[500px] md:h-[600px] overflow-hidden">
    <Image src={quiSommesNousImg} alt="A equipa MADXP" class="absolute inset-0 w-full h-full object-cover" loading="eager" widths={[640, 1024, 1440, 1920]} sizes="100vw" />
    <div class="absolute inset-0 bg-[rgba(6,38,63,0.55)]"></div>
    <div class="relative z-10 h-full flex flex-col justify-end px-[20px] md:px-[40px] lg:px-[60px] pb-[60px] md:pb-[80px]">
      <p class="text-[16px] tracking-[2px] text-[#d9d9d9] uppercase mb-[20px]">SOBRE NÓS</p>
      <h1 class="text-[36px] md:text-[50px] lg:text-[70px] leading-[1.1] text-white mb-[20px]">
        <span class="font-display">MADXP, </span><br />
        <span class="font-black">a régie desportiva digital para clubes.</span>
      </h1>
      <p class="text-white/80 text-[16px] md:text-[18px] max-w-[720px]">
        Trazemos a profissionalidade do desporto de topo aos clubes amadores — ecrãs, aplicação-controlo remoto e conteúdos vídeo chave na mão.
      </p>
    </div>
  </section>

  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[900px] mx-auto flex flex-col gap-[24px]">
      {aboutParagraphs.map((p) => (
        <p class="text-[18px] text-[#4a5565] leading-[1.7]">{p}</p>
      ))}
      <div class="mt-[20px]"><Button href="/pt/solucao/" variant="black" arrow>Descubra a solução</Button></div>
    </div>
  </section>

  <div id="contact"><ContactForm locale="pt" client:visible /></div>
</BaseLayout>
