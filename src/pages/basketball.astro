---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.tsx';
import {
  buildBreadcrumbJsonLd,
  buildFAQPageJsonLd,
  buildServiceJsonLd,
} from '@/lib/jsonLd';

// ── SEO ──────────────────────────────────────────────────────────
const title = 'Régie sport basketball — Écrans & affichage digital pour clubs | Neopro';
const description = "Solution de régie sport digitale pour clubs de basketball : écran LED en salle, score et chrono, spots sponsors animés. Du club pro au régional. Dès 79 €/mois.";

const siteUrl = 'https://www.neopro-communication.fr';
const canonicalUrl = `${siteUrl}/basketball`;

const breadcrumb = buildBreadcrumbJsonLd([
  { name: 'Accueil', url: siteUrl },
  { name: 'Basketball', url: canonicalUrl },
]);

const service = buildServiceJsonLd({
  name: 'Régie sport digitale basketball — Neopro',
  description:
    "Solution de régie sport digitale pour clubs de basketball : écran LED en salle, scoring digital avec chrono, spots sponsors animés, animations quart-temps, pilotage depuis un smartphone. Du club pro au régional.",
  url: canonicalUrl,
  providerName: 'Neopro',
  providerUrl: siteUrl,
  areaServed: ['France', 'Belgique', 'Suisse'],
  serviceType: 'Régie sport digitale basketball',
});

const faq = buildFAQPageJsonLd([
  {
    question: "Neopro peut-il gérer le chronomètre et le score pendant un match de basketball ?",
    answer:
      "Oui. L'appli télécommande Neopro permet de mettre à jour le score en un tap pendant le match. Le score et le quart-temps en cours s'affichent sur l'écran LED entre les séquences sponsors. Un seul bénévole suffit pour piloter l'ensemble depuis son smartphone.",
  },
  {
    question: "Comment exploiter les temps-morts et les quart-temps pour les sponsors ?",
    answer:
      "Le basketball est le sport idéal pour la valorisation sponsors : 4 quart-temps (donc 3 pauses), des temps-morts réguliers et les lancers francs créent de nombreux moments de visibilité. L'appli Neopro lance automatiquement les spots sponsors dès qu'une pause débute.",
  },
  {
    question: "La solution fonctionne-t-elle dans un gymnase sans wifi ?",
    answer:
      "Oui. Le boîtier Neopro crée son propre réseau wifi local, totalement indépendant d'internet. Votre smartphone s'y connecte directement. C'est la solution idéale pour les salles municipales et les gymnases sans infrastructure réseau.",
  },
  {
    question: "Neopro est-il adapté aux clubs de basketball régionaux et départementaux ?",
    answer:
      "Absolument. Neopro est conçu pour tous les niveaux, du club professionnel au championnat départemental. L'offre Play à 79 €/mois permet aux plus petits clubs de démarrer, et les formules Club, Pro et Premium s'adaptent aux ambitions de chaque structure.",
  },
]);

const features = [
  {
    icon: '🏀',
    title: 'Scoring digital avec quart-temps',
    description:
      "Score, quart-temps en cours et fautes d'équipe affichés sur l'écran LED. Mise à jour en un tap depuis l'appli — un seul bénévole suffit.",
  },
  {
    icon: '📺',
    title: 'Spots sponsors animés',
    description:
      "Diffusez les vidéos et logos de vos partenaires en rotation pendant les pauses entre quart-temps, les temps-morts et l'avant-match.",
  },
  {
    icon: '🎬',
    title: 'Animations entre quart-temps',
    description:
      "Remplissez les pauses avec des contenus engageants façon NBA : jeux pour le public, cam supporters, présentation sponsors, stats du match.",
  },
  {
    icon: '📣',
    title: 'Présentation des joueurs',
    description:
      "Affichez les cinq majeurs, les entrées en jeu et les remplacements. Templates personnalisés aux couleurs de votre club pour une ambiance pro.",
  },
  {
    icon: '📊',
    title: 'Reporting sponsors automatique',
    description:
      "Prouvez le ROI à vos partenaires : nombre de diffusions, durée d'exposition, audience estimée. De quoi renouveler et augmenter vos contrats.",
  },
  {
    icon: '📡',
    title: 'Fonctionne sans wifi',
    description:
      "Le boîtier Neopro crée son propre réseau local dans la salle. Aucune connexion internet requise — parfait pour les gymnases municipaux.",
  },
];

const avantages = [
  {
    title: '4 quart-temps = 3 pauses sponsors',
    description:
      "Chaque pause entre les quart-temps est un créneau premium pour diffuser des spots sponsors. Avec la mi-temps longue de 15 minutes, c'est le sport qui offre le plus de créneaux de visibilité.",
  },
  {
    title: 'Culture NBA = spectateurs qui attendent du show',
    description:
      "Le public basketball est habitué au spectacle façon NBA. Un écran LED avec des animations et des spots sponsors répond à cette attente et professionnalise l'expérience match dans votre salle.",
  },
  {
    title: 'Lancers francs et temps-morts = moments de visibilité',
    description:
      "Les lancers francs, les temps-morts (5 par équipe en compétition) et les remplacements sont autant de moments où l'attention du public se porte naturellement vers l'écran.",
  },
  {
    title: 'Sport en plein essor post-JO 2024',
    description:
      "L'effet Jeux Olympiques 2024 a dopé les licenciés et le public du basketball en France. C'est le moment idéal pour professionnaliser l'expérience match et attirer de nouveaux sponsors.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  extraJsonLd={[breadcrumb, service, faq]}
  noAlternates
>
  <!-- Hero -->
  <section class="relative bg-[#101828] text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#101828] via-[#101828] to-[#1a2332]"></div>
    <div class="relative max-w-[1200px] mx-auto px-[20px] md:px-[40px] lg:px-[60px] py-[100px] md:py-[140px]">
      <p class="text-[14px] md:text-[16px] tracking-[2px] text-[#81e3bc] uppercase font-bold mb-[20px]">
        Régie sport basketball
      </p>
      <h1 class="text-[36px] md:text-[56px] lg:text-[72px] leading-[1.05] font-black mb-[30px] max-w-[960px]">
        <span class="font-playfair italic font-normal">La régie digitale</span> pensée<br />
        pour le <span class="text-[#81e3bc]">basketball</span>.
      </h1>
      <p class="text-[18px] md:text-[22px] text-white/80 max-w-[760px] leading-relaxed mb-[40px]">
        Écran LED en salle, score et quart-temps en temps réel, spots sponsors
        pendant les pauses et les temps-morts, ambiance NBA dans votre gymnase.
        Tout pour professionnaliser vos matchs et valoriser vos partenaires — dès 79&nbsp;€/mois.
      </p>
      <div class="flex flex-wrap gap-[16px]">
        <Button href="/demo" variant="green" arrow>Demander une démo</Button>
        <Button href="/solution" variant="white" arrow>Découvrir la solution</Button>
      </div>
    </div>
  </section>

  <!-- Pourquoi le basketball est idéal -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
          Le match parfait
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] leading-[1.1]">
          Pourquoi le <span class="font-playfair italic">basketball</span> est idéal pour la régie digitale
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[24px]">
        {avantages.map((item) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] border border-gray-200">
            <h3 class="text-[22px] font-bold text-[#101828] mb-[14px]">{item.title}</h3>
            <p class="text-[16px] text-[#4a5565] leading-[1.6]">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ce que Neopro apporte -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
          Ce que Neopro apporte à votre club
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] leading-[1.1]">
          <span class="font-playfair italic">6 fonctionnalités</span> conçues pour le basketball.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]">
        {features.map((feat) => (
          <div class="bg-white rounded-[20px] p-[30px] border border-gray-200 hover:border-neo-green-dark transition-colors">
            <span class="text-[32px] mb-[16px] block">{feat.icon}</span>
            <h3 class="text-[22px] font-bold text-[#101828] mb-[14px]">{feat.title}</h3>
            <p class="text-[16px] text-[#4a5565] leading-[1.6]">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cas concret -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
        Cas concret
      </p>
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[40px]">
        <span class="font-playfair italic">Avant / Après</span> — un club de NM2&nbsp;basketball
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[40px]">
        <div class="bg-[#fef2f2] rounded-[20px] p-[30px]">
          <h3 class="text-[20px] font-bold text-[#101828] mb-[20px]">Avant Neopro</h3>
          <ul class="space-y-[12px] text-[16px] text-[#4a5565] leading-[1.6]">
            <li>Score sur tableau manuel, visible seulement d'un côté de la salle</li>
            <li>Pauses entre quart-temps vides, public sur son téléphone</li>
            <li>Bâches sponsors statiques dans un coin du gymnase</li>
            <li>Aucune donnée d'exposition pour les partenaires</li>
            <li>Ambiance loin du spectacle attendu par le public basket</li>
          </ul>
        </div>
        <div class="bg-[#f0fdf4] rounded-[20px] p-[30px]">
          <h3 class="text-[20px] font-bold text-[#101828] mb-[20px]">Avec Neopro</h3>
          <ul class="space-y-[12px] text-[16px] text-[#4a5565] leading-[1.6]">
            <li>Score digital visible de partout, mis à jour en temps réel</li>
            <li>Pauses animées façon NBA : spots, jeux, contenus club</li>
            <li>Spots vidéo sponsors en rotation sur écran LED</li>
            <li>Reporting automatique envoyé aux partenaires</li>
            <li>Ambiance spectacle qui attire et fidélise le public</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Les offres -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#101828] text-white">
    <div class="max-w-[900px] mx-auto text-center">
      <h2 class="text-[32px] md:text-[48px] font-bold mb-[20px]">
        <span class="font-playfair italic font-normal">Les offres</span> pour votre club de basketball
      </h2>
      <p class="text-[18px] text-white/70 max-w-[600px] mx-auto mb-[40px] leading-relaxed">
        Quatre formules adaptées à votre niveau et à vos ambitions — de 79&nbsp;€/mois
        à 299&nbsp;€/mois. Toutes finançables par vos sponsors.
      </p>
      <div class="flex flex-wrap justify-center gap-[16px]">
        <Button href="/offres" variant="green" arrow>Voir les offres</Button>
        <Button href="/demo" variant="white" arrow>Demander une démo</Button>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[800px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[40px]">
        <span class="font-playfair italic">Questions fréquentes</span> — basketball
      </h2>
      <div class="space-y-[16px]">
        <details class="bg-white rounded-[16px] border border-gray-200 p-[24px] group">
          <summary class="text-[18px] font-bold text-[#101828] cursor-pointer list-none flex justify-between items-center">
            Neopro peut-il gérer le chronomètre et le score pendant un match de basketball ?
            <span class="text-[#81e3bc] text-[24px] group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-[16px] text-[16px] text-[#4a5565] leading-[1.6]">
            Oui. L'appli télécommande Neopro permet de mettre à jour le score en un tap.
            Le score et le quart-temps en cours s'affichent sur l'écran LED entre les
            séquences sponsors. Un seul bénévole suffit pour piloter l'ensemble.
          </p>
        </details>
        <details class="bg-white rounded-[16px] border border-gray-200 p-[24px] group">
          <summary class="text-[18px] font-bold text-[#101828] cursor-pointer list-none flex justify-between items-center">
            Comment exploiter les temps-morts et les quart-temps pour les sponsors ?
            <span class="text-[#81e3bc] text-[24px] group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-[16px] text-[16px] text-[#4a5565] leading-[1.6]">
            Le basketball offre de nombreux créneaux : 3 pauses entre quart-temps,
            une mi-temps de 15 minutes, des temps-morts réguliers et les lancers francs.
            L'appli Neopro lance automatiquement les spots dès qu'une pause débute.
          </p>
        </details>
        <details class="bg-white rounded-[16px] border border-gray-200 p-[24px] group">
          <summary class="text-[18px] font-bold text-[#101828] cursor-pointer list-none flex justify-between items-center">
            La solution fonctionne-t-elle dans un gymnase sans wifi ?
            <span class="text-[#81e3bc] text-[24px] group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-[16px] text-[16px] text-[#4a5565] leading-[1.6]">
            Oui. Le boîtier Neopro crée son propre réseau wifi local, totalement
            indépendant d'internet. Votre smartphone s'y connecte directement.
            Idéal pour les salles municipales sans infrastructure réseau.
          </p>
        </details>
        <details class="bg-white rounded-[16px] border border-gray-200 p-[24px] group">
          <summary class="text-[18px] font-bold text-[#101828] cursor-pointer list-none flex justify-between items-center">
            Neopro est-il adapté aux clubs de basketball régionaux et départementaux ?
            <span class="text-[#81e3bc] text-[24px] group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-[16px] text-[16px] text-[#4a5565] leading-[1.6]">
            Absolument. Neopro est conçu pour tous les niveaux, du club professionnel
            au championnat départemental. L'offre Play à 79 €/mois permet aux plus
            petits clubs de démarrer, et les formules supérieures s'adaptent à vos ambitions.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Liens internes SEO -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[40px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <p class="text-[14px] text-[#4a5565] leading-[1.8]">
        En savoir plus :
        <a href="/solution" class="text-neo-green-dark underline">La solution Neopro</a> ·
        <a href="/offres" class="text-neo-green-dark underline">Nos offres</a> ·
        <a href="/annonceurs" class="text-neo-green-dark underline">Annonceurs</a> ·
        <a href="/blog/experience-match-day-clubs-sport" class="text-neo-green-dark underline">Expérience match day</a> ·
        <a href="/blog/regie-sport-guide-complet" class="text-neo-green-dark underline">Guide complet régie sport</a> ·
        <a href="/implantations" class="text-neo-green-dark underline">Nos implantations</a>
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[700px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[16px] text-center">
        <span class="font-playfair italic font-normal">Contactez-nous</span>
      </h2>
      <p class="text-[18px] text-[#4a5565] text-center mb-[40px]">
        Une question sur la régie sport pour votre club de basketball ?
        Remplissez le formulaire, on vous répond sous 24h.
      </p>
      <ContactForm client:visible />
    </div>
  </section>
</BaseLayout>
