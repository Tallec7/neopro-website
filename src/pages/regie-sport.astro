---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { useTranslations, localeRoutePath, localePath } from '@/i18n/utils';
import {
  buildBreadcrumbJsonLd,
  buildFAQPageJsonLd,
  buildServiceJsonLd,
} from '@/lib/jsonLd';

const locale = 'fr';
const t = useTranslations(locale);

const siteUrl = 'https://madxp.kalonpartners.bzh';
const canonicalUrl = `${siteUrl}/regie-sport`;

const breadcrumb = buildBreadcrumbJsonLd([
  { name: 'Accueil', url: siteUrl },
  { name: t('nav.regie'), url: canonicalUrl },
]);

const service = buildServiceJsonLd({
  name: t('regie.title'),
  description: t('regie.description'),
  url: canonicalUrl,
  providerName: 'MADXP',
  providerUrl: siteUrl,
  areaServed: ['France', 'Belgique', 'Suisse'],
  serviceType: t('regie.hero.tag'),
});

const faq = buildFAQPageJsonLd([
  { question: t('regie.faq.q1'), answer: t('regie.faq.a1') },
  { question: t('regie.faq.q2'), answer: t('regie.faq.a2') },
  { question: t('regie.faq.q3'), answer: t('regie.faq.a3') },
  { question: t('regie.faq.q4'), answer: t('regie.faq.a4') },
  { question: t('regie.faq.q5'), answer: t('regie.faq.a5') },
]);

const features = [
  { title: t('regie.feat1.title'), description: t('regie.feat1.desc') },
  { title: t('regie.feat2.title'), description: t('regie.feat2.desc') },
  { title: t('regie.feat3.title'), description: t('regie.feat3.desc') },
  { title: t('regie.feat4.title'), description: t('regie.feat4.desc') },
  { title: t('regie.feat5.title'), description: t('regie.feat5.desc') },
  { title: t('regie.feat6.title'), description: t('regie.feat6.desc') },
];

const niveaux = [
  { label: t('regie.who1.title'), description: t('regie.who1.desc') },
  { label: t('regie.who2.title'), description: t('regie.who2.desc') },
  { label: t('regie.who3.title'), description: t('regie.who3.desc') },
];
---

<BaseLayout
  title={t('regie.title')}
  description={t('regie.description')}
  canonicalUrl={canonicalUrl}
  extraJsonLd={[breadcrumb, service, faq]}
>
  <!-- Hero -->
  <section class="relative bg-[#06263f] text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#06263f] via-[#06263f] to-[#06263f]"></div>
    <div class="relative max-w-[1200px] mx-auto px-[20px] md:px-[40px] lg:px-[60px] py-[100px] md:py-[140px]">
      <p class="text-[14px] md:text-[16px] tracking-[2px] text-[#0e578e] uppercase font-bold mb-[20px]">
        {t('regie.hero.tag')}
      </p>
      <h1 class="text-[36px] md:text-[56px] lg:text-[72px] leading-[1.05] font-black mb-[30px] max-w-[960px]">
        <span class="font-display font-normal">{t('regie.hero.h1a')}</span>{t('regie.hero.h1b')}<br />
        {t('regie.hero.h1c')}<span class="text-[#0e578e]">{t('regie.hero.h1d')}</span>{t('regie.hero.h1e')}
      </h1>
      <p class="text-[18px] md:text-[22px] text-white/80 max-w-[760px] leading-relaxed mb-[40px]">
        {t('regie.hero.sub')}
      </p>
      <div class="flex flex-wrap gap-[16px]">
        <Button href={localeRoutePath('/devis', locale)} variant="green" arrow>{t('regie.hero.cta1')}</Button>
        <Button href={localePath('/solution', locale)} variant="white" arrow>{t('regie.hero.cta2')}</Button>
      </div>
    </div>
  </section>

  <!-- What is -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] mb-[30px]">
        <span class="font-display">{t('regie.what.h2a')}</span>{t('regie.what.h2b')}
      </h2>
      <div class="prose prose-lg max-w-none text-[#4a5565] text-[18px] leading-[1.7]">
        <p>{t('regie.what.p1')}</p>
        <p>{t('regie.what.p2')}</p>
        <p>{t('regie.what.p3')}</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[16px]">
          {t('regie.features.tag')}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] leading-[1.1]">
          <span class="font-display">{t('regie.features.h2a')}</span>{t('regie.features.h2b')}
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]">
        {features.map((feat) => (
          <div class="bg-white rounded-[20px] p-[30px] border border-gray-200 hover:border-madxp-blue-deep transition-colors">
            <h3 class="text-[22px] font-bold text-[#0a0b0d] mb-[14px]">{feat.title}</h3>
            <p class="text-[16px] text-madxp-gray leading-[1.6]">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For whom -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[16px]">
          {t('regie.who.tag')}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] leading-[1.1]">
          <span class="font-display">{t('regie.who.h2a')}</span>{t('regie.who.h2b')}
        </h2>
        <p class="text-[18px] text-madxp-gray mt-[20px]">
          {t('regie.who.sub')}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
        {niveaux.map((niveau) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] md:p-[40px]">
            <h3 class="text-[24px] font-bold text-[#0a0b0d] mb-[16px]">{niveau.label}</h3>
            <p class="text-[16px] text-madxp-gray leading-[1.6]">{niveau.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#06263f] text-white">
    <div class="max-w-[900px] mx-auto text-center">
      <h2 class="text-[32px] md:text-[48px] font-bold mb-[20px] leading-[1.1]">
        <span class="font-display font-normal">{t('regie.cta.h2a')}</span><br />
        <span class="font-black">{t('regie.cta.h2b')}</span>
      </h2>
      <p class="text-[18px] text-white/70 max-w-[640px] mx-auto mb-[40px]">
        {t('regie.cta.sub')}
      </p>
      <div class="flex flex-wrap gap-[16px] justify-center">
        <Button href={localeRoutePath('/offres', locale)} variant="green" arrow>{t('regie.cta.btn1')}</Button>
        <Button href={localeRoutePath('/devis', locale)} variant="white" arrow>{t('regie.cta.btn2')}</Button>
      </div>
    </div>
  </section>

  <!-- Paliers du réseau -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[1100px] mx-auto">
      <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[16px]">
        Les paliers du réseau
      </p>
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] leading-[1.1] mb-[20px]">
        Un <span class="font-display font-normal">réseau</span> qui se construit club par club.
      </h2>
      <p class="text-[18px] text-[#4a5565] leading-relaxed max-w-[780px] mb-[50px]">
        La régie MADXP devient plus puissante à chaque palier. Dès 20 clubs un micro-réseau local est activable pour vos sponsors de proximité — à 500 clubs c'est un réseau national France. Voici la trajectoire.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[16px]">
        <div class="bg-madxp-blue/20 border-2 border-madxp-blue-deep rounded-[20px] p-[24px]">
          <p class="text-[12px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[8px]">Palier 1 · Actif</p>
          <p class="text-[40px] font-black leading-none mb-[12px] text-[#0a0b0d]">20<span class="text-[20px] text-[#4a5565]"> clubs</span></p>
          <h3 class="text-[18px] font-bold mb-[8px] text-[#0a0b0d]">Micro-réseau local</h3>
          <p class="text-[14px] text-[#4a5565] leading-[1.6]">Sponsors locaux (commerces, artisans, enseignes régionales) activables dès maintenant. Idéal pour couvrir un bassin de vie.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-[20px] p-[24px]">
          <p class="text-[12px] tracking-[2px] text-[#4a5565] uppercase font-bold mb-[8px]">Palier 2</p>
          <p class="text-[40px] font-black leading-none mb-[12px] text-[#0a0b0d]">50<span class="text-[20px] text-[#4a5565]"> clubs</span></p>
          <h3 class="text-[18px] font-bold mb-[8px] text-[#0a0b0d]">Réseau Pioneer</h3>
          <p class="text-[14px] text-[#4a5565] leading-[1.6]">Premier inventaire multi-clubs commercialisable. Annonceurs régionaux. Reporting consolidé.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-[20px] p-[24px]">
          <p class="text-[12px] tracking-[2px] text-[#4a5565] uppercase font-bold mb-[8px]">Palier 3</p>
          <p class="text-[40px] font-black leading-none mb-[12px] text-[#0a0b0d]">200<span class="text-[20px] text-[#4a5565]"> clubs</span></p>
          <h3 class="text-[18px] font-bold mb-[8px] text-[#0a0b0d]">Réseau régional</h3>
          <p class="text-[14px] text-[#4a5565] leading-[1.6]">Première offre vendable à des annonceurs nationaux ciblant une zone (Grand Ouest, IDF…).</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-[20px] p-[24px]">
          <p class="text-[12px] tracking-[2px] text-[#4a5565] uppercase font-bold mb-[8px]">Palier 4</p>
          <p class="text-[40px] font-black leading-none mb-[12px] text-[#0a0b0d]">500<span class="text-[20px] text-[#4a5565]"> clubs</span></p>
          <h3 class="text-[18px] font-bold mb-[8px] text-[#0a0b0d]">Réseau national France</h3>
          <p class="text-[14px] text-[#4a5565] leading-[1.6]">Taille critique pour une campagne nationale. Grandes enseignes (sport, food, retail) activables en un deal.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-[20px] p-[24px]">
          <p class="text-[12px] tracking-[2px] text-[#4a5565] uppercase font-bold mb-[8px]">Palier 5</p>
          <p class="text-[40px] font-black leading-none mb-[12px] text-[#0a0b0d]">1 500<span class="text-[20px] text-[#4a5565]"> clubs</span></p>
          <h3 class="text-[18px] font-bold mb-[8px] text-[#0a0b0d]">Programmatique &amp; premium</h3>
          <p class="text-[14px] text-[#4a5565] leading-[1.6]">Inventaire multi-sports. Intégration DSP/SSP programmatique. Offres premium par sport et créneau.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-[20px] p-[24px]">
          <p class="text-[12px] tracking-[2px] text-[#4a5565] uppercase font-bold mb-[8px]">Palier 6</p>
          <p class="text-[40px] font-black leading-none mb-[12px] text-[#0a0b0d]">5 000<span class="text-[20px] text-[#4a5565]"> clubs</span></p>
          <h3 class="text-[18px] font-bold mb-[8px] text-[#0a0b0d]">Cross-border Europe</h3>
          <p class="text-[14px] text-[#4a5565] leading-[1.6]">Réseau multi-pays (FR, DE, ES, IT, PL…). Campagnes internationales coordonnées — un inventaire DOOH sport inédit en Europe.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] mb-[40px]">
        <span class="font-display">{t('regie.faq.title.a')}</span>{t('regie.faq.title.b')}
      </h2>
      <div class="flex flex-col divide-y divide-gray-200 border-t border-b border-gray-200">
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#0a0b0d] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q1')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>{t('regie.faq.a1')}</p>
          </div>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#0a0b0d] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q2')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>{t('regie.faq.a2')}</p>
          </div>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#0a0b0d] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q3')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>{t('regie.faq.a3')}</p>
          </div>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#0a0b0d] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q4')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>{t('regie.faq.a4')}</p>
          </div>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer py-[24px] text-[18px] font-semibold text-[#0a0b0d] list-none [&::-webkit-details-marker]:hidden">
            {t('regie.faq.q5')}
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="pb-[24px] text-[16px] text-[#4a5565] leading-[1.7]">
            <p>
              {t('regie.faq.a5')}
              <a href={localeRoutePath('/offres', locale)} class="text-madxp-blue-deep font-semibold hover:underline">{t('regie.faq.link')}</a>.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <div id="contact">
    <ContactForm client:visible />
  </div>
</BaseLayout>
