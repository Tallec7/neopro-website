---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist."
  locale="en"
  noAlternates
  noIndex
>
  <section class="min-h-[70vh] flex flex-col items-center justify-center px-6 py-24 text-center">
    <p class="text-[120px] md:text-[180px] font-black text-[#f2eee6] leading-none select-none">404</p>
    <h1 class="text-[28px] md:text-[40px] font-bold text-[#0a0b0d] mt-[-20px] mb-4">
      Page not found
    </h1>
    <p class="text-[#4a5565] text-[18px] max-w-[480px] mb-10">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <Button href="/en/" variant="black" arrow>Back to home</Button>
  </section>
</BaseLayout>
