---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ClubCarousel from '@/components/ClubCarousel.tsx';
import ContactForm from '@/components/ContactForm.tsx';
import MatchScreen from '@/components/mock/MatchScreen.astro';
import RemoteMock from '@/components/mock/RemoteMock.astro';
import OfferCard from '@/components/mock/OfferCard.astro';
import { useTranslations } from '@/i18n/utils';

// ── Données ──────────────────────────────────────────────────────
import { clubs } from '@/data/clubs';

const locale = 'en';
const t = useTranslations(locale);
---

<BaseLayout title={t('home.title')} description={t('home.description')} locale={locale}>
  <!-- Hero — typo + couleur, sans photo -->
  <section class="relative bg-madxp-night text-madxp-bone overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-[8%] top-0 h-full w-[55%] bg-madxp-blue/25 [clip-path:polygon(28%_0,100%_0,100%_100%,0_100%)]"></div>
      <div class="absolute -right-[2%] top-0 h-full w-[42%] bg-madxp-blue/30 [clip-path:polygon(34%_0,100%_0,100%_100%,0_100%)]"></div>
      <span class="absolute right-[3%] bottom-[-6%] font-display text-[34vw] leading-none text-madxp-bone/[0.04] select-none">MX</span>
    </div>

    <div class="relative z-10 max-w-[1320px] mx-auto px-6 md:px-[60px] pt-28 md:pt-[180px] pb-20 md:pb-[130px]">
      <p class="font-mono uppercase tracking-[0.22em] text-[12px] md:text-[15px] text-madxp-light mb-6 md:mb-8">
        Match-Day · Ad · Experience · Media
      </p>
      <h1 class="font-display uppercase leading-[0.9] text-[44px] md:text-[92px] max-w-[16ch]">
        <span>{t('home.hero.line1')}</span>
        <br /><span class="text-madxp-light">{t('home.hero.line2')}</span>
        <br /><span>{t('home.hero.line3')}</span>
      </h1>
      <p class="mt-8 text-[18px] md:text-[24px] leading-relaxed text-madxp-bone/80 max-w-[620px]">
        We turn your screen into an interactive media. Screens, digital signage and video content for sports clubs — from professional to regional level.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 md:gap-6">
        <Button href="/en/solution/" variant="white" arrow>
          {t('home.hero.cta')}
        </Button>
      </div>
    </div>
  </section>

  <!-- Welcome to the club -->
  <section class="relative bg-[#06263f] overflow-hidden">
    <div class="flex flex-col items-center justify-center px-5 pt-16 md:pt-24">
      <h2 class="text-[#093a60] text-[48px] md:text-[128px] leading-[1] text-center mb-6 md:mb-10">
        <span class="font-display font-normal">{t('home.welcome.title1')}</span><span class="font-black">{t('home.welcome.title2')}</span>
      </h2>
      <p class="text-white text-[18px] md:text-[26px] text-center max-w-[1060px] leading-normal mb-10 md:mb-16">
        {t('home.welcome.text')}
      </p>
    </div>

    <!-- Maquette « écran de match » 100 % CSS -->
    <div class="px-5 pb-16 md:pb-24">
      <MatchScreen class="max-w-[1100px] mx-auto" />
    </div>
  </section>

  <!-- Your club's digital display -->
  <section class="py-16 md:py-[96px] px-5 md:px-[60px]">
    <div class="max-w-[1320px] mx-auto flex flex-col md:flex-row gap-12 md:gap-[120px] items-center">
      <div class="w-full md:flex-1 flex flex-col gap-[40px] items-start">
        <div>
          <h2 class="text-[36px] md:text-[48px] font-bold text-[#0a0b0d] leading-normal">
            {t('home.regie.title')}
          </h2>
          <p class="text-[#4a5565] text-[18px] leading-[28px] mt-5">
            {t('home.regie.text')}
          </p>
        </div>
        <Button href="/en/solution/" variant="black" arrow>
          {t('home.regie.cta')}
        </Button>
      </div>
      <RemoteMock />
    </div>
  </section>

  <!-- Plans tailored to your needs -->
  <section class="py-16 md:py-[96px] px-5 md:px-[60px]">
    <div class="max-w-[1320px] mx-auto flex flex-col md:flex-row gap-12 md:gap-[120px] items-center">
      <div class="w-full md:w-[550px] flex-shrink-0">
        <OfferCard
          square
          fromLabel="From"
          price="79"
          period="/ month"
          note="Fundable by your sponsors. No long-term commitment."
          features={['Screen + signage software', 'Remote control app', 'Video & sponsor content', 'Turnkey installation']}
        />
      </div>
      <div class="w-full md:flex-1 flex flex-col gap-[40px] items-start">
        <div>
          <h2 class="text-[36px] md:text-[48px] font-bold text-[#0a0b0d] leading-normal">
            {t('home.offres.title')}
          </h2>
          <p class="text-[#4a5565] text-[18px] leading-[28px] mt-5">
            {t('home.offres.text')}
          </p>
        </div>
        <Button href="/en/pricing/" variant="black" arrow>
          {t('home.offres.cta')}
        </Button>
      </div>
    </div>
  </section>

  <!-- Club carousel -->
  <ClubCarousel clubs={clubs} title={t('clubs.title')} client:visible />

  <!-- Contact -->
  <div id="contact">
    <ContactForm locale="en" client:visible />
  </div>
</BaseLayout>
