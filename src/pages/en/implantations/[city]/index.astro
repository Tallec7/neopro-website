---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { cities, sports } from '@/data/en/implantations';
import { buildBreadcrumbJsonLd } from '@/lib/jsonLd';

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const siteUrl = 'https://www.neopro-communication.fr';
const canonicalUrl = `${siteUrl}/en/implantations/${city.slug}`;

const countryLabel =
  city.country === 'GB'
    ? 'United Kingdom'
    : city.country === 'US'
      ? 'United States'
      : 'Canada';

const breadcrumb = buildBreadcrumbJsonLd([
  { name: 'Home', url: `${siteUrl}/en` },
  { name: 'Locations', url: `${siteUrl}/en/implantations` },
  { name: city.name, url: canonicalUrl },
]);
---

<BaseLayout
  title={`Digital Sports Signage ${city.at} — Neopro, Screens & Management for Clubs`}
  description={`Neopro equips sports clubs ${city.at} with LED screens and a turnkey digital signage solution. Handball, basketball, volleyball and more. Get a free quote.`}
  canonicalUrl={canonicalUrl}
  extraJsonLd={breadcrumb}
  noAlternates
  locale="en"
>
  <!-- Hero -->
  <section class="bg-neo-dark text-white py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-neo-green text-sm font-semibold uppercase tracking-widest mb-3">
        {countryLabel} — {city.region}
      </p>
      <h1 class="text-3xl md:text-5xl font-black mb-6">
        Digital signage for sports clubs<br />
        <span class="text-neo-green">{city.at}</span>
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        Neopro equips sports clubs {city.at} — from professional teams to community leagues — with LED screens and a turnkey digital signage solution to showcase sponsors and modernise the match-day experience.
      </p>
    </div>
  </section>

  <!-- Sports -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-neo-dark mb-4 text-center">
        Choose your sport
      </h2>
      <p class="text-neo-gray text-center mb-10">
        Neopro offers tailored solutions for every sport {city.at}.
      </p>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {sports.map((sport) => (
          <a
            href={`/en/implantations/${city.slug}/${sport.slug}`}
            class="group block p-6 bg-gray-50 rounded-xl hover:bg-neo-green transition-all"
          >
            <h3 class="font-black text-neo-dark text-lg mb-2">
              {sport.name}
            </h3>
            <p class="text-sm text-neo-gray group-hover:text-neo-dark transition-colors">
              Solutions for {sport.venue}s {city.at}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Neopro -->
  <section class="py-16 px-6 bg-neo-dark-bg text-white">
    <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-10 items-center">
      <div>
        <h2 class="text-2xl font-black mb-4">
          Why Neopro {city.at}?
        </h2>
        <ul class="space-y-3 text-gray-300">
          <li class="flex items-start gap-2">
            <span class="text-neo-green mt-1">✓</span>
            <span>On-site installation {city.at} and across the {city.region} region</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-neo-green mt-1">✓</span>
            <span>Remote content updates with no technical skills required</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-neo-green mt-1">✓</span>
            <span>Turnkey solution for all clubs — from professional teams to community leagues</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-neo-green mt-1">✓</span>
            <span>Fast return on investment through sponsor visibility</span>
          </li>
        </ul>
      </div>
      <div class="text-center">
        <p class="text-4xl font-black text-neo-green mb-2">+{sports.length} sports</p>
        <p class="text-gray-300">covered {city.at}</p>
        <a
          href="/en/devis"
          class="mt-6 inline-block bg-neo-green text-neo-dark font-bold px-8 py-4 rounded-xl hover:bg-neo-green-dark transition-colors"
        >
          Get a free quote
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
