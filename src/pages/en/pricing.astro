---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ClubCarousel from '@/components/ClubCarousel.tsx';
import TestimonialCarousel from '@/components/TestimonialCarousel.tsx';
import ContactForm from '@/components/ContactForm.tsx';
import { buildAggregateOfferJsonLd } from '@/lib/jsonLd';
import { useTranslations } from '@/i18n/utils';

// ── EN Data ─────────────────────────────────────────────────────
import { plans, playPlan, comparisonTable, videoPackages, additionalOptions, chainSteps } from '@/data/en/offres';
import { testimonials } from '@/data/en/temoignages';
import { clubs } from '@/data/clubs';

const locale = 'en';
const t = useTranslations(locale);

// ── Helpers ──────────────────────────────────────────────────────
const borderColorMap: Record<string, string> = {
  yellow: 'border-[#d9870b]',
  green: 'border-[#093a60]',
  pink: 'border-[#0e578e]',
  black: 'border-gray-200',
};

const priceColorMap: Record<string, string> = {
  yellow: 'text-[#d9870b]',
  green: 'text-[#093a60]',
  pink: 'text-[#0e578e]',
  black: 'text-[#0a0b0d]',
};

// ── SEO ──────────────────────────────────────────────────────────
const title = 'Sport digital signage plans — From €79/month';
const description = "Discover MADXP plans, the turnkey sport digital signage solution for clubs: Play (€79/mo, no hardware), Club (€149/mo), Pro (€199/mo) and Premium (€299/mo). Fundable by your sponsors.";

const siteUrl = 'https://madxp.kalonpartners.bzh';
const allPlans = [playPlan, ...plans];
const offerJsonLd = buildAggregateOfferJsonLd(
  allPlans.map((plan) => ({
    name: `MADXP ${plan.name}`,
    description: plan.features.filter(f => f.included).map(f => f.label).join('. '),
    price: plan.priceAnnual,
    priceCurrency: 'EUR',
    url: `${siteUrl}/en/quote/?offre=${plan.slug}`,
  })),
  'MADXP',
  siteUrl,
);
---

<BaseLayout title={title} description={description} extraJsonLd={offerJsonLd} locale={locale}>
  <!-- Hero -->
  <section class="relative h-[743px] overflow-hidden">
    <img
      src="/images/image_offre_accueil.jpg"
      alt="Gym equipped with a MADXP digital screen showing partner offers"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-[rgba(6,38,63,0.6)]"></div>
    <div class="relative z-10 h-full flex flex-col justify-end px-[20px] md:px-[40px] lg:px-[60px] pb-[60px] md:pb-[80px]">
      <p class="text-[16px] tracking-[2px] text-[#d9d9d9] uppercase mb-[20px]">{t('offres.hero.label')}</p>
      <h1 class="text-[36px] md:text-[50px] lg:text-[70px] leading-[1.1] text-white mb-[30px]">
        <span class="font-display">{t('offres.hero.line1')}</span><br />
        <span class="font-black">{t('offres.hero.line2')}</span>
      </h1>
      <div>
        <Button href="#contact" variant="green" arrow>{t('offres.hero.cta')}</Button>
      </div>
    </div>
  </section>

  <!-- Plans -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pt-[60px] md:pt-[96px] pb-[30px] md:pb-[40px]">
    <div class="max-w-[1320px] mx-auto">
      <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#0a0b0d] mb-[20px]">Our plans</h2>
      <p class="text-[18px] text-madxp-gray mb-[40px] max-w-[700px]">Start without hardware with <strong>Play</strong>, or go straight to the box with <strong>Club</strong>, <strong>Pro</strong> or <strong>Premium</strong>.</p>

      <!-- PLAY banner -->
      <div class="relative bg-white border border-gray-200 rounded-[20px] p-[30px] md:p-[40px] mb-[50px] flex flex-col md:flex-row gap-[30px] items-start md:items-center shadow-sm">
        <span class="absolute -top-3 left-[30px] bg-[#0e578e] text-[#06263f] text-[13px] font-bold px-4 py-1 rounded-[40px] whitespace-nowrap uppercase tracking-wider">
          No hardware · SaaS
        </span>
        <div class="flex-1">
          <h3 class="text-[28px] md:text-[32px] font-bold text-[#0a0b0d]">{playPlan.name}</h3>
          <p class="font-display text-[20px] text-madxp-gray mt-[4px]">&laquo; {playPlan.pitch} &raquo;</p>
          <p class="text-[15px] text-[#0a0b0d] mt-[16px] max-w-[520px]">Access the web player, unlimited videos, cloud remote control. Ideal to get started in minutes, no installation required.</p>
        </div>
        <div class="shrink-0 flex flex-col items-start md:items-end gap-[14px]">
          <div class="md:text-right">
            <p
              class="text-[32px] font-bold text-[#0a0b0d]"
              data-price-annual={playPlan.priceAnnual}
              data-price-monthly={playPlan.priceMonthly}
            ><span class="js-price">&euro;{playPlan.priceAnnual.toLocaleString('en-US')}</span><span class="text-[16px] font-normal text-madxp-gray js-suffix">/yr</span></p>
            <p class="text-[13px] text-[#4a5565] js-secondary hidden">9-month minimum commitment</p>
          </div>
          <Button href={`/en/quote/?offre=${playPlan.slug}`} variant="green" arrow>Start with Play</Button>
        </div>
      </div>

      <!-- Toggle Annual / Monthly -->
      <div class="flex flex-col items-center gap-[10px] mb-[40px]">
        <div class="inline-flex bg-[#f5f5f5] rounded-full p-[6px] shadow-sm" role="tablist" aria-label="Billing period">
          <button type="button" class="js-toggle-btn px-8 py-[10px] rounded-full text-[16px] font-semibold transition-colors" data-period="annual" aria-pressed="true">Annual</button>
          <button type="button" class="js-toggle-btn px-8 py-[10px] rounded-full text-[16px] font-semibold transition-colors" data-period="monthly" aria-pressed="false">Monthly</button>
        </div>
        <p class="text-[13px] text-madxp-blue-deep font-medium">Annual = reduced rate · Monthly = 9-month commitment</p>
      </div>

      <!-- 3 cards Club / Pro / Premium -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
        {plans.map((offre) => (
          <div
            class={`relative bg-white rounded-[20px] p-[30px] flex flex-col border-4 ${borderColorMap[offre.buttonVariant] || 'border-gray-200'} ${offre.popular ? 'lg:scale-[1.03] shadow-xl' : ''}`}
          >
            {offre.popular && (
              <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-[#0e578e] text-[#06263f] text-[16px] font-bold px-5 py-1 rounded-[40px] whitespace-nowrap">
                Recommended
              </span>
            )}
            {(offre.slug === 'pro' || offre.slug === 'premium') && (
              <span class="absolute top-[14px] right-[14px] bg-[#d9870b] text-[#06263f] text-[10px] font-black px-2 py-[3px] rounded-full uppercase tracking-wider whitespace-nowrap shadow-sm">
                ★ Promo May 31
              </span>
            )}
            <div class="mb-[20px]">
              <h3 class="text-[28px] font-bold">{offre.name}</h3>
              <p class="font-display text-[16px] text-madxp-gray mt-[2px]">&laquo; {offre.pitch} &raquo;</p>
              {offre.slug === 'pro' ? (
                <>
                  <p class="text-[14px] text-madxp-gray line-through mt-[12px] mb-[-4px]">
                    <span data-price-annual={offre.priceAnnual} data-price-monthly={offre.priceMonthly}><span class="js-price">&euro;{offre.priceAnnual.toLocaleString('en-US')}</span><span class="js-suffix">/yr</span></span>
                  </p>
                  <p
                    class={`text-[28px] font-bold mt-[2px] ${priceColorMap[offre.buttonVariant] || 'text-madxp-blue-deep'}`}
                    data-price-annual={Math.round(offre.priceAnnual * 0.8)}
                    data-price-monthly={Math.round(offre.priceMonthly * 0.8)}
                  >
                    <span class="js-price">&euro;{Math.round(offre.priceAnnual * 0.8).toLocaleString('en-US')}</span><span class="text-[16px] font-normal text-madxp-gray js-suffix">/yr</span>
                    <span class="text-[12px] font-bold text-[#093a60] bg-[#e4edf4] px-2 py-[2px] rounded-full ml-2 align-middle">-20%</span>
                  </p>
                  <p class="text-[12px] text-[#093a60] font-semibold mt-[4px]">Offer valid until May 31</p>
                </>
              ) : (
                <p
                  class={`text-[28px] font-bold mt-[12px] ${priceColorMap[offre.buttonVariant] || 'text-madxp-blue-deep'}`}
                  data-price-annual={offre.priceAnnual}
                  data-price-monthly={offre.priceMonthly}
                >
                  <span class="js-price">&euro;{offre.priceAnnual.toLocaleString('en-US')}</span><span class="text-[16px] font-normal text-madxp-gray js-suffix">/yr</span>
                </p>
              )}
              {offre.slug === 'premium' && (
                <p class="text-[12px] text-[#0e578e] font-semibold mt-[6px] leading-snug">
                  ★ Photo/video shoot + production free for 1 team (until May 31)
                </p>
              )}
              <p class="text-[13px] text-madxp-gray mt-[4px] js-secondary hidden">9-month minimum commitment</p>
            </div>
            <div class="border-t border-gray-200 mb-[16px]"></div>
            <ul class="flex flex-col gap-[12px] mb-[30px] flex-1">
              {offre.features.map((f) => (
                f.label.startsWith('Everything in') ? (
                  <li class="-mt-[10px] text-[13px] font-semibold uppercase tracking-wider text-madxp-gray">
                    {f.label.replace(/:$/, '')}
                  </li>
                ) : (
                  <li class={`flex items-start gap-[10px] text-[15px] ${f.included ? 'text-[#0a0b0d]' : 'text-[#c0c5cc] italic'}`}>
                    {f.included ? (
                      <svg class="w-5 h-5 shrink-0 text-madxp-blue-deep mt-[2px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                    ) : (
                      <span class="w-5 h-5 shrink-0 flex items-center justify-center text-[#c0c5cc] mt-[2px]">—</span>
                    )}
                    {f.label}
                  </li>
                )
              ))}
            </ul>
            <p class="text-[13px] text-[#4a5565] mb-[12px] flex items-center gap-[6px]">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              9-month commitment · Box included on loan
            </p>
            <Button href={`/en/quote/?offre=${offre.slug}`} variant={offre.buttonVariant} arrow>
              Choose this plan
            </Button>
          </div>
        ))}
      </div>

      <!-- Detailed comparison table (collapsible) -->
      <details class="mt-[40px] bg-white rounded-[20px] group border border-gray-200">
        <summary class="cursor-pointer list-none px-[30px] py-[24px] flex items-center justify-between gap-[20px] hover:bg-[#fafafa] transition-colors rounded-[20px]">
          <div class="flex-1">
            <p class="text-[18px] md:text-[22px] font-bold text-[#0a0b0d]">Compare all features</p>
            <p class="text-[13px] text-madxp-gray mt-[2px]">Detailed view of all 4 plans side by side</p>
          </div>
          <span class="shrink-0 inline-flex items-center gap-2 bg-[#f5f5f5] border border-gray-200 rounded-full px-4 py-2 text-[14px] font-medium text-[#0a0b0d]">
            <span class="group-open:hidden">View table</span>
            <span class="hidden group-open:inline">Hide</span>
            <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
          </span>
        </summary>
        <div class="px-[20px] md:px-[30px] pb-[30px] overflow-x-auto">
          <table class="w-full border-collapse min-w-[640px]">
            <thead>
              <tr class="border-b-2 border-gray-200">
                <th class="text-left py-[14px] pr-[10px] text-[14px] font-bold text-[#0a0b0d] w-[40%]"></th>
                <th class="text-center py-[14px] px-[8px] text-[15px] font-bold text-[#0a0b0d]">Play</th>
                <th class="text-center py-[14px] px-[8px] text-[15px] font-bold text-[#d9870b]">Club</th>
                <th class="text-center py-[14px] px-[8px] text-[15px] font-bold text-madxp-blue-deep relative">
                  Pro
                  <span class="absolute -top-[2px] left-1/2 -translate-x-1/2 text-[9px] bg-[#0e578e] text-[#06263f] font-bold px-2 py-[1px] rounded-full uppercase tracking-wider whitespace-nowrap">★</span>
                </th>
                <th class="text-center py-[14px] px-[8px] text-[15px] font-bold text-[#0e578e]">Premium</th>
              </tr>
            </thead>
            <tbody>
              {comparisonTable.map((cat) => (
                <>
                  <tr>
                    <td colspan="5" class="pt-[24px] pb-[8px] text-[12px] font-bold uppercase tracking-wider text-madxp-gray">{cat.title}</td>
                  </tr>
                  {cat.rows.map((row) => (
                    <tr class="border-b border-gray-100">
                      <td class="py-[12px] pr-[10px] text-[14px] text-[#0a0b0d]">{row.label}</td>
                      {row.values.map((v) => (
                        <td class="text-center py-[12px] px-[8px]">
                          {v === true ? (
                            <svg class="w-5 h-5 inline text-madxp-blue-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                          ) : v === false ? (
                            <span class="text-[#c0c5cc] text-[18px]">—</span>
                          ) : (
                            <span class="text-[13px] text-[#4a5565] font-medium">{v}</span>
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </details>

    </div>
  </section>

  <!-- Complete your plan: Production / Screens / A la carte options -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pt-[40px] md:pt-[60px] pb-[40px] md:pb-[60px]">
    <div class="max-w-[1320px] mx-auto">
      <div class="mb-[40px] max-w-[760px]">
        <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[12px]">ADD-ONS</p>
        <h2 class="text-[26px] md:text-[34px] lg:text-[40px] font-bold text-[#0a0b0d] mb-[12px]">
          <span class="font-display">Complete</span> your plan
        </h2>
        <p class="text-[16px] md:text-[18px] text-madxp-gray">Combine with any plan — custom pricing on quote.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-[20px]">

        <!-- Column 1: Content production (3 video packages) -->
        <div class="bg-white border border-gray-200 rounded-[20px] p-[26px] flex flex-col">
          <div class="flex items-center gap-[12px] mb-[16px]">
            <span class="shrink-0 w-[44px] h-[44px] rounded-full bg-[#4a8bbf] text-[#06263f] flex items-center justify-center font-bold text-[18px]">🎬</span>
            <h3 class="text-[20px] font-bold text-[#0a0b0d]">Content production</h3>
          </div>
          <p class="text-[13px] text-madxp-gray italic mb-[18px]">We shoot your players and integrate them into our premium templates.</p>
          <ul class="flex flex-col gap-[14px] flex-1">
            {videoPackages.map((pkg) => (
              <li class="border-l-2 border-[#4a8bbf] pl-[12px]">
                <p class="text-[14px] font-bold text-[#0a0b0d] flex items-center gap-2">
                  {pkg.name}
                  {pkg.popular && <span class="text-[10px] bg-[#4a8bbf] text-[#06263f] px-2 py-[1px] rounded-full font-bold uppercase tracking-wider">★ Top</span>}
                  {pkg.name === 'Standard' && <span class="text-[10px] bg-[#0e578e] text-[#06263f] px-2 py-[1px] rounded-full font-bold uppercase tracking-wider">Included</span>}
                </p>
                <p class="text-[12px] text-madxp-gray mb-[6px]">{pkg.description}</p>
                <ul class="flex flex-col gap-[3px]">
                  {pkg.features.map((f) => (
                    <li class="text-[12px] text-[#4a5565] flex items-start gap-[6px]">
                      <span class="text-[#4a8bbf] mt-[1px]">·</span>{f}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>

        <!-- Column 2: Screens & installation -->
        <div class="bg-white border border-gray-200 rounded-[20px] p-[26px] flex flex-col">
          <div class="flex items-center gap-[12px] mb-[16px]">
            <span class="shrink-0 w-[44px] h-[44px] rounded-full bg-[#d9870b] text-[#06263f] flex items-center justify-center font-bold text-[18px]">📺</span>
            <h3 class="text-[20px] font-bold text-[#0a0b0d]">Screens & installation</h3>
          </div>
          <p class="text-[13px] text-madxp-gray italic mb-[18px]">We help you choose and install the screens to go with your setup.</p>
          <ul class="flex flex-col gap-[14px] flex-1">
            {chainSteps[3].services.map((opt) => (
              <li class="flex items-start gap-[10px]">
                <svg class="w-4 h-4 shrink-0 text-[#d9870b] mt-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                <div>
                  <p class="text-[14px] text-[#0a0b0d] leading-snug">{opt.label}</p>
                  {opt.hint && <p class="text-[12px] text-madxp-gray mt-[1px]">{opt.hint}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Column 3: A la carte options -->
        <div class="bg-white border border-gray-200 rounded-[20px] p-[26px] flex flex-col">
          <div class="flex items-center gap-[12px] mb-[16px]">
            <span class="shrink-0 w-[44px] h-[44px] rounded-full bg-[#0e578e] text-white flex items-center justify-center font-bold text-[18px]">+</span>
            <h3 class="text-[20px] font-bold text-[#0a0b0d]">A la carte options</h3>
          </div>
          <p class="text-[13px] text-madxp-gray italic mb-[18px]">To customise and go further with your plan.</p>
          <ul class="flex flex-col gap-[14px] flex-1">
            {additionalOptions.map((cat) => (
              <li>
                <p class="text-[11px] font-bold uppercase tracking-wider text-madxp-gray mb-[6px]">{cat.title}</p>
                <ul class="flex flex-col gap-[6px]">
                  {cat.options.map((opt) => (
                    <li class="flex items-start gap-[8px]">
                      <svg class="w-4 h-4 shrink-0 text-[#0e578e] mt-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                      <div>
                        <p class="text-[13px] text-[#0a0b0d] leading-snug">{opt.label}</p>
                        <p class="text-[11px] text-madxp-gray">{opt.availability}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>

      </div>

      <div class="text-center mt-[30px]">
        <Button href="/en/quote/?offre=options" variant="black" arrow>Build my custom plan</Button>
      </div>
    </div>
  </section>

  <!-- Fundable by your sponsors -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[1320px] mx-auto">
      <div class="bg-[rgba(14,87,142,0.4)] rounded-[20px] px-[20px] md:px-[40px] lg:px-[60px] py-[40px] md:py-[74px] flex flex-col md:flex-row items-center gap-[30px] justify-between">
        <div class="flex-1">
          <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#0a0b0d] mb-[20px]">
            {t('offres.financable.title')}
          </h2>
          <p class="text-[18px] text-[#4a5565]">{t('offres.financable.text')}</p>
        </div>
        <div class="shrink-0 w-full md:w-auto">
          <form class="flex flex-col sm:flex-row gap-3 w-full" data-financable-form data-pdf-url="/documents/financable-partenaires.pdf">
            <input
              type="email"
              name="email"
              placeholder={t('offres.financable.placeholder')}
              required
              class="h-[48px] px-4 rounded-full border border-gray-300 text-[16px] w-full sm:w-[260px] outline-none focus:border-madxp-blue-deep transition-colors"
            />
            <button
              type="submit"
              class="h-[48px] px-6 bg-[#06263f] text-white text-[16px] font-medium rounded-full hover:bg-[#0a0b0d] transition-colors whitespace-nowrap"
            >
              {t('offres.financable.cta')}
            </button>
            <p class="hidden text-[14px] mt-2 w-full" data-form-message></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Fleet (operators / leagues / federations) -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[80px]">
    <div class="max-w-[1320px] mx-auto">
      <div class="relative bg-[#06263f] text-white rounded-[20px] overflow-hidden p-[36px] md:p-[50px]">
        <div class="relative flex flex-col lg:flex-row gap-[32px] items-start lg:items-center justify-between">
          <div class="flex-1 max-w-[640px]">
            <p class="text-[13px] tracking-[2px] text-[#0e578e] uppercase font-bold mb-[12px]">FLEET · DEDICATED OFFER</p>
            <h2 class="text-[26px] md:text-[34px] lg:text-[40px] font-bold mb-[14px]">
              <span class="font-display">Managing</span> multiple clubs?
            </h2>
            <p class="text-[15px] md:text-[16px] text-[#d9d9d9] mb-[20px]">Leagues, federations, operators and club networks: group deployment, centralised dashboard, volume pricing.</p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-[20px] gap-y-[8px] mb-[24px]">
              {[
                'Multi-site dashboard',
                'Group deployment',
                'Offline alerts',
                'Cross-club analytics',
                'Volume pricing',
                'Dedicated contact',
              ].map((item) => (
                <li class="flex items-start gap-[8px] text-[14px] text-[#d9d9d9]">
                  <svg class="w-4 h-4 shrink-0 text-[#0e578e] mt-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
            <Button href="/en/quote/?offre=flotte" variant="green" arrow>Request a fleet quote</Button>
          </div>
          <div class="hidden lg:flex shrink-0 flex-col items-center justify-center bg-[#0a0b0d] rounded-[16px] px-[40px] py-[36px] border border-[#0e578e]/20">
            <p class="text-[64px] font-black text-[#0e578e] leading-none">5+</p>
            <p class="text-[13px] text-[#d9d9d9] uppercase tracking-wider mt-[8px]">clubs / sites</p>
            <p class="text-[12px] text-madxp-gray mt-[12px] text-center max-w-[140px]">the threshold at which fleet becomes relevant</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Club Carousel -->
  <ClubCarousel clubs={clubs} title={t('clubs.title')} client:visible />

  <!-- Testimonials -->
  <TestimonialCarousel testimonials={testimonials} sectionTitle={t('testimonials.title')} client:visible />

  <!-- Contact -->
  <div id="contact">
    <ContactForm locale="en" client:visible />
  </div>
</BaseLayout>

<style>
  .js-toggle-btn[aria-pressed="true"] {
    background-color: #0a0b0d;
    color: #ffffff;
  }
  .js-toggle-btn[aria-pressed="false"] {
    color: #4a5565;
  }
</style>

<script>
  // Toggle Annual / Monthly
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.js-toggle-btn');
  const priceEls = document.querySelectorAll<HTMLElement>('[data-price-annual]');

  function setPeriod(period: 'annual' | 'monthly') {
    toggleBtns.forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.period === period ? 'true' : 'false');
    });
    priceEls.forEach((el) => {
      const annual = Number(el.dataset.priceAnnual);
      const monthly = Number(el.dataset.priceMonthly);
      const priceSpan = el.querySelector('.js-price') as HTMLElement | null;
      const suffixSpan = el.querySelector('.js-suffix') as HTMLElement | null;
      const secondary = el.parentElement?.querySelector('.js-secondary') as HTMLElement | null;
      if (!priceSpan || !suffixSpan) return;
      if (period === 'annual') {
        priceSpan.textContent = `€${annual.toLocaleString('en-US')}`;
        suffixSpan.textContent = '/yr';
        if (secondary) secondary.classList.add('hidden');
      } else if (monthly) {
        priceSpan.textContent = `€${monthly}`;
        suffixSpan.textContent = '/mo';
        if (secondary) secondary.classList.remove('hidden');
      }
    });
  }

  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const period = btn.dataset.period as 'annual' | 'monthly';
      setPeriod(period);
    });
  });

  const form = document.querySelector('[data-financable-form]') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const msg = form.querySelector('[data-form-message]') as HTMLParagraphElement;
      const pdfUrl = form.dataset.pdfUrl;

      if (!emailInput?.value) return;

      btn.disabled = true;
      btn.textContent = 'Sending...';
      msg.classList.add('hidden');

      try {
        const res = await fetch('/api/document', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value, documentUrl: pdfUrl }),
        });

        if (res.ok) {
          msg.textContent = 'Document sent! Check your inbox.';
          msg.className = 'text-[14px] mt-2 w-full text-madxp-blue-deep';
          emailInput.value = '';
        } else {
          msg.textContent = 'An error occurred.';
          msg.className = 'text-[14px] mt-2 w-full text-red-600';
        }
      } catch {
        msg.textContent = 'Connection error. Please try again later.';
        msg.className = 'text-[14px] mt-2 w-full text-red-600';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Receive the document';
      }
    });
  }
</script>
