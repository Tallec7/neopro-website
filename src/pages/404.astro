---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout
  title="Page introuvable"
  description="Cette page n'existe pas."
  noAlternates
>
  <section class="min-h-[70vh] flex flex-col items-center justify-center px-6 py-24 text-center">
    <p class="text-[120px] md:text-[180px] font-black text-[#e8f5f0] leading-none select-none">404</p>
    <h1 id="title-404" class="text-[28px] md:text-[40px] font-bold text-[#101828] mt-[-20px] mb-4">
      Page introuvable
    </h1>
    <p id="text-404" class="text-[#4a5565] text-[18px] max-w-[480px] mb-10">
      La page que vous cherchez n'existe pas ou a été déplacée.
    </p>
    <a id="cta-404" href="/" class="inline-flex items-center gap-2 rounded-full px-[30px] py-[12px] font-medium text-[18px] bg-[#101828] text-white hover:bg-[#1d2939] transition-colors">
      Retour à l'accueil
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M0.8 5.46667H10.1333M10.1333 5.46667L5.46667 0.8M10.1333 5.46667L5.46667 10.1333" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </section>
</BaseLayout>

<script>
  const path = window.location.pathname;
  const locale = path.startsWith('/en/') || path === '/en' ? 'en'
               : path.startsWith('/es/') || path === '/es' ? 'es'
               : 'fr';

  const content: Record<string, { title: string; text: string; cta: string; home: string }> = {
    fr: { title: 'Page introuvable', text: "La page que vous cherchez n'existe pas ou a été déplacée.", cta: "Retour à l'accueil", home: '/' },
    en: { title: 'Page not found', text: "The page you're looking for doesn't exist or has been moved.", cta: 'Back to home', home: '/en/' },
    es: { title: 'Página no encontrada', text: 'La página que buscas no existe o ha sido movida.', cta: 'Volver al inicio', home: '/es/' },
  };

  const c = content[locale];
  document.getElementById('title-404')!.textContent = c.title;
  document.getElementById('text-404')!.textContent = c.text;
  const cta = document.getElementById('cta-404') as HTMLAnchorElement;
  cta.textContent = c.cta;
  cta.href = c.home;
  // Réinjecte la flèche
  cta.insertAdjacentHTML('beforeend', '<svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M0.8 5.46667H10.1333M10.1333 5.46667L5.46667 0.8M10.1333 5.46667L5.46667 10.1333" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>');
</script>
