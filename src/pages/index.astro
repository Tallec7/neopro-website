---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ClubCarousel from '@/components/ClubCarousel.tsx';
import ContactForm from '@/components/ContactForm.tsx';
import { Image } from 'astro:assets';

// ── Images ───────────────────────────────────────────────────────
import heroImg from '@/assets/images/hero-accueil-v2.webp';
import imageTelephoneImg from '@/assets/images/image-telephone.png';

// ── Données ──────────────────────────────────────────────────────
import { clubs } from '@/data/clubs';

// ── SEO ──────────────────────────────────────────────────────────
const title = 'Neopro — Régie digitale pour clubs de sport';
const description = "Neopro installe des écrans et une régie digitale clé en main dans les gymnases. Valorisez vos sponsors, animez vos matchs et pilotez tout depuis un smartphone. Dès 1 500 €/an.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative h-[500px] md:h-[743px] bg-[#2f3935] overflow-hidden">
    <Image
      src={heroImg}
      alt="Écran digital Neopro affichant les sponsors dans un gymnase de handball"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      widths={[768, 1280, 1920]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#2f3935] to-[80%] to-[rgba(47,57,53,0.3)]"></div>
    <div class="relative z-10 flex flex-col justify-end h-full text-white p-8 md:p-[60px] gap-8 md:gap-[40px]">
      <h1 class="text-[36px] md:text-[70px] leading-[1]">
        <span class="font-playfair italic font-normal">On fait de votre écran,</span>
        <br /><span class="font-black">un média interactif.</span>
        <br /><span class="font-playfair italic font-normal">Tel un club pro.</span>
      </h1>
      <div class="flex flex-wrap gap-6 md:gap-[43px]">
        <Button href="/solution" variant="white" arrow>
          Découvrez la solution
        </Button>
      </div>
    </div>
  </section>

  <!-- Bienvenue au club -->
  <section class="relative bg-[#2f3935] overflow-hidden">
    <div class="flex flex-col items-center justify-center px-5 pt-16 md:pt-24">
      <h2 class="text-[#51b28b] text-[48px] md:text-[128px] leading-[1] text-center mb-6 md:mb-10">
        <span class="font-playfair italic font-normal">Bienvenue </span><span class="font-black">au club.</span>
      </h2>
      <p class="text-white text-[18px] md:text-[26px] text-center max-w-[1060px] leading-normal mb-10 md:mb-16">
        Neopro propose une solution de régie digitale adaptée aux contraintes des clubs amateurs, dans le but de professionnaliser leur expérience match et de créer un nouvel espace publicitaire pour leurs partenaires.
      </p>
    </div>

    <!-- Vidéo -->
    <div class="px-5 pb-16 md:pb-24">
      <div class="max-w-[1320px] mx-auto">
        <div class="relative rounded-[20px] overflow-hidden w-full aspect-[16/9] bg-[#1a1f1c] shadow-2xl">
          <video
            class="w-full h-full object-cover"
            autoplay
            muted
            loop
            playsinline
            poster="/og-default.jpg"
          >
            <source src="/videos/accueil-demo.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <!-- La régie digitale de votre club -->
  <section class="py-16 md:py-[96px] px-5 md:px-[60px]">
    <div class="max-w-[1320px] mx-auto flex flex-col md:flex-row gap-12 md:gap-[120px] items-center">
      <div class="w-full md:flex-1 flex flex-col gap-[40px] items-start">
        <div>
          <h2 class="text-[36px] md:text-[48px] font-bold text-[#101828] leading-normal">
            La régie digitale de votre club
          </h2>
          <p class="text-[#4a5565] text-[18px] leading-[28px] mt-5">
            Comment ça marche ? A quoi ça sert ?
          </p>
        </div>
        <Button href="/solution" variant="black" arrow>
          Découvrez la solution
        </Button>
      </div>
      <div class="w-full md:w-[550px] md:h-[550px] flex-shrink-0">
        <Image
          src={imageTelephoneImg}
          alt="Application télécommande Neopro sur smartphone pour piloter l'écran du gymnase"
          class="w-full h-full rounded-[20px] object-cover"
          loading="lazy"
          widths={[600, 1200]}
          sizes="(max-width: 768px) 100vw, 550px"
        />
      </div>
    </div>
  </section>

  <!-- Des offres adaptées à vos besoins -->
  <section class="py-16 md:py-[96px] px-5 md:px-[60px]">
    <div class="max-w-[1320px] mx-auto flex flex-col md:flex-row gap-12 md:gap-[120px] items-center">
      <div class="relative w-full md:w-[550px] md:h-[550px] flex-shrink-0 rounded-[20px] overflow-hidden">
        <img
          src="/images/image_offre.jpg"
          alt="Offres de régie digitale Neopro pour clubs amateurs"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="w-full md:flex-1 flex flex-col gap-[40px] items-start">
        <div>
          <h2 class="text-[36px] md:text-[48px] font-bold text-[#101828] leading-normal">
            Des offres adaptées à vos besoins
          </h2>
          <p class="text-[#4a5565] text-[18px] leading-[28px] mt-5">
            Finançable par vos partenaires. Clé en main.
          </p>
        </div>
        <Button href="/offres" variant="black" arrow>
          Découvrez les offres
        </Button>
      </div>
    </div>
  </section>

  <!-- Les clubs Neopro (carousel) -->
  <ClubCarousel clubs={clubs} client:visible />

  <!-- Contact -->
  <div id="contact">
    <ContactForm client:visible />
  </div>

  <!-- ── Popup webinar ─────────────────────────────────────────── -->
  <div id="webinar-popup" class="fixed inset-0 z-50 flex items-center justify-center px-4 hidden">
    <!-- Overlay -->
    <div id="webinar-popup-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <!-- Card -->
    <div class="relative z-10 rounded-2xl border border-white/10 max-w-md w-full p-8 shadow-2xl" style="background:#3D3036">
      <button id="webinar-popup-close" class="absolute top-4 right-4 text-white/40 hover:text-white transition-colors" aria-label="Fermer">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

      <p class="inline-block text-xs font-medium px-3 py-1 rounded-full mb-4" style="background:#FF9EC6;color:#3D3036">
        Webinar gratuit — 16 avril 2026
      </p>
      <h2 class="text-xl font-black leading-tight mb-2 text-white">
        <span class="font-playfair italic font-normal">Et si votre gymnase</span><br />
        rapportait à votre club&nbsp;?
      </h2>
      <p class="text-white/60 text-sm mb-5">Jeudi 16 avril à 11h — 45 min en ligne. On vous montre comment, cas concrets à l'appui.</p>

      <div id="webinar-popup-countdown" class="flex gap-3 mb-6 justify-center"></div>

      <a href="/webinar" class="flex items-center justify-center gap-2 font-bold px-6 py-3.5 rounded-full transition-colors w-full text-center" style="background:#FE6AA6;color:#3D3036">
        Je m'inscris gratuitement
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7" /></svg>
      </a>
      <button id="webinar-popup-dismiss" class="mt-3 w-full text-white/40 text-xs hover:text-white/60 transition-colors py-1">
        Non merci, pas maintenant
      </button>
    </div>
  </div>

  <script is:inline>
    (function () {
      const STORAGE_KEY = 'neopro_webinar_popup_dismissed';
      if (sessionStorage.getItem(STORAGE_KEY)) return;

      const popup = document.getElementById('webinar-popup');
      const close = document.getElementById('webinar-popup-close');
      const dismiss = document.getElementById('webinar-popup-dismiss');
      const overlay = document.getElementById('webinar-popup-overlay');
      const countdown = document.getElementById('webinar-popup-countdown');

      function closePopup() {
        sessionStorage.setItem(STORAGE_KEY, '1');
        popup.classList.add('opacity-0', 'transition-opacity', 'duration-300');
        setTimeout(() => popup.classList.add('hidden'), 300);
      }

      // Compte à rebours
      function updateCountdown() {
        const target = new Date('2026-04-16T09:00:00Z');
        const now = new Date();
        const diff = target - now;
        if (diff <= 0) { countdown.innerHTML = ''; return; }
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        countdown.innerHTML = [
          { v: d, l: 'jours' },
          { v: h, l: 'heures' },
          { v: m, l: 'min' },
        ].map(({ v, l }) => `
          <div style="background:rgba(255,255,255,0.07);border-radius:12px;padding:8px 16px;min-width:56px;display:flex;flex-direction:column;align-items:center;">
            <span style="font-size:24px;font-weight:900;color:#FE6AA6;line-height:1;">${String(v).padStart(2, '0')}</span>
            <span style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:4px;">${l}</span>
          </div>`).join('');
      }

      updateCountdown();

      close.addEventListener('click', closePopup);
      dismiss.addEventListener('click', closePopup);
      overlay.addEventListener('click', closePopup);

      setTimeout(() => {
        popup.classList.remove('hidden');
        popup.classList.add('flex');
      }, 3000);
    })();
  </script>
</BaseLayout>
