---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page introuvable"
  description="Cette page n'existe pas."
  noAlternates
  noIndex
>
  <section class="min-h-[70vh] flex flex-col items-center justify-center px-6 py-24 text-center">
    <p class="text-[120px] md:text-[180px] font-black text-[#e8f5f0] leading-none select-none">404</p>
    <h1 class="text-[28px] md:text-[40px] font-bold text-[#101828] mt-[-20px] mb-4">
      Page introuvable
    </h1>
    <p class="text-[#4a5565] text-[18px] max-w-[480px]">
      La page que vous cherchez n'existe pas ou a été déplacée.
    </p>
  </section>
</BaseLayout>
