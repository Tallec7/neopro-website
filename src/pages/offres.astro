            <Button href="/devis?offre=flotte" variant="green" arrow>Demander un devis flotte</Button>
          </div>
          <div class="hidden lg:flex shrink-0 flex-col items-center justify-center bg-[#1a201d] rounded-[16px] px-[40px] py-[36px] border border-[#81e3bc]/20">
            <p class="text-[64px] font-black text-[#81e3bc] leading-none">5+</p>
            <p class="text-[13px] text-[#d9d9d9] uppercase tracking-wider mt-[8px]">clubs / sites</p>
            <p class="text-[12px] text-neo-gray mt-[12px] text-center max-w-[140px]">à partir desquels la flotte devient pertinente</p>
