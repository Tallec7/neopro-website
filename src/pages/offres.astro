---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ClubCarousel from '@/components/ClubCarousel.tsx';
import TestimonialCarousel from '@/components/TestimonialCarousel.tsx';
import ContactForm from '@/components/ContactForm.tsx';
import { buildAggregateOfferJsonLd } from '@/lib/jsonLd';

// ── Images ───────────────────────────────────────────────────────
import heroImg from '@/assets/images/hero-offres.webp';

// ── Données ──────────────────────────────────────────────────────
import { plans, playPlan, comparisonTable, videoPackages, additionalOptions, chainSteps } from '@/data/offres-v2';
import { testimonials } from '@/data/temoignages';
import { clubs } from '@/data/clubs';

// ── Helpers ──────────────────────────────────────────────────────
const borderColorMap: Record<string, string> = {
  yellow: 'border-[#fdbe00]',
  green: 'border-[#51b28b]',
  pink: 'border-[#fe6aa6]',
  black: 'border-gray-200',
};

const priceColorMap: Record<string, string> = {
  yellow: 'text-[#c49800]',
  green: 'text-[#51b28b]',
  pink: 'text-[#fe6aa6]',
  black: 'text-[#101828]',
};

// ── SEO ──────────────────────────────────────────────────────────
const title = 'Offres régie digitale sport — À partir de 79 €/mois';
const description = "Découvrez les offres Neopro : Play (79 €/mois sans matériel), Club (149 €/mois), Pro (199 €/mois) et Premium (299 €/mois). Régie digitale clé en main, finançable par vos partenaires.";

const siteUrl = 'https://www.neopro-communication.fr';
const allPlans = [playPlan, ...plans];
const offerJsonLd = buildAggregateOfferJsonLd(
  allPlans.map((plan) => ({
    name: `Neopro ${plan.name}`,
    description: plan.features.filter(f => f.included).map(f => f.label).join('. '),
    price: plan.priceAnnual,
    priceCurrency: 'EUR',
    url: `${siteUrl}/devis?offre=${plan.slug}`,
  })),
  'Neopro',
  siteUrl,
);
---

<BaseLayout title={title} description={description} extraJsonLd={offerJsonLd}>
  <!-- Hero -->
  <section class="relative h-[743px] overflow-hidden">
    <img
      src="/images/image_offre_accueil.jpg"
      alt="Vue d'un gymnase équipé d'un écran digital Neopro avec les offres partenaires affichées"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-[rgba(47,57,53,0.6)]"></div>
    <div class="relative z-10 h-full flex flex-col justify-end px-[20px] md:px-[40px] lg:px-[60px] pb-[60px] md:pb-[80px]">
      <p class="text-[16px] tracking-[2px] text-[#d9d9d9] uppercase mb-[20px]">LES OFFRES</p>
      <h1 class="text-[36px] md:text-[50px] lg:text-[70px] leading-[1.1] text-white mb-[30px]">
        <span class="font-playfair italic">Adaptées à</span><br />
        <span class="font-black">vos besoins</span>
      </h1>
      <div>
        <Button href="#contact" variant="green" arrow>Obtenez un devis</Button>
      </div>
    </div>
  </section>

  <!-- Offres -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pt-[60px] md:pt-[96px] pb-[30px] md:pb-[40px]">
    <div class="max-w-[1320px] mx-auto">
      <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#101828] mb-[20px]">Nos offres</h2>
      <p class="text-[18px] text-neo-gray mb-[40px] max-w-[700px]">Commencez sans matériel avec <strong>Play</strong>, ou passez directement au boîtier avec <strong>Club</strong>, <strong>Pro</strong> ou <strong>Premium</strong>.</p>

      <!-- PLAY bandeau -->
      <div class="relative bg-white border border-gray-200 rounded-[20px] p-[30px] md:p-[40px] mb-[50px] flex flex-col md:flex-row gap-[30px] items-start md:items-center shadow-sm">
        <span class="absolute -top-3 left-[30px] bg-[#81e3bc] text-[#2f3935] text-[13px] font-bold px-4 py-1 rounded-[40px] whitespace-nowrap uppercase tracking-wider">
          Sans matériel · SaaS
        </span>
        <div class="flex-1">
          <h3 class="text-[28px] md:text-[32px] font-bold text-[#101828]">{playPlan.name}</h3>
          <p class="font-playfair italic text-[20px] text-neo-gray mt-[4px]">« {playPlan.pitch} »</p>
          <p class="text-[15px] text-[#101828] mt-[16px] max-w-[520px]">Accès au player web, vidéos illimitées, télécommande cloud. Idéal pour démarrer en quelques minutes, sans installation.</p>
        </div>
        <div class="shrink-0 flex flex-col items-start md:items-end gap-[14px]">
          <div class="md:text-right">
            <p
              class="text-[32px] font-bold text-[#101828]"
              data-price-annual={playPlan.priceAnnual}
              data-price-monthly={playPlan.priceMonthly}
            ><span class="js-price">{playPlan.priceAnnual.toLocaleString('fr-FR')} €</span><span class="text-[16px] font-normal text-neo-gray js-suffix">/an</span></p>
            <p class="text-[13px] text-[#4a5565] js-secondary hidden">Engagement 9 mois minimum</p>
          </div>
          <Button href={`/devis?offre=${playPlan.slug}`} variant="green" arrow>Démarrer avec Play</Button>
        </div>
      </div>

      <!-- Toggle Annuel / Mensuel -->
      <div class="flex flex-col items-center gap-[10px] mb-[40px]">
        <div class="inline-flex bg-[#f5f5f5] rounded-full p-[6px] shadow-sm" role="tablist" aria-label="Période de facturation">
          <button type="button" class="js-toggle-btn px-8 py-[10px] rounded-full text-[16px] font-semibold transition-colors" data-period="annual" aria-pressed="true">Annuel</button>
          <button type="button" class="js-toggle-btn px-8 py-[10px] rounded-full text-[16px] font-semibold transition-colors" data-period="monthly" aria-pressed="false">Mensuel</button>
        </div>
        <p class="text-[13px] text-neo-green-dark font-medium">Annuel = tarif réduit · Mensuel = engagement 9 mois</p>
      </div>

      <!-- 3 cartes Club / Pro / Premium -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
        {plans.map((offre) => (
          <div
            class={`relative bg-white rounded-[20px] p-[30px] flex flex-col border-4 ${borderColorMap[offre.buttonVariant] || 'border-gray-200'} ${offre.popular ? 'lg:scale-[1.03] shadow-xl' : ''}`}
          >
            {offre.popular && (
              <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-[#81e3bc] text-[#2f3935] text-[16px] font-bold px-5 py-1 rounded-[40px] whitespace-nowrap">
                Recommandée
              </span>
            )}
            {(offre.slug === 'pro' || offre.slug === 'premium') && (
              <span class="absolute top-[14px] right-[14px] bg-[#fdbe00] text-[#2f3935] text-[10px] font-black px-2 py-[3px] rounded-full uppercase tracking-wider whitespace-nowrap shadow-sm">
                ★ Promo 31 mai
              </span>
            )}
            <div class="mb-[20px]">
              <h3 class="text-[28px] font-bold">{offre.name}</h3>
              <p class="font-playfair italic text-[16px] text-neo-gray mt-[2px]">« {offre.pitch} »</p>
              {offre.slug === 'pro' ? (
                <>
                  <p class="text-[14px] text-neo-gray line-through mt-[12px] mb-[-4px]">
                    <span data-price-annual={offre.priceAnnual} data-price-monthly={offre.priceMonthly}><span class="js-price">{offre.priceAnnual.toLocaleString('fr-FR')} €</span><span class="js-suffix">/an</span></span>
                  </p>
                  <p
                    class={`text-[28px] font-bold mt-[2px] ${priceColorMap[offre.buttonVariant] || 'text-neo-green-dark'}`}
                    data-price-annual={Math.round(offre.priceAnnual * 0.8)}
                    data-price-monthly={Math.round(offre.priceMonthly * 0.8)}
                  >
                    <span class="js-price">{Math.round(offre.priceAnnual * 0.8).toLocaleString('fr-FR')} €</span><span class="text-[16px] font-normal text-neo-gray js-suffix">/an</span>
                    <span class="text-[12px] font-bold text-[#c49800] bg-[#fff7d6] px-2 py-[2px] rounded-full ml-2 align-middle">-20%</span>
                  </p>
                  <p class="text-[12px] text-[#c49800] font-semibold mt-[4px]">Offre valable jusqu'au 31 mai</p>
                </>
              ) : (
                <p
                  class={`text-[28px] font-bold mt-[12px] ${priceColorMap[offre.buttonVariant] || 'text-neo-green-dark'}`}
                  data-price-annual={offre.priceAnnual}
                  data-price-monthly={offre.priceMonthly}
                >
                  <span class="js-price">{offre.priceAnnual.toLocaleString('fr-FR')} €</span><span class="text-[16px] font-normal text-neo-gray js-suffix">/an</span>
                </p>
              )}
              {offre.slug === 'premium' && (
                <p class="text-[12px] text-[#fe6aa6] font-semibold mt-[6px] leading-snug">
                  ★ Shooting photo/vidéo + production offerts pour 1 équipe (jusqu'au 31 mai)
                </p>
              )}
              <p class="text-[13px] text-neo-gray mt-[4px] js-secondary hidden">Engagement 9 mois minimum</p>
            </div>
            <div class="border-t border-gray-200 mb-[16px]"></div>
            <ul class="flex flex-col gap-[12px] mb-[30px] flex-1">
              {offre.features.map((f) => (
                f.label.startsWith('Tout le pack') ? (
                  <li class="-mt-[10px] text-[13px] font-semibold uppercase tracking-wider text-neo-gray">
                    {f.label.replace(/ :$/, '')}
                  </li>
                ) : (
                  <li class={`flex items-start gap-[10px] text-[15px] ${f.included ? 'text-[#101828]' : 'text-[#c0c5cc] italic'}`}>
                    {f.included ? (
                      <svg class="w-5 h-5 shrink-0 text-neo-green-dark mt-[2px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                    ) : (
                      <span class="w-5 h-5 shrink-0 flex items-center justify-center text-[#c0c5cc] mt-[2px]">—</span>
                    )}
                    {f.label}
                  </li>
                )
              ))}
            </ul>
            <p class="text-[13px] text-[#4a5565] mb-[12px] flex items-center gap-[6px]">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Engagement 9 mois · Boîtier prêté inclus
            </p>
            <Button href={`/devis?offre=${offre.slug}`} variant={offre.buttonVariant} arrow>
              Choisir cette offre
            </Button>
          </div>
        ))}
      </div>

      <!-- Tableau comparatif détaillé (dépliable) -->
      <details class="mt-[40px] bg-white rounded-[20px] group border border-gray-200">
        <summary class="cursor-pointer list-none px-[30px] py-[24px] flex items-center justify-between gap-[20px] hover:bg-[#fafafa] transition-colors rounded-[20px]">
          <div class="flex-1">
            <p class="text-[18px] md:text-[22px] font-bold text-[#101828]">Comparer toutes les fonctionnalités</p>
            <p class="text-[13px] text-neo-gray mt-[2px]">Vue détaillée des 4 offres ligne par ligne</p>
          </div>
          <span class="shrink-0 inline-flex items-center gap-2 bg-[#f5f5f5] border border-gray-200 rounded-full px-4 py-2 text-[14px] font-medium text-[#101828]">
            <span class="group-open:hidden">Voir le tableau</span>
            <span class="hidden group-open:inline">Masquer</span>
            <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
          </span>
        </summary>
        <div class="px-[20px] md:px-[30px] pb-[30px] overflow-x-auto">
          <table class="w-full border-collapse min-w-[640px]">
            <thead>
              <tr class="border-b-2 border-gray-200">
                <th class="text-left py-[14px] pr-[10px] text-[14px] font-bold text-[#101828] w-[40%]"></th>
                <th class="text-center py-[14px] px-[8px] text-[15px] font-bold text-[#101828]">Play</th>
                <th class="text-center py-[14px] px-[8px] text-[15px] font-bold text-[#c49800]">Club</th>
                <th class="text-center py-[14px] px-[8px] text-[15px] font-bold text-neo-green-dark relative">
                  Pro
                  <span class="absolute -top-[2px] left-1/2 -translate-x-1/2 text-[9px] bg-[#81e3bc] text-[#2f3935] font-bold px-2 py-[1px] rounded-full uppercase tracking-wider whitespace-nowrap">★</span>
                </th>
                <th class="text-center py-[14px] px-[8px] text-[15px] font-bold text-[#fe6aa6]">Premium</th>
              </tr>
            </thead>
            <tbody>
              {comparisonTable.map((cat) => (
                <>
                  <tr>
                    <td colspan="5" class="pt-[24px] pb-[8px] text-[12px] font-bold uppercase tracking-wider text-neo-gray">{cat.title}</td>
                  </tr>
                  {cat.rows.map((row) => (
                    <tr class="border-b border-gray-100">
                      <td class="py-[12px] pr-[10px] text-[14px] text-[#101828]">{row.label}</td>
                      {row.values.map((v) => (
                        <td class="text-center py-[12px] px-[8px]">
                          {v === true ? (
                            <svg class="w-5 h-5 inline text-neo-green-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                          ) : v === false ? (
                            <span class="text-[#c0c5cc] text-[18px]">—</span>
                          ) : (
                            <span class="text-[13px] text-[#4a5565] font-medium">{v}</span>
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </details>

    </div>
  </section>

  <!-- Compléter votre offre : Production / Écrans / Options à la carte -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] pt-[40px] md:pt-[60px] pb-[40px] md:pb-[60px]">
    <div class="max-w-[1320px] mx-auto">
      <div class="mb-[40px] max-w-[760px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[12px]">EN COMPLÉMENT</p>
        <h2 class="text-[26px] md:text-[34px] lg:text-[40px] font-bold text-[#101828] mb-[12px]">
          <span class="font-playfair italic">Compléter</span> votre offre
        </h2>
        <p class="text-[16px] md:text-[18px] text-neo-gray">À combiner avec n'importe quelle offre — chiffrage personnalisé sur devis.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-[20px]">

        <!-- Colonne 1 : Production de contenu (3 packs vidéo) -->
        <div class="bg-white border border-gray-200 rounded-[20px] p-[26px] flex flex-col">
          <div class="flex items-center gap-[12px] mb-[16px]">
            <span class="shrink-0 w-[44px] h-[44px] rounded-full bg-[#79e8fa] text-[#2f3935] flex items-center justify-center font-bold text-[18px]">🎬</span>
            <h3 class="text-[20px] font-bold text-[#101828]">Production de contenu</h3>
          </div>
          <p class="text-[13px] text-neo-gray italic mb-[18px]">On shoote vos joueurs et on les intègre à nos templates premium.</p>
          <ul class="flex flex-col gap-[14px] flex-1">
            {videoPackages.map((pkg) => (
              <li class="border-l-2 border-[#79e8fa] pl-[12px]">
                <p class="text-[14px] font-bold text-[#101828] flex items-center gap-2">
                  {pkg.name}
                  {pkg.popular && <span class="text-[10px] bg-[#79e8fa] text-[#2f3935] px-2 py-[1px] rounded-full font-bold uppercase tracking-wider">★ Top</span>}
                  {pkg.name === 'Classique' && <span class="text-[10px] bg-[#81e3bc] text-[#2f3935] px-2 py-[1px] rounded-full font-bold uppercase tracking-wider">Inclus</span>}
                </p>
                <p class="text-[12px] text-neo-gray mb-[6px]">{pkg.description}</p>
                <ul class="flex flex-col gap-[3px]">
                  {pkg.features.map((f) => (
                    <li class="text-[12px] text-[#4a5565] flex items-start gap-[6px]">
                      <span class="text-[#1ec5e0] mt-[1px]">·</span>{f}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>

        <!-- Colonne 2 : Écrans & installation -->
        <div class="bg-white border border-gray-200 rounded-[20px] p-[26px] flex flex-col">
          <div class="flex items-center gap-[12px] mb-[16px]">
            <span class="shrink-0 w-[44px] h-[44px] rounded-full bg-[#fdbe00] text-[#2f3935] flex items-center justify-center font-bold text-[18px]">📺</span>
            <h3 class="text-[20px] font-bold text-[#101828]">Écrans & installation</h3>
          </div>
          <p class="text-[13px] text-neo-gray italic mb-[18px]">On vous aide à choisir et installer les écrans qui vont avec.</p>
          <ul class="flex flex-col gap-[14px] flex-1">
            {chainSteps[3].services.map((opt) => (
              <li class="flex items-start gap-[10px]">
                <svg class="w-4 h-4 shrink-0 text-[#fdbe00] mt-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                <div>
                  <p class="text-[14px] text-[#101828] leading-snug">{opt.label}</p>
                  {opt.hint && <p class="text-[12px] text-neo-gray mt-[1px]">{opt.hint}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Colonne 3 : Options à la carte -->
        <div class="bg-white border border-gray-200 rounded-[20px] p-[26px] flex flex-col">
          <div class="flex items-center gap-[12px] mb-[16px]">
            <span class="shrink-0 w-[44px] h-[44px] rounded-full bg-[#fe6aa6] text-white flex items-center justify-center font-bold text-[18px]">+</span>
            <h3 class="text-[20px] font-bold text-[#101828]">Options à la carte</h3>
          </div>
          <p class="text-[13px] text-neo-gray italic mb-[18px]">Pour personnaliser et aller plus loin avec votre offre.</p>
          <ul class="flex flex-col gap-[14px] flex-1">
            {additionalOptions.map((cat) => (
              <li>
                <p class="text-[11px] font-bold uppercase tracking-wider text-neo-gray mb-[6px]">{cat.title}</p>
                <ul class="flex flex-col gap-[6px]">
                  {cat.options.map((opt) => (
                    <li class="flex items-start gap-[8px]">
                      <svg class="w-4 h-4 shrink-0 text-[#fe6aa6] mt-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                      <div>
                        <p class="text-[13px] text-[#101828] leading-snug">{opt.label}</p>
                        <p class="text-[11px] text-neo-gray">{opt.availability}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>

      </div>

      <div class="text-center mt-[30px]">
        <Button href="/devis?offre=options" variant="black" arrow>Construire mon offre sur mesure</Button>
      </div>
    </div>
  </section>

  <!-- Finançable par vos partenaires -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px]">
    <div class="max-w-[1320px] mx-auto">
      <div class="bg-[rgba(129,227,188,0.4)] rounded-[20px] px-[20px] md:px-[40px] lg:px-[60px] py-[40px] md:py-[74px] flex flex-col md:flex-row items-center gap-[30px] justify-between">
        <div class="flex-1">
          <h2 class="text-[28px] md:text-[36px] lg:text-[48px] font-bold text-[#101828] mb-[20px]">
            Finançable par vos partenaires
          </h2>
          <p class="text-[18px] text-[#4a5565]">Notre solution a pour but d'être financée par vos partenaires.<br />Pour cela, nous vous avons préparé un document explicatif prêt à leur être partagé.</p>
        </div>
        <div class="shrink-0 w-full md:w-auto">
          <form class="flex flex-col sm:flex-row gap-3 w-full" data-financable-form data-pdf-url="/documents/financable-partenaires.pdf">
            <input
              type="email"
              name="email"
              placeholder="Votre email"
              required
              class="h-[48px] px-4 rounded-full border border-gray-300 text-[16px] w-full sm:w-[260px] outline-none focus:border-neo-green-dark transition-colors"
            />
            <button
              type="submit"
              class="h-[48px] px-6 bg-[#2f3935] text-white text-[16px] font-medium rounded-full hover:bg-[#101828] transition-colors whitespace-nowrap"
            >
              Recevoir le document
            </button>
            <p class="hidden text-[14px] mt-2 w-full" data-form-message></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Flotte (opérateurs / ligues / fédérations) -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[80px]">
    <div class="max-w-[1320px] mx-auto">
      <div class="relative bg-[#2f3935] text-white rounded-[20px] overflow-hidden p-[36px] md:p-[50px]">
        <div class="absolute top-0 right-0 w-[300px] h-[300px] bg-[#81e3bc] opacity-10 rounded-full -translate-y-1/3 translate-x-1/3"></div>
        <div class="relative flex flex-col lg:flex-row gap-[32px] items-start lg:items-center justify-between">
          <div class="flex-1 max-w-[640px]">
            <p class="text-[13px] tracking-[2px] text-[#81e3bc] uppercase font-bold mb-[12px]">FLOTTE · OFFRE DÉDIÉE</p>
            <h2 class="text-[26px] md:text-[34px] lg:text-[40px] font-bold mb-[14px]">
              <span class="font-playfair italic">Vous gérez</span> plusieurs clubs ?
            </h2>
            <p class="text-[15px] md:text-[16px] text-[#d9d9d9] mb-[20px]">Ligues, fédérations, opérateurs et réseaux de clubs : déploiement groupé, dashboard centralisé, tarif dégressif.</p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-[20px] gap-y-[8px] mb-[24px]">
              {[
                'Dashboard multi-sites',
                'Déploiement groupé',
                'Alertes offline',
                'Analytics inter-clubs',
                'Pricing dégressif',
                'Interlocuteur dédié',
              ].map((item) => (
                <li class="flex items-start gap-[8px] text-[14px] text-[#d9d9d9]">
                  <svg class="w-4 h-4 shrink-0 text-[#81e3bc] mt-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
