---
interface Props {
  variant?: 'black' | 'white';
  /** Taille de la police Anton en px (pilote la hauteur du logo). */
  size?: number;
  class?: string;
}

const { variant = 'black', size = 32, class: className = '' } = Astro.props;
const isWhite = variant === 'white';
---

<!-- Logo MadXP — lockup fidèle au Design System (MAD + bloc XP à coupe oblique 11 %). -->
<span
  class:list={['madxp-logo', { 'is-white': isWhite }, className]}
  style={`font-size:${size}px`}
  role="img"
  aria-label="MadXP"
>
  <span class="mad">MAD</span><span class="xp">XP</span>
</span>

<style>
  .madxp-logo {
    display: inline-flex;
    align-items: stretch;
    line-height: 0.82;
    font-family: 'Anton', 'Arial Narrow', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    white-space: nowrap;
    user-select: none;
  }
  .madxp-logo .mad {
    padding-right: 0.16em;
    display: inline-flex;
    align-items: center;
    color: #0a0b0d;
  }
  .madxp-logo .xp {
    padding: 0.04em 0.16em 0.02em 0.26em;
    display: inline-flex;
    align-items: center;
    background: #0e578e;
    color: #f2eee6;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 11% 100%);
  }
  .madxp-logo.is-white .mad { color: #f2eee6; }
  .madxp-logo.is-white .xp { background: #f2eee6; color: #0e578e; }
</style>
