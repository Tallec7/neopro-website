---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { useTranslations, localeRoutePath, localePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import {
  buildBreadcrumbJsonLd,
  buildFAQPageJsonLd,
} from '@/lib/jsonLd';

interface Props { locale: Locale; slug: string; }
const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const p = 'seo_comparatif';

const siteUrl = 'https://madxp.kalonpartners.bzh';
const pathPrefix = locale === 'fr' ? '' : `/${locale}`;
const canonicalUrl = `${siteUrl}${pathPrefix}/${slug}`;

const homeName = locale === 'fr' ? 'Accueil' : locale === 'en' ? 'Home' : locale === 'es' ? 'Inicio' : locale === 'de' ? 'Startseite' : 'Forside';
const homeUrl = locale === 'fr' ? siteUrl : `${siteUrl}/${locale}`;

const breadcrumb = buildBreadcrumbJsonLd([
  { name: homeName, url: homeUrl },
  { name: t(`${p}.hero.tag` as any), url: canonicalUrl },
]);

const faq = buildFAQPageJsonLd([
  { question: t(`${p}.faq.q1` as any), answer: t(`${p}.faq.a1` as any) },
  { question: t(`${p}.faq.q2` as any), answer: t(`${p}.faq.a2` as any) },
  { question: t(`${p}.faq.q3` as any), answer: t(`${p}.faq.a3` as any) },
  { question: t(`${p}.faq.q4` as any), answer: t(`${p}.faq.a4` as any) },
  { question: t(`${p}.faq.q5` as any), answer: t(`${p}.faq.a5` as any) },
]);

const criteres = ['type', 'scoring', 'video', 'sponsors', 'reporting', 'production', 'ecran', 'connexion', 'prix'] as const;

const criteresLabels: Record<string, string> = {
  type: t(`${p}.crit.type` as any),
  scoring: t(`${p}.crit.scoring` as any),
  video: t(`${p}.crit.video` as any),
  sponsors: t(`${p}.crit.sponsors` as any),
  reporting: t(`${p}.crit.reporting` as any),
  production: t(`${p}.crit.production` as any),
  ecran: t(`${p}.crit.ecran` as any),
  connexion: t(`${p}.crit.connexion` as any),
  prix: t(`${p}.crit.prix` as any),
};

const solutions = [
  {
    name: t(`${p}.sol1.name` as any),
    examples: t(`${p}.sol1.examples` as any),
    type: t(`${p}.sol1.type` as any),
    scoring: t(`${p}.sol1.scoring` as any),
    video: t(`${p}.sol1.video` as any),
    sponsors: t(`${p}.sol1.sponsors` as any),
    reporting: t(`${p}.sol1.reporting` as any),
    production: t(`${p}.sol1.production` as any),
    ecran: t(`${p}.sol1.ecran` as any),
    connexion: t(`${p}.sol1.connexion` as any),
    prix: t(`${p}.sol1.prix` as any),
    verdict: t(`${p}.sol1.verdict` as any),
    color: 'bg-orange-50 border-orange-200',
  },
  {
    name: t(`${p}.sol2.name` as any),
    examples: t(`${p}.sol2.examples` as any),
    type: t(`${p}.sol2.type` as any),
    scoring: t(`${p}.sol2.scoring` as any),
    video: t(`${p}.sol2.video` as any),
    sponsors: t(`${p}.sol2.sponsors` as any),
    reporting: t(`${p}.sol2.reporting` as any),
    production: t(`${p}.sol2.production` as any),
    ecran: t(`${p}.sol2.ecran` as any),
    connexion: t(`${p}.sol2.connexion` as any),
    prix: t(`${p}.sol2.prix` as any),
    verdict: t(`${p}.sol2.verdict` as any),
    color: 'bg-yellow-50 border-yellow-200',
  },
  {
    name: t(`${p}.sol3.name` as any),
    examples: t(`${p}.sol3.examples` as any),
    type: t(`${p}.sol3.type` as any),
    scoring: t(`${p}.sol3.scoring` as any),
    video: t(`${p}.sol3.video` as any),
    sponsors: t(`${p}.sol3.sponsors` as any),
    reporting: t(`${p}.sol3.reporting` as any),
    production: t(`${p}.sol3.production` as any),
    ecran: t(`${p}.sol3.ecran` as any),
    connexion: t(`${p}.sol3.connexion` as any),
    prix: t(`${p}.sol3.prix` as any),
    verdict: t(`${p}.sol3.verdict` as any),
    color: 'bg-blue-50 border-blue-200',
  },
  {
    name: t(`${p}.sol4.name` as any),
    examples: t(`${p}.sol4.examples` as any),
    type: t(`${p}.sol4.type` as any),
    scoring: t(`${p}.sol4.scoring` as any),
    video: t(`${p}.sol4.video` as any),
    sponsors: t(`${p}.sol4.sponsors` as any),
    reporting: t(`${p}.sol4.reporting` as any),
    production: t(`${p}.sol4.production` as any),
    ecran: t(`${p}.sol4.ecran` as any),
    connexion: t(`${p}.sol4.connexion` as any),
    prix: t(`${p}.sol4.prix` as any),
    verdict: t(`${p}.sol4.verdict` as any),
    color: 'bg-green-50 border-green-200',
  },
];
---

<BaseLayout
  title={t(`${p}.title` as any)}
  description={t(`${p}.description` as any)}
  canonicalUrl={canonicalUrl}
  extraJsonLd={[breadcrumb, faq]}
  locale={locale}
>
  <!-- Hero -->
  <section class="relative bg-[#0a0b0d] text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#0a0b0d] via-[#0a0b0d] to-[#1a2332]"></div>
    <div class="relative max-w-[1200px] mx-auto px-[20px] md:px-[40px] lg:px-[60px] py-[100px] md:py-[140px]">
      <p class="text-[14px] md:text-[16px] tracking-[2px] text-[#0e578e] uppercase font-bold mb-[20px]">
        {t(`${p}.hero.tag` as any)}
      </p>
      <h1 class="text-[36px] md:text-[56px] lg:text-[72px] leading-[1.05] font-black mb-[30px] max-w-[960px]" set:html={t(`${p}.hero.h1` as any)} />
      <p class="text-[18px] md:text-[22px] text-white/80 max-w-[760px] leading-relaxed mb-[40px]">
        {t(`${p}.hero.sub` as any)}
      </p>
    </div>
  </section>

  <!-- Tableau comparatif desktop -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[16px]">
          {t(`${p}.table.tag` as any)}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] leading-[1.1]" set:html={t(`${p}.table.h2` as any)} />
      </div>

      <!-- Tableau desktop -->
      <div class="hidden xl:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-[#0a0b0d]">
              <th class="py-[16px] pr-[16px] text-[15px] font-bold text-[#0a0b0d] w-[170px]">{t(`${p}.table.th` as any)}</th>
              {solutions.map((s) => (
                <th class="py-[16px] px-[12px] text-[15px] font-bold text-[#0a0b0d]">
                  {s.name}
                  <span class="block text-[12px] font-normal text-[#4a5565]">{s.examples}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {criteres.map((key) => (
              <tr class="border-b border-gray-200">
                <td class="py-[12px] pr-[16px] text-[14px] font-semibold text-[#0a0b0d]">{criteresLabels[key]}</td>
                {solutions.map((s) => (
                  <td class="py-[12px] px-[12px] text-[14px] text-[#4a5565]">{s[key]}</td>
                ))}
              </tr>
            ))}
            <tr class="border-t-2 border-[#0a0b0d]">
              <td class="py-[16px] pr-[16px] text-[14px] font-bold text-[#0a0b0d]">{t(`${p}.table.verdict` as any)}</td>
              {solutions.map((s) => (
                <td class={`py-[16px] px-[12px] text-[14px] font-medium ${s.color}`}>{s.verdict}</td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Carousel mobile/tablet -->
      <div class="xl:hidden">
        <div class="flex gap-[16px] overflow-x-auto snap-x snap-mandatory scroll-smooth pb-[16px] -mx-[20px] px-[20px] md:-mx-[40px] md:px-[40px]" style="scrollbar-width: none; -webkit-overflow-scrolling: touch;">
          {solutions.map((s) => (
            <div class={`rounded-[20px] p-[24px] border ${s.color} snap-center shrink-0 w-[85vw] max-w-[360px]`}>
              <h3 class="text-[22px] font-bold text-[#0a0b0d] mb-[2px]">{s.name}</h3>
              <p class="text-[13px] text-[#4a5565] mb-[16px]">{s.examples}</p>
              <div class="space-y-[10px]">
                {criteres.map((key) => (
                  <div>
                    <span class="text-[13px] font-semibold text-[#0a0b0d] block">{criteresLabels[key]}</span>
                    <span class="text-[14px] text-[#4a5565]">{s[key]}</span>
                  </div>
                ))}
              </div>
              <p class="mt-[16px] text-[15px] font-medium text-[#0a0b0d] border-t border-gray-300 pt-[12px]">{s.verdict}</p>
            </div>
          ))}
        </div>
        <p class="text-center text-[13px] text-[#4a5565] mt-[12px]">{t(`${p}.table.swipe` as any)}</p>
      </div>
    </div>
  </section>

  <!-- MADXP vs chaque concurrent -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[16px]">
          {t(`${p}.detail.tag` as any)}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] leading-[1.1]" set:html={t(`${p}.detail.h2` as any)} />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[24px]">
        <div class="bg-white rounded-[20px] p-[30px] border border-gray-200">
          <p class="text-[13px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[12px]">{t(`${p}.vs1.tag` as any)}</p>
          <h3 class="text-[20px] font-bold text-[#0a0b0d] mb-[14px]">{t(`${p}.vs1.title` as any)}</h3>
          <p class="text-[16px] text-[#4a5565] leading-[1.6]">{t(`${p}.vs1.desc` as any)}</p>
        </div>
        <div class="bg-white rounded-[20px] p-[30px] border border-gray-200">
          <p class="text-[13px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[12px]">{t(`${p}.vs2.tag` as any)}</p>
          <h3 class="text-[20px] font-bold text-[#0a0b0d] mb-[14px]">{t(`${p}.vs2.title` as any)}</h3>
          <p class="text-[16px] text-[#4a5565] leading-[1.6]">{t(`${p}.vs2.desc` as any)}</p>
        </div>
        <div class="bg-white rounded-[20px] p-[30px] border border-gray-200">
          <p class="text-[13px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[12px]">{t(`${p}.vs3.tag` as any)}</p>
          <h3 class="text-[20px] font-bold text-[#0a0b0d] mb-[14px]">{t(`${p}.vs3.title` as any)}</h3>
          <p class="text-[16px] text-[#4a5565] leading-[1.6]">{t(`${p}.vs3.desc` as any)}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 scénarios budget -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[16px]">
          {t(`${p}.budget.tag` as any)}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] leading-[1.1]" set:html={t(`${p}.budget.h2` as any)} />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[24px]">
        {[1, 2, 3].map((i) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] border border-gray-200">
            <p class="text-[13px] tracking-[2px] text-[#4a5565] uppercase font-bold mb-[8px]">{t(`${p}.budget${i}.label` as any)}</p>
            <h3 class="text-[20px] font-bold text-[#0a0b0d] mb-[14px]">{t(`${p}.budget${i}.title` as any)}</h3>
            <p class="text-[16px] text-[#4a5565] leading-[1.6] mb-[16px]">{t(`${p}.budget${i}.desc` as any)}</p>
            <p class="text-[14px] font-semibold text-[#0a0b0d]">{t(`${p}.budget${i}.price` as any)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chiffres ROI -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[900px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-madxp-blue-deep uppercase font-bold mb-[16px]">
          {t(`${p}.roi.tag` as any)}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] leading-[1.1]" set:html={t(`${p}.roi.h2` as any)} />
      </div>
      <div class="space-y-[24px]">
        <div class="bg-white rounded-[20px] p-[30px] border border-gray-200">
          <h3 class="text-[22px] font-bold text-[#0a0b0d] mb-[14px]">{t(`${p}.roi.problem.title` as any)}</h3>
          <p class="text-[16px] text-[#4a5565] leading-[1.6]">{t(`${p}.roi.problem.desc` as any)}</p>
        </div>
        <div class="bg-white rounded-[20px] p-[30px] border border-gray-200">
          <h3 class="text-[22px] font-bold text-[#0a0b0d] mb-[14px]">{t(`${p}.roi.solution.title` as any)}</h3>
          <p class="text-[16px] text-[#4a5565] leading-[1.6]">{t(`${p}.roi.solution.desc` as any)}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#0a0b0d] text-white">
    <div class="max-w-[900px] mx-auto text-center">
      <h2 class="text-[32px] md:text-[48px] font-bold mb-[20px]" set:html={t(`${p}.cta.h2` as any)} />
      <p class="text-[18px] text-white/70 max-w-[600px] mx-auto mb-[40px] leading-relaxed">
        {t(`${p}.cta.sub` as any)}
      </p>
      <div class="flex flex-wrap justify-center gap-[16px]">
        <Button href={localeRoutePath('/offres', locale)} variant="green" arrow>{t(`${p}.cta.cta1` as any)}</Button>
        <Button href={localeRoutePath('/devis', locale)} variant="white" arrow>{t(`${p}.cta.cta2` as any)}</Button>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[800px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] mb-[40px]" set:html={t(`${p}.faq.title` as any)} />
      <div class="space-y-[16px]">
        {[1, 2, 3, 4, 5].map((i) => (
          <details class="bg-white rounded-[16px] border border-gray-200 p-[24px] group">
            <summary class="text-[18px] font-bold text-[#0a0b0d] cursor-pointer list-none flex justify-between items-center">
              {t(`${p}.faq.q${i}` as any)}
              <span class="text-[#0e578e] text-[24px] group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-[16px] text-[16px] text-[#4a5565] leading-[1.6]">
              {t(`${p}.faq.a${i}` as any)}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Liens internes SEO -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[40px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <p class="text-[14px] text-[#4a5565] leading-[1.8]">
        {t(`${p}.links.label` as any)}
        <a href={localeRoutePath('/tableau-affichage-sportif', locale)} class="text-madxp-blue-deep underline">{t(`${p}.links.tableau` as any)}</a> &middot;
        <a href={localeRoutePath('/ecran-led-gymnase', locale)} class="text-madxp-blue-deep underline">{t(`${p}.links.ecran` as any)}</a> &middot;
        <a href={localeRoutePath('/tableau-de-score-electronique', locale)} class="text-madxp-blue-deep underline">{t(`${p}.links.score` as any)}</a> &middot;
        <a href={localeRoutePath('/scoring-digital', locale)} class="text-madxp-blue-deep underline">{t(`${p}.links.scoring` as any)}</a> &middot;
        <a href={localeRoutePath('/affichage-dynamique-salle-sport', locale)} class="text-madxp-blue-deep underline">{t(`${p}.links.affichage` as any)}</a> &middot;
        <a href={localePath('/solution', locale)} class="text-madxp-blue-deep underline">{t(`${p}.links.solution` as any)}</a> &middot;
        <a href={localeRoutePath('/offres', locale)} class="text-madxp-blue-deep underline">{t(`${p}.links.offres` as any)}</a>
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[700px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#0a0b0d] mb-[16px] text-center">
        <span class="font-display font-normal">{t(`${p}.contact.h2` as any)}</span>
      </h2>
      <p class="text-[18px] text-[#4a5565] text-center mb-[40px]">
        {t(`${p}.contact.sub` as any)}
      </p>
      <ContactForm client:visible />
    </div>
  </section>
</BaseLayout>
