---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { useTranslations, localeRoutePath, localePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import {
  buildBreadcrumbJsonLd,
  buildFAQPageJsonLd,
  buildServiceJsonLd,
} from '@/lib/jsonLd';

interface Props { locale: Locale; slug: string; }
const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const p = 'seo_tableau';

const siteUrl = 'https://www.neopro-communication.fr';
const pathPrefix = locale === 'fr' ? '' : `/${locale}`;
const canonicalUrl = `${siteUrl}${pathPrefix}/${slug}`;

const homeName = locale === 'fr' ? 'Accueil' : locale === 'en' ? 'Home' : locale === 'es' ? 'Inicio' : locale === 'de' ? 'Startseite' : locale === 'it' ? 'Home' : locale === 'pl' ? 'Strona główna' : locale === 'nl' ? 'Home' : locale === 'pt' ? 'Início' : 'Forside';
const homeUrl = locale === 'fr' ? siteUrl : `${siteUrl}/${locale}`;

const breadcrumb = buildBreadcrumbJsonLd([
  { name: homeName, url: homeUrl },
  { name: t(`${p}.hero.tag` as any), url: canonicalUrl },
]);

const service = buildServiceJsonLd({
  name: t(`${p}.title` as any),
  description: t(`${p}.description` as any),
  url: canonicalUrl,
  providerName: 'Neopro',
  providerUrl: siteUrl,
  areaServed: locale === 'fr' ? ['France', 'Belgique', 'Suisse'] :
              locale === 'en' ? ['France', 'Belgium', 'Switzerland'] :
              locale === 'es' ? ['Francia', 'Bélgica', 'Suiza'] :
              locale === 'de' ? ['Frankreich', 'Belgien', 'Schweiz'] :
              locale === 'it' ? ['Italia', 'Svizzera', 'Francia'] :
              locale === 'pl' ? ['Polska', 'Niemcy', 'Czechy'] :
              locale === 'nl' ? ['Nederland', 'België', 'Duitsland'] :
              locale === 'pt' ? ['Portugal', 'Espanha', 'França'] :
              ['Frankrig', 'Belgien', 'Schweiz'],
  serviceType: t(`${p}.hero.tag` as any),
});

const faq = buildFAQPageJsonLd([
  { question: t(`${p}.faq.q1` as any), answer: t(`${p}.faq.a1` as any) },
  { question: t(`${p}.faq.q2` as any), answer: t(`${p}.faq.a2` as any) },
  { question: t(`${p}.faq.q3` as any), answer: t(`${p}.faq.a3` as any) },
  { question: t(`${p}.faq.q4` as any), answer: t(`${p}.faq.a4` as any) },
  { question: t(`${p}.faq.q5` as any), answer: t(`${p}.faq.a5` as any) },
]);

const avantages = [
  { title: t(`${p}.adv1.title` as any), description: t(`${p}.adv1.desc` as any) },
  { title: t(`${p}.adv2.title` as any), description: t(`${p}.adv2.desc` as any) },
  { title: t(`${p}.adv3.title` as any), description: t(`${p}.adv3.desc` as any) },
  { title: t(`${p}.adv4.title` as any), description: t(`${p}.adv4.desc` as any) },
];

const comparaison = [
  { critere: t(`${p}.comp1.critere` as any), classique: t(`${p}.comp1.classique` as any), neopro: t(`${p}.comp1.neopro` as any) },
  { critere: t(`${p}.comp2.critere` as any), classique: t(`${p}.comp2.classique` as any), neopro: t(`${p}.comp2.neopro` as any) },
  { critere: t(`${p}.comp3.critere` as any), classique: t(`${p}.comp3.classique` as any), neopro: t(`${p}.comp3.neopro` as any) },
  { critere: t(`${p}.comp4.critere` as any), classique: t(`${p}.comp4.classique` as any), neopro: t(`${p}.comp4.neopro` as any) },
  { critere: t(`${p}.comp5.critere` as any), classique: t(`${p}.comp5.classique` as any), neopro: t(`${p}.comp5.neopro` as any) },
  { critere: t(`${p}.comp6.critere` as any), classique: t(`${p}.comp6.classique` as any), neopro: t(`${p}.comp6.neopro` as any) },
  { critere: t(`${p}.comp7.critere` as any), classique: t(`${p}.comp7.classique` as any), neopro: t(`${p}.comp7.neopro` as any) },
];

const features = [
  { icon: t(`${p}.feat1.icon` as any), title: t(`${p}.feat1.title` as any), description: t(`${p}.feat1.desc` as any) },
  { icon: t(`${p}.feat2.icon` as any), title: t(`${p}.feat2.title` as any), description: t(`${p}.feat2.desc` as any) },
  { icon: t(`${p}.feat3.icon` as any), title: t(`${p}.feat3.title` as any), description: t(`${p}.feat3.desc` as any) },
  { icon: t(`${p}.feat4.icon` as any), title: t(`${p}.feat4.title` as any), description: t(`${p}.feat4.desc` as any) },
  { icon: t(`${p}.feat5.icon` as any), title: t(`${p}.feat5.title` as any), description: t(`${p}.feat5.desc` as any) },
  { icon: t(`${p}.feat6.icon` as any), title: t(`${p}.feat6.title` as any), description: t(`${p}.feat6.desc` as any) },
];
---

<BaseLayout
  title={t(`${p}.title` as any)}
  description={t(`${p}.description` as any)}
  canonicalUrl={canonicalUrl}
  extraJsonLd={[breadcrumb, service, faq]}
  locale={locale}
>
  <!-- Hero -->
  <section class="relative bg-[#101828] text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#101828] via-[#101828] to-[#1a2332]"></div>
    <div class="relative max-w-[1200px] mx-auto px-[20px] md:px-[40px] lg:px-[60px] py-[100px] md:py-[140px]">
      <p class="text-[14px] md:text-[16px] tracking-[2px] text-[#81e3bc] uppercase font-bold mb-[20px]">
        {t(`${p}.hero.tag` as any)}
      </p>
      <h1 class="text-[36px] md:text-[56px] lg:text-[72px] leading-[1.05] font-black mb-[30px] max-w-[960px]" set:html={t(`${p}.hero.h1` as any)} />
      <p class="text-[18px] md:text-[22px] text-white/80 max-w-[760px] leading-relaxed mb-[40px]">
        {t(`${p}.hero.sub` as any)}
      </p>
      <div class="flex flex-wrap gap-[16px]">
        <Button href={localeRoutePath('/devis', locale)} variant="green" arrow>{t(`${p}.hero.cta1` as any)}</Button>
        <Button href={localePath('/solution', locale)} variant="white" arrow>{t(`${p}.hero.cta2` as any)}</Button>
      </div>
    </div>
  </section>

  <!-- Pourquoi passer au digital -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
          {t(`${p}.why.tag` as any)}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] leading-[1.1]" set:html={t(`${p}.why.h2` as any)} />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[24px]">
        {avantages.map((item) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] border border-gray-200">
            <h3 class="text-[22px] font-bold text-[#101828] mb-[14px]">{item.title}</h3>
            <p class="text-[16px] text-[#4a5565] leading-[1.6]">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparatif -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[1000px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
          {t(`${p}.comp.tag` as any)}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] leading-[1.1]" set:html={t(`${p}.comp.h2` as any)} />
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-[#101828]">
              <th class="py-[16px] pr-[20px] text-[16px] font-bold text-[#101828]">{t(`${p}.comp.th1` as any)}</th>
              <th class="py-[16px] pr-[20px] text-[16px] font-bold text-[#101828]">{t(`${p}.comp.th2` as any)}</th>
              <th class="py-[16px] text-[16px] font-bold text-[#81e3bc]">Neopro</th>
            </tr>
          </thead>
          <tbody>
            {comparaison.map((row) => (
              <tr class="border-b border-gray-200">
                <td class="py-[14px] pr-[20px] text-[15px] font-semibold text-[#101828]">{row.critere}</td>
                <td class="py-[14px] pr-[20px] text-[15px] text-[#4a5565]">{row.classique}</td>
                <td class="py-[14px] text-[15px] text-[#101828] font-medium">{row.neopro}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Fonctionnalités -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
          {t(`${p}.feat.tag` as any)}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] leading-[1.1]" set:html={t(`${p}.feat.h2` as any)} />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]">
        {features.map((feat) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] border border-gray-200 hover:border-neo-green-dark transition-colors">
            <span class="text-[32px] mb-[16px] block">{feat.icon}</span>
            <h3 class="text-[22px] font-bold text-[#101828] mb-[14px]">{feat.title}</h3>
            <p class="text-[16px] text-[#4a5565] leading-[1.6]">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sports compatibles -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#101828] text-white">
    <div class="max-w-[900px] mx-auto text-center">
      <h2 class="text-[32px] md:text-[48px] font-bold mb-[20px]" set:html={t(`${p}.sports.h2` as any)} />
      <p class="text-[18px] text-white/70 max-w-[600px] mx-auto mb-[40px] leading-relaxed">
        {t(`${p}.sports.sub` as any)}
      </p>
      <div class="flex flex-wrap justify-center gap-[12px] mb-[40px]">
        <a href={localeRoutePath('/basketball', locale)} class="bg-white/10 hover:bg-white/20 rounded-full px-[20px] py-[10px] text-[15px] transition-colors">Basketball</a>
        <a href={localeRoutePath('/handball', locale)} class="bg-white/10 hover:bg-white/20 rounded-full px-[20px] py-[10px] text-[15px] transition-colors">Handball</a>
        <a href={localeRoutePath('/volleyball', locale)} class="bg-white/10 hover:bg-white/20 rounded-full px-[20px] py-[10px] text-[15px] transition-colors">Volleyball</a>
        <a href={localeRoutePath('/futsal', locale)} class="bg-white/10 hover:bg-white/20 rounded-full px-[20px] py-[10px] text-[15px] transition-colors">Futsal</a>
      </div>
      <div class="flex flex-wrap justify-center gap-[16px]">
        <Button href={localeRoutePath('/offres', locale)} variant="green" arrow>{t(`${p}.sports.cta1` as any)}</Button>
        <Button href={localeRoutePath('/devis', locale)} variant="white" arrow>{t(`${p}.sports.cta2` as any)}</Button>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[800px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[40px]" set:html={t(`${p}.faq.title` as any)} />
      <div class="space-y-[16px]">
        {[1, 2, 3, 4, 5].map((i) => (
          <details class="bg-white rounded-[16px] border border-gray-200 p-[24px] group">
            <summary class="text-[18px] font-bold text-[#101828] cursor-pointer list-none flex justify-between items-center">
              {t(`${p}.faq.q${i}` as any)}
              <span class="text-[#81e3bc] text-[24px] group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-[16px] text-[16px] text-[#4a5565] leading-[1.6]">
              {t(`${p}.faq.a${i}` as any)}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Liens internes SEO -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[40px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <p class="text-[14px] text-[#4a5565] leading-[1.8]">
        {t(`${p}.links.label` as any)}
        <a href={localeRoutePath('/ecran-led-gymnase', locale)} class="text-neo-green-dark underline">{t(`${p}.links.ecran` as any)}</a> &middot;
        <a href={localeRoutePath('/tableau-de-score-electronique', locale)} class="text-neo-green-dark underline">{t(`${p}.links.score` as any)}</a> &middot;
        <a href={localePath('/solution', locale)} class="text-neo-green-dark underline">{t(`${p}.links.solution` as any)}</a> &middot;
        <a href={localeRoutePath('/offres', locale)} class="text-neo-green-dark underline">{t(`${p}.links.offres` as any)}</a> &middot;
        <a href={localeRoutePath('/basketball', locale)} class="text-neo-green-dark underline">Basketball</a> &middot;
        <a href={localeRoutePath('/handball', locale)} class="text-neo-green-dark underline">Handball</a> &middot;
        <a href={localeRoutePath('/volleyball', locale)} class="text-neo-green-dark underline">Volleyball</a>
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[700px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[16px] text-center">
        <span class="font-playfair italic font-normal">{t(`${p}.contact.h2` as any)}</span>
      </h2>
      <p class="text-[18px] text-[#4a5565] text-center mb-[40px]">
        {t(`${p}.contact.sub` as any)}
      </p>
      <ContactForm client:visible />
    </div>
  </section>
</BaseLayout>
