---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { useTranslations, localeRoutePath, localePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import {
  buildBreadcrumbJsonLd,
  buildFAQPageJsonLd,
  buildServiceJsonLd,
} from '@/lib/jsonLd';

interface Props {
  sport: string;
  locale: Locale;
  slug: string; // URL slug for this locale (e.g. 'basketball', 'baloncesto')
}

const { sport, locale, slug } = Astro.props;
const t = useTranslations(locale);

const siteUrl = 'https://www.neopro-communication.fr';
const pathPrefix = locale === 'fr' ? '' : `/${locale}`;
const canonicalUrl = `${siteUrl}${pathPrefix}/${slug}`;

const homeName = locale === 'fr' ? 'Accueil' : locale === 'en' ? 'Home' : locale === 'es' ? 'Inicio' : locale === 'de' ? 'Startseite' : locale === 'it' ? 'Home' : locale === 'pl' ? 'Strona główna' : locale === 'nl' ? 'Home' : locale === 'pt' ? 'Início' : 'Forside';
const homeUrl = locale === 'fr' ? siteUrl : `${siteUrl}/${locale}`;

const breadcrumb = buildBreadcrumbJsonLd([
  { name: homeName, url: homeUrl },
  { name: t(`${sport}.hero.tag` as any), url: canonicalUrl },
]);

const service = buildServiceJsonLd({
  name: t(`${sport}.title` as any),
  description: t(`${sport}.description` as any),
  url: canonicalUrl,
  providerName: 'Neopro',
  providerUrl: siteUrl,
  areaServed: locale === 'fr' ? ['France', 'Belgique', 'Suisse'] :
              locale === 'en' ? ['France', 'Belgium', 'Switzerland'] :
              locale === 'es' ? ['Francia', 'B\u00e9lgica', 'Suiza'] :
              locale === 'de' ? ['Frankreich', 'Belgien', 'Schweiz'] :
              locale === 'it' ? ['Italia', 'Svizzera', 'Francia'] :
              locale === 'pl' ? ['Polska', 'Niemcy', 'Francja'] :
              locale === 'nl' ? ['Nederland', 'België', 'Frankrijk'] :
              locale === 'pt' ? ['Portugal', 'Espanha', 'França'] :
              ['Frankrig', 'Belgien', 'Schweiz'],
  serviceType: t(`${sport}.hero.tag` as any),
});

const faq = buildFAQPageJsonLd([
  { question: t(`${sport}.faq.q1` as any), answer: t(`${sport}.faq.a1` as any) },
  { question: t(`${sport}.faq.q2` as any), answer: t(`${sport}.faq.a2` as any) },
  { question: t(`${sport}.faq.q3` as any), answer: t(`${sport}.faq.a3` as any) },
  { question: t(`${sport}.faq.q4` as any), answer: t(`${sport}.faq.a4` as any) },
]);

const features = [
  { icon: t(`${sport}.feat1.icon` as any), title: t(`${sport}.feat1.title` as any), description: t(`${sport}.feat1.desc` as any) },
  { icon: t(`${sport}.feat2.icon` as any), title: t(`${sport}.feat2.title` as any), description: t(`${sport}.feat2.desc` as any) },
  { icon: t(`${sport}.feat3.icon` as any), title: t(`${sport}.feat3.title` as any), description: t(`${sport}.feat3.desc` as any) },
  { icon: t(`${sport}.feat4.icon` as any), title: t(`${sport}.feat4.title` as any), description: t(`${sport}.feat4.desc` as any) },
  { icon: t(`${sport}.feat5.icon` as any), title: t(`${sport}.feat5.title` as any), description: t(`${sport}.feat5.desc` as any) },
  { icon: t(`${sport}.feat6.icon` as any), title: t(`${sport}.feat6.title` as any), description: t(`${sport}.feat6.desc` as any) },
];

const avantages = [
  { title: t(`${sport}.adv1.title` as any), description: t(`${sport}.adv1.desc` as any) },
  { title: t(`${sport}.adv2.title` as any), description: t(`${sport}.adv2.desc` as any) },
  { title: t(`${sport}.adv3.title` as any), description: t(`${sport}.adv3.desc` as any) },
  { title: t(`${sport}.adv4.title` as any), description: t(`${sport}.adv4.desc` as any) },
];

const demoLabel = t(`${sport}.hero.cta1` as any);
const solutionLabel = t(`${sport}.hero.cta2` as any);
const offresLabel = t(`${sport}.cta.btn1` as any);
const demoCta2Label = t(`${sport}.cta.btn2` as any);
---

<BaseLayout
  title={t(`${sport}.title` as any)}
  description={t(`${sport}.description` as any)}
  canonicalUrl={canonicalUrl}
  extraJsonLd={[breadcrumb, service, faq]}
  locale={locale}
>
  <!-- Hero -->
  <section class="relative bg-[#101828] text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#101828] via-[#101828] to-[#1a2332]"></div>
    <div class="relative max-w-[1200px] mx-auto px-[20px] md:px-[40px] lg:px-[60px] py-[100px] md:py-[140px]">
      <p class="text-[14px] md:text-[16px] tracking-[2px] text-[#81e3bc] uppercase font-bold mb-[20px]">
        {t(`${sport}.hero.tag` as any)}
      </p>
      <h1 class="text-[36px] md:text-[56px] lg:text-[72px] leading-[1.05] font-black mb-[30px] max-w-[960px]">
        <span class="font-playfair italic font-normal">{t(`${sport}.hero.h1a` as any)}</span>{t(`${sport}.hero.h1b` as any)}<br />
        {t(`${sport}.hero.h1c` as any)}<span class="text-[#81e3bc]">{t(`${sport}.hero.h1d` as any)}</span>{t(`${sport}.hero.h1e` as any)}
      </h1>
      <p class="text-[18px] md:text-[22px] text-white/80 max-w-[760px] leading-relaxed mb-[40px]">
        {t(`${sport}.hero.sub` as any)}
      </p>
      <div class="flex flex-wrap gap-[16px]">
        <Button href={localeRoutePath('/devis', locale)} variant="green" arrow>{demoLabel}</Button>
        <Button href={localePath('/solution', locale)} variant="white" arrow>{solutionLabel}</Button>
      </div>
    </div>
  </section>

  <!-- Pourquoi ce sport est ideal -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
          {t(`${sport}.why.tag` as any)}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] leading-[1.1]" set:html={t(`${sport}.why.h2` as any)} />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[24px]">
        {avantages.map((item) => (
          <div class="bg-[#f5f5f5] rounded-[20px] p-[30px] border border-gray-200">
            <h3 class="text-[22px] font-bold text-[#101828] mb-[14px]">{item.title}</h3>
            <p class="text-[16px] text-[#4a5565] leading-[1.6]">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ce que Neopro apporte -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[1200px] mx-auto">
      <div class="max-w-[760px] mb-[60px]">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
          {t(`${sport}.feat.tag` as any)}
        </p>
        <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] leading-[1.1]" set:html={t(`${sport}.feat.h2` as any)} />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]">
        {features.map((feat) => (
          <div class="bg-white rounded-[20px] p-[30px] border border-gray-200 hover:border-neo-green-dark transition-colors">
            <span class="text-[32px] mb-[16px] block">{feat.icon}</span>
            <h3 class="text-[22px] font-bold text-[#101828] mb-[14px]">{feat.title}</h3>
            <p class="text-[16px] text-[#4a5565] leading-[1.6]">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cas concret -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">
        {t(`${sport}.case.tag` as any)}
      </p>
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[40px]" set:html={t(`${sport}.case.h2` as any)} />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[40px]">
        <div class="bg-[#fef2f2] rounded-[20px] p-[30px]">
          <h3 class="text-[20px] font-bold text-[#101828] mb-[20px]">{t(`${sport}.case.before.title` as any)}</h3>
          <ul class="space-y-[12px] text-[16px] text-[#4a5565] leading-[1.6]">
            <li>{t(`${sport}.before1` as any)}</li>
            <li>{t(`${sport}.before2` as any)}</li>
            <li>{t(`${sport}.before3` as any)}</li>
            <li>{t(`${sport}.before4` as any)}</li>
            <li>{t(`${sport}.before5` as any)}</li>
          </ul>
        </div>
        <div class="bg-[#f0fdf4] rounded-[20px] p-[30px]">
          <h3 class="text-[20px] font-bold text-[#101828] mb-[20px]">{t(`${sport}.case.after.title` as any)}</h3>
          <ul class="space-y-[12px] text-[16px] text-[#4a5565] leading-[1.6]">
            <li>{t(`${sport}.after1` as any)}</li>
            <li>{t(`${sport}.after2` as any)}</li>
            <li>{t(`${sport}.after3` as any)}</li>
            <li>{t(`${sport}.after4` as any)}</li>
            <li>{t(`${sport}.after5` as any)}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Les offres -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#101828] text-white">
    <div class="max-w-[900px] mx-auto text-center">
      <h2 class="text-[32px] md:text-[48px] font-bold mb-[20px]" set:html={t(`${sport}.cta.h2` as any)} />
      <p class="text-[18px] text-white/70 max-w-[600px] mx-auto mb-[40px] leading-relaxed">
        {t(`${sport}.cta.sub` as any)}
      </p>
      <div class="flex flex-wrap justify-center gap-[16px]">
        <Button href={localeRoutePath('/offres', locale)} variant="green" arrow>{offresLabel}</Button>
        <Button href={localeRoutePath('/devis', locale)} variant="white" arrow>{demoCta2Label}</Button>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[800px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[40px]" set:html={t(`${sport}.faq.title` as any)} />
      <div class="space-y-[16px]">
        {[1, 2, 3, 4].map((i) => (
          <details class="bg-white rounded-[16px] border border-gray-200 p-[24px] group">
            <summary class="text-[18px] font-bold text-[#101828] cursor-pointer list-none flex justify-between items-center">
              {t(`${sport}.faq.q${i}` as any)}
              <span class="text-[#81e3bc] text-[24px] group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-[16px] text-[16px] text-[#4a5565] leading-[1.6]">
              {t(`${sport}.faq.a${i}` as any)}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Villes les plus actives (FR uniquement) -->
  {locale === 'fr' && (
    <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[80px] bg-white">
      <div class="max-w-[1200px] mx-auto">
        <p class="text-[14px] tracking-[2px] text-neo-green-dark uppercase font-bold mb-[16px]">IMPLANTATIONS</p>
        <h2 class="text-[26px] md:text-[34px] font-bold text-[#101828] mb-[8px]">
          Villes les plus actives en {t(`${sport}.hero.tag` as any).replace(/régie sport\s*/i, '').trim() || sport}
        </h2>
        <p class="text-[16px] text-neo-gray mb-[32px]">Neopro accompagne des clubs dans toute la France — découvrez notre présence ville par ville.</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-[12px] mb-[24px]">
          {['paris', 'lyon', 'marseille', 'toulouse', 'bordeaux', 'lille', 'nantes', 'nice', 'montpellier', 'strasbourg', 'rennes', 'grenoble'].map((citySlug) => (
            <a
              href={`/implantations/${citySlug}/${slug}`}
              class="block text-center px-3 py-3 bg-[#f5f5f5] rounded-[12px] text-[14px] font-semibold text-[#101828] hover:bg-neo-green hover:text-neo-dark capitalize transition-colors"
            >
              {citySlug.charAt(0).toUpperCase() + citySlug.slice(1)}
            </a>
          ))}
        </div>
        <a href="/implantations" class="text-[14px] text-neo-green-dark font-semibold hover:underline">
          → Voir toutes les villes
        </a>
      </div>
    </section>
  )}

  <!-- Liens internes SEO -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[40px] bg-white">
    <div class="max-w-[900px] mx-auto">
      <p class="text-[14px] text-[#4a5565] leading-[1.8]">
        {t(`${sport}.links.label` as any)}
        <a href={localePath('/solution', locale)} class="text-neo-green-dark underline">{t(`${sport}.links.solution` as any)}</a> &middot;
        <a href={localeRoutePath('/offres', locale)} class="text-neo-green-dark underline">{t(`${sport}.links.offres` as any)}</a> &middot;
        <a href={localeRoutePath('/annonceurs', locale)} class="text-neo-green-dark underline">{t(`${sport}.links.annonceurs` as any)}</a> &middot;
        <a href={localeRoutePath('/regie-sport', locale)} class="text-neo-green-dark underline">{t(`${sport}.links.regie` as any)}</a> &middot;
        <a href={localePath('/implantations', locale)} class="text-neo-green-dark underline">{t(`${sport}.links.implantations` as any)}</a>
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section class="px-[20px] md:px-[40px] lg:px-[60px] py-[60px] md:py-[96px] bg-[#f5f5f5]">
    <div class="max-w-[700px] mx-auto">
      <h2 class="text-[32px] md:text-[48px] font-bold text-[#101828] mb-[16px] text-center">
        <span class="font-playfair italic font-normal">{t(`${sport}.contact.h2` as any)}</span>
      </h2>
      <p class="text-[18px] text-[#4a5565] text-center mb-[40px]">
        {t(`${sport}.contact.sub` as any)}
      </p>
      <ContactForm client:visible />
    </div>
  </section>
</BaseLayout>
