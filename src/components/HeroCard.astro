---
import Logo from '@/components/icons/Logo.astro';

interface Props {
  label: string;
  title: string;
  sub?: string;
  class?: string;
}
const { label, title, sub, class: className = '' } = Astro.props;
---

<!-- Carte de marque pour les héros (sans photo) — panneau os, logo, motif écran. -->
<div class:list={['relative overflow-hidden rounded-[24px] bg-madxp-bone text-madxp-ink shadow-2xl p-7 md:p-9', className]}>
  <div class="pointer-events-none absolute -right-12 -top-12 w-52 h-52 bg-madxp-blue/10 [clip-path:polygon(42%_0,100%_0,100%_100%,0_100%)]"></div>

  <div class="relative flex items-center justify-between mb-7">
    <Logo size={24} />
    <span class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] uppercase text-madxp-gray">
      <span class="w-1.5 h-1.5 rounded-full bg-madxp-red animate-pulse"></span> Live
    </span>
  </div>

  <p class="relative font-mono text-[12px] tracking-[0.2em] uppercase text-madxp-blue mb-3">{label}</p>
  <p class="relative font-display uppercase text-[28px] md:text-[38px] leading-[0.95]">{title}</p>
  {sub && <p class="relative text-madxp-gray text-[15px] leading-snug mt-4">{sub}</p>}

  <div class="relative mt-8 flex items-center gap-2">
    <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-madxp-gray shrink-0">Sponsors</span>
    <span class="flex-1 h-6 rounded bg-madxp-ink/10"></span>
    <span class="flex-1 h-6 rounded bg-madxp-ink/10"></span>
    <span class="flex-1 h-6 rounded bg-madxp-ink/10 hidden sm:block"></span>
  </div>
</div>
