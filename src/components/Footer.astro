---
import Logo from '@/components/icons/Logo.astro';
import SocialIcons from '@/components/icons/SocialIcons.astro';
import Button from '@/components/Button.astro';
import { useTranslations, localePath, localeRoutePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props { locale?: Locale; }
const locale = Astro.props.locale ?? 'fr';
const t = useTranslations(locale);

const year = new Date().getFullYear();

const colProduit = [
  { label: t('nav.solution'), href: localePath('/solution', locale) },
  { label: t('nav.regie'), href: localeRoutePath('/regie-sport', locale) },
  { label: t('nav.offres'), href: localeRoutePath('/offres', locale) },
  { label: t('nav.annonceurs'), href: localeRoutePath('/annonceurs', locale) },
  { label: t('footer.implantations'), href: localePath('/implantations', locale) },
];

const colRessources = [
  { label: t('nav.blog'), href: localePath('/blog', locale) },
  { label: t('nav.about'), href: localeRoutePath('/qui-sommes-nous', locale) },
  { label: t('nav.club'), href: 'https://neopro-admin.kalonpartners.bzh', external: true },
];

const colLegal = [
  { label: t('footer.mentions'), href: localePath('/mentions-legales', locale) },
  { label: t('footer.privacy'), href: localePath('/politique-de-confidentialite', locale) },
];
---

<footer class="bg-neo-dark-bg text-white">
  <div class="max-w-[1200px] mx-auto px-6 md:px-[120px] pt-[60px] md:pt-[80px] pb-[60px] md:pb-[96px]">
    <!-- Row 1: Logo + Social icons -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
      <a href={localePath('/', locale)}>
        <Logo variant="white" class="h-[34px] w-auto" />
      </a>
      <div class="flex gap-[10px]">
        <a href="https://www.instagram.com/neopro_fr/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-neo-green hover:text-neo-green-dark transition-colors">
          <SocialIcons platform="instagram" size={25} />
        </a>
        <a href="https://www.linkedin.com/company/neopro-communication/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-neo-green hover:text-neo-green-dark transition-colors">
          <SocialIcons platform="linkedin" size={22} />
        </a>
      </div>
    </div>

    <!-- Divider — green line -->
    <div class="h-[2px] bg-neo-green my-8" />

    <!-- Row 2: Nav columns + CTAs -->
    <div class="flex flex-col md:flex-row justify-between items-start gap-8">
      <!-- Nav links in columns -->
      <div class="flex flex-wrap gap-x-12 gap-y-6">
        <!-- Col Produit -->
        <div>
          <h4 class="text-[13px] font-semibold uppercase tracking-wider text-neo-green mb-3">
            {t('footer.col.produit')}
          </h4>
          <ul class="flex flex-col gap-2 text-[15px]">
            {colProduit.map((link) => (
              <li>
                <a href={link.href} class="text-white hover:text-neo-green transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <!-- Col Ressources -->
        <div>
          <h4 class="text-[13px] font-semibold uppercase tracking-wider text-neo-green mb-3">
            {t('footer.col.ressources')}
          </h4>
          <ul class="flex flex-col gap-2 text-[15px]">
            {colRessources.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-white hover:text-neo-green transition-colors"
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-[16px] items-start">
        <Button href={localeRoutePath('/devis', locale)} variant="green">
          {t('nav.demo')}
        </Button>
        <Button href="#contact" variant="black">
          {t('footer.contact')}
        </Button>
      </div>
    </div>

    <!-- Row 3: Legal links + Copyright -->
    <div class="h-[1px] bg-[rgba(255,255,255,0.15)] mt-8 mb-6" />
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div class="flex flex-wrap gap-[20px] text-[13px] text-[rgba(255,255,255,0.5)]">
        {colLegal.map((link) => (
          <a href={link.href} class="hover:text-white transition-colors">
            {link.label}
          </a>
        ))}
      </div>
      <p class="text-[13px] text-[rgba(255,255,255,0.4)]">
        &copy; {year} {t('footer.copyright')}
      </p>
    </div>
  </div>
</footer>
