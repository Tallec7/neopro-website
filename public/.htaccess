# ──────────────────────────────────────────────────────────────
# Site fermé — toute URL hors racine est redirigée vers /
# ──────────────────────────────────────────────────────────────

RewriteEngine On

# Laisser passer les assets nécessaires à l'affichage de la page de fermeture
RewriteCond %{REQUEST_URI} ^/(favicon\.ico|favicon\.svg|favicon-32x32\.png|apple-touch-icon\.png|site\.webmanifest|robots\.txt|og-default\.jpg)$ [OR]
RewriteCond %{REQUEST_URI} ^/(_astro|images|videos|documents)/ [OR]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^ - [L]

# Tout le reste → racine (301)
RewriteRule ^.*$ / [R=301,L]
