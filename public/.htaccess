# ── B. /{locale}/demo/ → page devis localisée ──────────────────
Redirect 301 /en/demo/ /en/quote/
Redirect 301 /de/demo/ /de/angebot/
Redirect 301 /da/demo/ /da/tilbud/

# ── C. /{locale}/offres/ → page prix localisée ─────────────────
